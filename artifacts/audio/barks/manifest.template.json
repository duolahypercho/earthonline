{
  "$schema": "earthonline-audio-manifest-v1",
  "version": "earthonline-bark-manifest-v1",
  "note": "Template. Copy to manifest.json and fill one variant entry per shipped file. The runtime loader reads categories -> variants. Every file listed here must have a matching block in ../PROVENANCE.md. Wildcard entries are for illustration only; the shipped manifest lists real files.",
  "format": {
    "container": "ogg",
    "codec": "opus",
    "sampleRate": 48000,
    "channels": 1,
    "truePeakMaxDb": -1.0
  },
  "basePath": "artifacts/audio/barks/",
  "sets": {
    "a": { "register": "low",  "assign": ["presentation:masculine", "neutral+body:strong", "neutral+body:heavy"] },
    "b": { "register": "mid",  "assign": ["presentation:neutral"], "fallback": true },
    "c": { "register": "high", "assign": ["presentation:feminine", "neutral+body:slim", "neutral+body:short"] }
  },
  "identityPitch": {
    "rangeSemitoneFree": true,
    "minOffset": -0.08,
    "maxOffset": 0.08,
    "clamp": 0.10,
    "seedSalt": "voice:pitch"
  },
  "scheduler": {
    "perAgentCooldownSec": 1.2,
    "perAgentSameCategoryCooldownSec": 4.0,
    "globalMaxBarks": 3,
    "globalWindowSec": 0.5,
    "maxBarkVoices": 8,
    "maxImpactVoices": 6,
    "cullDistanceM": 28,
    "bystanderFanOutMax": 4,
    "bystanderFanOutWindowSec": 2.0,
    "priority": ["scream", "hurt-heavy", "hurt-light", "angry", "flee", "gasp", "bump"]
  },
  "panner": {
    "panningModel": "HRTF",
    "distanceModel": "inverse",
    "refDistance": 2.0,
    "maxDistance": 30,
    "rolloffFactor": 1.3
  },
  "categories": {
    "bump": {
      "targetLufs": -23,
      "gain": 0.85,
      "variants": [
        { "file": "a-bump-01.ogg", "set": "a", "pitchOffset": 0, "gain": 1.0, "durationSec": 0.0 },
        { "file": "b-bump-01.ogg", "set": "b", "pitchOffset": 0, "gain": 1.0, "durationSec": 0.0 },
        { "file": "c-bump-01.ogg", "set": "c", "pitchOffset": 0, "gain": 1.0, "durationSec": 0.0 }
      ]
    },
    "hurt-light": { "targetLufs": -20, "gain": 1.0, "variants": [] },
    "hurt-heavy": { "targetLufs": -18, "gain": 1.0, "variants": [] },
    "scream":     { "targetLufs": -16, "gain": 1.0, "duckAmbienceDb": -4, "duckSec": 0.6, "variants": [] },
    "angry":      { "targetLufs": -20, "gain": 1.0, "variants": [] },
    "flee":       { "targetLufs": -20, "gain": 1.0, "variants": [] },
    "gasp":       { "targetLufs": -23, "gain": 0.9, "variants": [] },
    "shout":      { "targetLufs": -20, "gain": 1.0, "variants": [] },
    "honk": {
      "targetLufs": -16,
      "gain": 1.0,
      "basePath": "artifacts/audio/impacts/",
      "panner": { "refDistance": 4.0, "maxDistance": 60, "rolloffFactor": 1.0 },
      "variants": [
        { "file": "sedan-honk-01.ogg", "set": "sedan", "pitchOffset": 0, "gain": 1.0, "durationSec": 0.0 }
      ]
    }
  }
}
