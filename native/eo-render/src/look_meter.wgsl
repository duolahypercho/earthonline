// The scene meter (eo-sky `night::scene_meter`, `--no-scene-meter`): the HDR
// frame's luminance at a quarter of its resolution, binned by stops about the
// incident meter's grey into a weighted histogram (1/8 stop bins), each
// sample weighted by a centre-weighted averaging pattern. MT_* constants are
// generated by look.rs from eo-sky's.
struct MeterU {
    // x: the prior grey's luminance (look units); y: 1 the whole frame averaged
    // (an averaging reflected meter, eo-sky `night::meter_averaging`), 0 the
    // centre-weighted pattern below (scene_meter.rs writes 0 until its hand-off
    // lands); z, w unused
    grey: vec4<f32>,
}

@group(0) @binding(0) var mt_src: texture_2d<f32>;
@group(0) @binding(1) var<uniform> mt: MeterU;
@group(0) @binding(2) var<storage, read_write> mt_hist: array<atomic<u32>, MT_BINS>;

var<workgroup> mt_local: array<atomic<u32>, MT_BINS>;

// a centre-weighted averaging pattern: 1 at the edges, 4 at the centre,
// falling with a Gaussian of 0.25 frame heights (r in frame heights from the
// centre); on a 16:9 frame 40 % of the weight falls on the central quarter of its area.
fn mt_weight(p: vec2<f32>, dims: vec2<f32>) -> f32 {
    let d = (p - 0.5 * dims) / dims.y;
    let r2 = dot(d, d);
    return 1.0 + 3.0 * exp(-r2 / (0.25 * 0.25)) * (1.0 - clamp(mt.grey.y, 0.0, 1.0));
}

@compute @workgroup_size(16, 16)
fn meter_main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) li: u32) {
    for (var i = li; i < MT_BINS; i = i + 256u) {
        atomicStore(&mt_local[i], 0u);
    }
    workgroupBarrier();
    let dims = textureDimensions(mt_src);
    let p = gid.xy * 4u + vec2<u32>(2u);
    if (p.x < dims.x && p.y < dims.y) {
        let c = max(textureLoad(mt_src, vec2<i32>(p), 0).rgb, vec3<f32>(0.0));
        let y = dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));
        let ev = log2(max(y, 1e-12) / mt.grey.x);
        let b = u32(clamp(floor((ev - MT_LO_EV) * MT_BINS_PER_EV), 0.0, f32(MT_BINS - 1u)));
        let w = u32(round(16.0 * mt_weight(vec2<f32>(p), vec2<f32>(dims))));
        atomicAdd(&mt_local[b], w);
    }
    workgroupBarrier();
    for (var i = li; i < MT_BINS; i = i + 256u) {
        let v = atomicLoad(&mt_local[i]);
        if (v > 0u) {
            atomicAdd(&mt_hist[i], v);
        }
    }
}
