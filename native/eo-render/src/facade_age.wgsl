// building weathering and archetype ageing (appended to draw.wgsl by
// look.rs `city_shader_source`; constants AW_/AF_/AS_/AL_/FD_ generated by
// facade.rs from the JS tables).
//
//  * fa_weather: kit/materials.js `weatheringGraph` (soot, grime, overpaint
//    ghosts, mottle, base soiling, storey run-off bands) -> a colour
//    multiplier and a roughness offset.
//  * Blender buildings: the graph with the building's literal scalars
//    (blender/runtime.js weathering object), on every non-glass kit finish.
//  * Kit buildings: kit/ageing-nodes.js `applyArchetypeAgeing`: the graph
//    driven by the packed appearance, then paint fade, rust, facade-detail-v1
//    relief and cavity, splash-back and salt bloom, per the finish's class.
//    The contact terms (reveals, sill drips, chips) are not drawn: they read
//    per-face facts from a uv this kit mesh does not carry.
//
// Positions and normals are in the AUTHORING frame (authoring-space.js): the
// world itself for kit buildings, z mirrored for Blender buildings (drawn under
// the authoring mirror).

@group(0) @binding(10) var<storage, read> fa_ages: array<vec4<f32>>;
@group(0) @binding(11) var<storage, read> fa_weather_recs: array<vec4<f32>>;
@group(0) @binding(12) var fa_detail: texture_2d<f32>;
@group(0) @binding(13) var fa_detail_sampler: sampler;
// The scene probe (probe.rs): 6 faces of a 2D array, levels 0..FA_PROBE_MAXLOD.
@group(0) @binding(14) var fa_probe_tex: texture_2d_array<f32>;
@group(0) @binding(15) var fa_probe_samp: sampler;
// [0] lobe sums, [1..10) the front capture's irradiance SH9 (cosine-convolved).
@group(0) @binding(16) var<storage, read> fa_probe_sh: array<vec4<f32>, 10>;

const FA_RUN_AGE: u32 = 1u;
const FA_RUN_DETAIL: u32 = 2u;
const FA_RUN_ATLAS2: u32 = 4u;
const FA_AGE_RENDER: u32 = 1u;
const FA_AGE_PAINTED: u32 = 2u;
const FA_AGE_MASONRY: u32 = 3u;
const FA_AGE_METAL: u32 = 4u;
const FA_AGE_ROOF: u32 = 5u;
const FA_KIT_WEATHER: u32 = 65536u;
const FA_ATLAS: u32 = 131072u;
// WEATHER_AXIS: 27 degrees off world x (kit/materials.js).
const FA_AXIS_COS: f32 = 0.89100652;
const FA_AXIS_SIN: f32 = 0.45399050;
const FA_RUST: vec3<f32> = vec3<f32>(0.2, 0.072, 0.03);

fn fa_run() -> u32 {
    return u32(frame.copy_step.y);
}

// The facades track's features: compiled in (`SF_*`, look.rs ShaderFeatures)
// and switched on (facade.rs `RUN_FACADE_GLASS`, `RUN_FAR_FACADES`, bits 20
// and 21 of the frame switches). Off, every term behind them is compiled out.
fn fg_on() -> bool {
    return SF_FACADE_GLASS && (fa_run() & 1048576u) != 0u;
}

fn ff_on() -> bool {
    return SF_FAR_FACADES && (fa_run() & 2097152u) != 0u;
}

// smoothstep with the TSL/JS meaning for either edge order.
fn fa_ss(e0: f32, e1: f32, x: f32) -> f32 {
    let t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// cellHash / valueNoise (kit/materials.js).
fn fa_hash(cell: vec2<f32>, k: f32) -> f32 {
    return fract(sin(dot(cell, vec2<f32>(127.1 + k * 13.0, 311.7 - k * 7.0))) * (43758.5453 + k * 137.0));
}

fn fa_noise(p: vec2<f32>, k: f32) -> f32 {
    let i = floor(p);
    let f = p - i;
    let w = f * f * (3.0 - 2.0 * f);
    let a = fa_hash(i, k);
    let b = fa_hash(i + vec2<f32>(1.0, 0.0), k);
    let c = fa_hash(i + vec2<f32>(0.0, 1.0), k);
    let d = fa_hash(i + vec2<f32>(1.0, 1.0), k);
    let ab = a + (b - a) * w.x;
    let cd = c + (d - c) * w.x;
    return ab + (cd - ab) * w.y;
}

// The weathering graph's inputs (WEATHERING_SCALAR_KEYS) and structure.
struct FaW {
    base_y: f32,
    origin: vec2<f32>,
    patch_seed: f32,
    column_m: f32,
    soot_strength: f32,
    soot_top: f32,
    rough_gain: f32,
    grime_strength: f32,
    grime_a: vec2<f32>,
    grime_b: vec2<f32>,
    streak_drop: f32,
    streak_strength: f32,
    band_strength: f32,
    band_drop: f32,
    ceiling: f32,
    patch_light: f32,
    patch_dark: f32,
    patch_big: vec2<f32>,
    patch_small: vec2<f32>,
    reach_top: f32,
    reach_bottom: f32,
    mottle: f32,
    mottle_sheen: f32,
    mottle_a: vec2<f32>,
    mottle_b: vec2<f32>,
    soil_strength: f32,
    soil_top: f32,
    soil_bottom: f32,
    damp_strength: f32,
    damp_top: f32,
    // bands: the authored list (12 slots, unused far below), or (kit) first + pitch x i.
    band_first: f32,
    band_pitch: f32,
    band_count: u32,
    kit_bands: bool,
    rec: u32,
    // structure: 1 wall axis, 2 patches, 4 mottle, 8 base soil, 16 damp
    flags: u32,
};

fn fa_band(w: FaW, i: u32) -> f32 {
    if (w.kit_bands) {
        return w.band_first + w.band_pitch * f32(i);
    }
    let v = fa_weather_recs[w.rec * 13u + 9u + (2u + i) / 4u];
    return v[(2u + i) % 4u];
}

struct FaOut {
    color: f32,
    rough: f32,
};

fn fa_weather(w: FaW, p: vec3<f32>, n: vec3<f32>) -> FaOut {
    var o: FaOut;
    let y = p.y;
    let local = p.xz - w.origin;
    let local_y = y - w.base_y;
    let along = dot(local, vec2<f32>(0.7071, 0.7071));
    let rotated = dot(local, vec2<f32>(FA_AXIS_COS, FA_AXIS_SIN));
    var axis = rotated;
    if ((w.flags & 1u) != 0u) {
        let nxz = n.xz;
        let wall = dot(local, vec2<f32>(-nxz.y, nxz.x));
        let upright = fa_ss(0.35, 0.7, length(nxz));
        axis = mix(rotated, wall, upright);
    }
    axis = axis + w.patch_seed;
    let column = fract(sin(floor(along / w.column_m) * 12.9898) * 43758.5453);
    let column_mask = fa_ss(0.45, 0.95, column);
    var m = 1.0 - w.soot_strength * fa_ss(w.soot_top, w.base_y, y);
    let grime_a = fa_noise(vec2<f32>(axis / w.grime_a.x, local_y / w.grime_a.y), 4.0);
    let grime_b = fa_noise(vec2<f32>(axis / w.grime_b.x + 6.1, local_y / w.grime_b.y + 2.3), 5.0);
    m = m * (1.0 - w.grime_strength * (grime_a * 0.55 + grime_b * 0.45));
    var r = w.rough_gain * fa_ss(w.soot_top, w.base_y, y);
    if ((w.flags & 2u) != 0u) {
        let pale = fa_noise(vec2<f32>(axis / w.patch_big.x, local_y / w.patch_big.y), 1.0);
        let dark = fa_noise(vec2<f32>(axis / w.patch_small.x + 11.3, local_y / w.patch_small.y + 4.7), 2.0);
        let reach = 0.24 + 0.76 * fa_ss(w.reach_top, w.reach_bottom, y);
        let lighter = fa_ss(0.62, 0.88, pale);
        let darker = fa_ss(0.64, 0.92, dark);
        m = m * (1.0 + (lighter * w.patch_light - darker * w.patch_dark) * reach);
        r = r - lighter * 0.16 * reach + darker * 0.09 * reach;
    }
    if ((w.flags & 4u) != 0u) {
        let oa = fa_noise(vec2<f32>(axis / w.mottle_a.x + 3.7, local_y / w.mottle_a.y + 1.9), 7.0);
        let ob = fa_noise(vec2<f32>(axis / w.mottle_b.x + 8.3, local_y / w.mottle_b.y + 5.1), 8.0);
        let swing = (oa * 0.6 + ob * 0.4 - 0.5) * 2.0;
        m = m * (1.0 + swing * w.mottle);
        r = r - swing * w.mottle_sheen;
    }
    if ((w.flags & 8u) != 0u) {
        let broken = 0.72 + 0.28 * fa_noise(vec2<f32>(axis / 1.7, local_y / 0.9), 3.0);
        m = m * (1.0 - w.soil_strength * broken * fa_ss(w.soil_top, w.soil_bottom, y));
        if ((w.flags & 16u) != 0u) {
            m = m * (1.0 - w.damp_strength * fa_ss(w.damp_top, w.soil_bottom, y));
        }
    }
    for (var i = 0u; i < w.band_count; i = i + 1u) {
        let yb = fa_band(w, i);
        let below = fa_ss(yb + 0.12, yb - 0.02, y);
        let ramp = fa_ss(yb - w.streak_drop, yb, y);
        m = m * (1.0 - (w.streak_strength * below * ramp * column_mask + w.band_strength * below * fa_ss(yb - w.band_drop, yb, y) * 0.5));
    }
    o.color = clamp(m, 0.2, w.ceiling);
    o.rough = r;
    return o;
}

// A Blender building's literal scalars (facade.rs `weather_record`).
fn fa_authored(rec: u32) -> FaW {
    var w: FaW;
    let b = rec * 13u;
    let v0 = fa_weather_recs[b];
    let v1 = fa_weather_recs[b + 1u];
    let v2 = fa_weather_recs[b + 2u];
    let v3 = fa_weather_recs[b + 3u];
    let v4 = fa_weather_recs[b + 4u];
    let v5 = fa_weather_recs[b + 5u];
    let v6 = fa_weather_recs[b + 6u];
    let v7 = fa_weather_recs[b + 7u];
    let v8 = fa_weather_recs[b + 8u];
    let v9 = fa_weather_recs[b + 9u];
    w.base_y = v0.x;
    w.origin = v0.yz;
    w.patch_seed = v0.w;
    w.column_m = v1.x;
    w.soot_strength = v1.y;
    w.soot_top = v1.z;
    w.rough_gain = v1.w;
    w.grime_strength = v2.x;
    w.grime_a = v2.yz;
    w.grime_b = vec2<f32>(v2.w, v3.x);
    w.streak_drop = v3.y;
    w.streak_strength = v3.z;
    w.band_strength = v3.w;
    w.band_drop = v4.x;
    w.ceiling = v4.y;
    w.patch_light = v4.z;
    w.patch_dark = v4.w;
    w.patch_big = v5.xy;
    w.patch_small = v5.zw;
    w.reach_top = v6.x;
    w.reach_bottom = v6.y;
    w.mottle = v6.z;
    w.mottle_sheen = v6.w;
    w.mottle_a = v7.xy;
    w.mottle_b = v7.zw;
    w.soil_strength = v8.x;
    w.soil_top = v8.y;
    w.soil_bottom = v8.z;
    w.damp_strength = v8.w;
    w.damp_top = v9.x;
    w.flags = u32(v9.y);
    w.band_count = 12u;
    w.kit_bands = false;
    w.rec = rec;
    return w;
}

// The per-building drivers decoded from the packed appearance (decodeDrivers).
struct FaD {
    seed: f32,
    wear: f32,
    paint: f32,
    coastal: f32,
    base_y: f32,
    pitch: f32,
    first_sill: f32,
    origin: vec2<f32>,
};

fn fa_drivers(packed: vec4<f32>) -> FaD {
    var d: FaD;
    d.seed = floor(packed.x);
    d.wear = packed.x - d.seed;
    let coded = floor(packed.y);
    d.paint = packed.y - coded;
    d.coastal = step(255.5, coded);
    let codes = coded - d.coastal * 256.0;
    let pitch_code = floor(codes / 16.0);
    let first_code = codes - pitch_code * 16.0;
    let cell_row = floor(packed.w / 1024.0);
    d.base_y = packed.z;
    d.pitch = pitch_code * 0.125 + 2.5;
    d.first_sill = first_code * 0.25 + 0.6;
    d.origin = vec2<f32>((cell_row - 512.0) * 32.0, (packed.w - cell_row * 1024.0 - 512.0) * 32.0);
    return d;
}

// One AGEING_WEATHERING row: base + perUnit x driver (z: 0 W, 1 P, 2 max).
fn fa_row(row: vec3<f32>, d: FaD) -> f32 {
    var drv = max(d.wear, d.paint);
    if (row.z < 0.5) {
        drv = d.wear;
    } else if (row.z < 1.5) {
        drv = d.paint;
    }
    return row.x + drv * row.y;
}

fn fa_kit(d: FaD, cls: u32) -> FaW {
    var w: FaW;
    let roof = cls == FA_AGE_ROOF;
    let ghosts = cls == FA_AGE_RENDER && AGE_GHOSTS;
    let ghost = select(0.0, fa_row(AW_GHOST_STRENGTH, d), ghosts);
    let big = AF_PATCH_M;
    let small = big * 0.61;
    let grime = AF_GRIME_M;
    w.base_y = d.base_y;
    w.origin = d.origin;
    w.patch_seed = d.seed * 7.31;
    w.column_m = AF_COLUMN_M;
    w.soot_strength = select(fa_row(AW_SOOT_STRENGTH, d), 0.0, roof);
    w.soot_top = d.base_y + fa_row(AW_SOOT_HEIGHT, d);
    w.rough_gain = select(fa_row(AW_ROUGHNESS_GAIN, d), 0.0, roof);
    w.grime_strength = fa_row(AW_GRIME_STRENGTH, d);
    w.grime_a = vec2<f32>(grime, grime * 1.31);
    w.grime_b = vec2<f32>(grime * 1.73, grime * 2.11);
    w.streak_drop = fa_row(AW_STREAK_DROP, d);
    w.streak_strength = fa_row(AW_STREAK_STRENGTH, d);
    w.band_strength = fa_row(AW_BAND_STRENGTH, d);
    w.band_drop = fa_row(AW_BAND_DROP, d);
    w.ceiling = ghost + 1.0;
    w.patch_light = ghost;
    w.patch_dark = ghost * 0.85;
    w.patch_big = vec2<f32>(big, big * 0.78);
    w.patch_small = vec2<f32>(small, small * 0.86);
    w.reach_top = d.base_y + AF_PATCH_TOP + 0.6;
    w.reach_bottom = d.base_y + AF_PATCH_TOP - 1.4;
    let painted = cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED;
    w.mottle = select(fa_row(AW_MOTTLE_MASONRY, d), fa_row(AW_MOTTLE_PAINTED, d), painted);
    w.mottle_sheen = fa_row(AW_MOTTLE_SHEEN, d);
    w.mottle_a = vec2<f32>(big * 0.7, big * 0.7 * 0.82);
    w.mottle_b = vec2<f32>(big * 1.6, big * 1.6 * 0.9);
    w.soil_strength = AL_BASE_SOIL_STRENGTH;
    w.soil_top = AL_BASE_SOIL_TOP;
    w.soil_bottom = AL_BASE_SOIL_BOTTOM;
    w.damp_strength = AL_DAMP_STRENGTH;
    w.damp_top = AL_DAMP_TOP;
    w.band_first = d.base_y + d.first_sill;
    w.band_pitch = d.pitch;
    w.band_count = select(0u, AGE_BANDS, cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED || cls == FA_AGE_MASONRY);
    w.kit_bands = true;
    // structure { axis: 'wall', patches: { strength: ghosts, mottle: 1 } } + base soil.
    w.flags = 1u | 4u | select(0u, 2u, ghosts) | select(0u, 8u, AL_BASE_SOIL_STRENGTH > 0.0) | select(0u, 16u, AL_DAMP_ON && AL_BASE_SOIL_STRENGTH > 0.0);
    return w;
}

// The directional face frame (directional-surface-projection.js).
struct FaFrame {
    t: vec3<f32>,
    b: vec3<f32>,
    n: vec3<f32>,
};

fn fa_frame(n_in: vec3<f32>) -> FaFrame {
    var f: FaFrame;
    let n = normalize(n_in);
    let h = vec3<f32>(n.z, 0.0, -n.x);
    let hl = length(h);
    let roof = vec3<f32>(1.0, 0.0, 0.0) - n * n.x;
    f.t = select(roof / max(length(roof), 1e-6), h / max(hl, 1e-6), hl > 1e-6);
    f.b = normalize(cross(n, f.t));
    f.n = n;
    return f;
}

// facadeDetailSampleNode: one cell at wall metres, explicit level clamped at
// log2(padPx). Row 0 of the JS atlas is at the image bottom (flipY); the
// texture here is stored top row first, so v is mirrored.
struct FaDetail {
    texel: vec4<f32>,
    lod: f32,
};

// `fw`: fwidth of the wall metres (from the caller's position derivatives:
// derivatives may not be taken in this non-uniform branch).
fn fa_detail_sample(cell: f32, tile_m: f32, wall_m: vec2<f32>, fw: vec2<f32>) -> FaDetail {
    var o: FaDetail;
    let pad = FD_PAD_PX / FD_CELL_PX;
    let content = 1.0 - 2.0 * pad;
    let col = cell - FD_COLUMNS * floor(cell / FD_COLUMNS);
    let row = floor(cell / FD_COLUMNS);
    let tile_uv = wall_m / tile_m;
    let inner = fract(tile_uv) * content + pad;
    let atlas = (vec2<f32>(col, row) + inner) / vec2<f32>(FD_COLUMNS, FD_ROWS);
    let tpp = max(fw.x, fw.y) / tile_m * FD_CELL_PX * content;
    o.lod = clamp(log2(max(tpp, 1e-6)), 0.0, log2(FD_PAD_PX));
    o.texel = textureSampleLevel(fa_detail, fa_detail_sampler, vec2<f32>(atlas.x, 1.0 - atlas.y), o.lod);
    return o;
}

// Apply weathering / ageing to a surface. `world` and `ng` are world space;
// `mirror` the authoring mirror (Blender buildings). Kit: `kit_age` true.
fn fa_apply(s: ptr<function, Surface>, m: Material, world: vec3<f32>, ng: vec3<f32>, object: u32, dpx: vec3<f32>, dpy: vec3<f32>) {
    let run = fa_run();
    if ((run & FA_RUN_AGE) == 0u || (m.flags & FA_KIT_WEATHER) == 0u) {
        return;
    }
    let ob = objects[object];
    let kind = ob.kind & 255u;
    if (kind == 4u) {
        // A Blender building: the kit weathering with its literal scalars.
        if (ob.lod_group >= arrayLength(&fa_weather_recs) / 13u) {
            return;
        }
        let flags = u32(fa_weather_recs[ob.lod_group * 13u + 9u].y);
        if ((flags & 32u) == 0u) {
            return;
        }
        let w = fa_authored(ob.lod_group);
        let pa = vec3<f32>(world.x, world.y, -world.z);
        let na = vec3<f32>(ng.x, ng.y, -ng.z);
        let wo = fa_weather(w, pa, na);
        if (wx_level() != 0u && dot(ng.xz, ng.xz) > 0.25) {
            // weathering (`--grime`, weathering.wgsl): the graph's darkening deepened, splash-back at the foot.
            (*s).albedo = (*s).albedo * wx_authored(wo.color, world.y - w.base_y, dot(world.xz, vec2<f32>(-ng.z, ng.x)), w.patch_seed);
            (*s).rough = clamp((*s).rough + wo.rough, 0.03, 1.0);
            // stage W2c: the plumes and the damp that read from a block away (not on glossy glass or metal)
            if ((*s).rough > 0.35) {
                wx_mid_authored(s, world, ng, w.base_y, ob.max.y, w.patch_seed, wx_fw(dpx, dpy));
            }
            return;
        }
        (*s).albedo = (*s).albedo * wo.color;
        (*s).rough = clamp((*s).rough + wo.rough, 0.03, 1.0);
        return;
    }
    if (kind != 5u) {
        return;
    }
    let cls = (m.flags >> 8u) & 7u;
    if (cls == 0u) {
        return;
    }
    let packed = fa_ages[ob.lod_group];
    let d = fa_drivers(packed);
    // The foundation skirt below the floor is not the wall's finish (archetype-tile-stream.js).
    if (world.y < d.base_y - 0.02) {
        return;
    }
    let w = fa_kit(d, cls);
    let wo = fa_weather(w, world, ng);
    var color = (*s).albedo * wo.color;
    if (wx_level() != 0u) {
        // weathering (`--grime`): the graph's soot, grime and run-off deepened by the building's own age.
        color = (*s).albedo * clamp(1.0 - (1.0 - wo.color) * (1.0 + 0.8 * wx_building_k(d.seed)), 0.2, 1.6);
    }
    let rough_scale = select(1.0, clamp(d.paint * 1.5 + 0.25, 0.0, 1.0), cls == FA_AGE_RENDER);
    var rough = (*s).rough + wo.rough * rough_scale;
    var occlusion = 1.0;
    let local = world.xz - d.origin;
    let nxz = ng.xz;
    let upright = fa_ss(0.35, 0.7, length(nxz));
    let along = dot(local, vec2<f32>(-nxz.y, nxz.x)) + d.seed * 7.31;
    let local_y = world.y - d.base_y;
    let wear = d.wear;
    if (cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED) {
        let patchy = 0.75 + fa_noise(vec2<f32>(along / 3.1, local_y / 2.3), 23.0) * 0.5;
        let fade = fa_row(AW_PAINT_FADE, d) * patchy * upright;
        let chalk = vec3<f32>(dot(color, vec3<f32>(0.2126, 0.7152, 0.0722))) * 1.08 + 0.025;
        color = mix(color, chalk, fade);
    }
    if (cls == FA_AGE_METAL) {
        let ra = clamp(fa_row(AW_RUST, d), 0.0, 1.0);
        let p = vec2<f32>(local.x + local.y * 0.61, local_y + local.y * 0.27) / 0.3;
        let field = fa_noise(p, 29.0) * 0.65 + fa_noise(p * 3.7 + 5.3, 31.0) * 0.35;
        let low = (1.0 - fa_ss(0.0, 0.4, local_y)) * 0.25;
        let rust = fa_ss(0.74 - ra * 0.2, 0.88 - ra * 0.2, field + low) * ra;
        color = mix(color, FA_RUST * (field * 0.8 + 0.6), rust * 0.6);
        rough = rough + rust * 0.28;
    }
    let di = (m.flags >> 11u) & 31u;
    // a wall drawing a CC0 scan carries its own relief and cavity; the sheet's cells (knotted pine, plaster) stand down.
    if (AGE_DETAIL && di > 0u && (run & FA_RUN_DETAIL) != 0u && !cc0_wall_hit) {
        let spec = FD_SPEC[di - 1u];
        let spec2 = FD_SPEC2[di - 1u];
        let fr = fa_frame(ng);
        let fw = abs(vec2<f32>(dot(dpx, fr.t), dot(dpx, fr.b))) + abs(vec2<f32>(dot(dpy, fr.t), dot(dpy, fr.b)));
        let sm = fa_detail_sample(spec.x, spec.y, vec2<f32>(dot(world, fr.t), dot(world, fr.b)), fw);
        if (sm.texel.a > 0.5) {
            let cavity = sm.texel.z - 0.5;
            let near = 1.0 - fa_ss(2.5, 4.0, sm.lod);
            let qx = (sm.texel.x * 2.0 - 1.0) * spec.z * near;
            let qy = (sm.texel.y * 2.0 - 1.0) * spec.z * near;
            let qz = sqrt(1.0 - min(0.98, qx * qx + qy * qy));
            let dn = normalize(fr.t * qx + fr.b * qy + fr.n * qz);
            if (spec2.y > 0.5) {
                (*s).n = dn;
            } else {
                (*s).n = normalize((*s).n + dn - fr.n);
            }
            color = color * (cavity * (spec.w * 2.0) + 1.0);
            rough = rough - cavity * 0.22;
            occlusion = occlusion * (1.0 - max(-cavity, 0.0) * (spec2.x * 2.0));
        }
    }
    if (cls != FA_AGE_ROOF && cls != FA_AGE_METAL) {
        let top = AS_SPLASH_TOP + wear * AS_SPLASH_TOP_WEAR;
        let blot = fa_noise(vec2<f32>(along / 0.21, local_y / 0.13), 61.0) * 0.6 + fa_noise(vec2<f32>(along / 0.9, 3.1), 67.0) * 0.4;
        let reach = top * (blot * 0.7 + 0.65);
        let splash = (1.0 - fa_ss(0.0, reach, local_y)) * upright;
        color = color * (1.0 - splash * (AS_SPLASH_DARK + wear * AS_SPLASH_DARK_WEAR));
        rough = rough + splash * 0.1;
    }
    // run-off stains under the sills (the Leaking scans at the building's own sill rhythm).
    if ((cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED || cls == FA_AGE_MASONRY) && cc0_wall_hit && upright > 0.5) {
        color = color * cc0_wall_stain(world, along, local_y, d, dpx, dpy, fa_frame(ng).t);
    }
    // grime rising from the wall's foot (the rising-grime scan over the splash zone above).
    if (cls != FA_AGE_ROOF && cc0_wall_hit && upright > 0.5) {
        color = color * cc0_wall_base(along, local_y, wear, dpx, dpy, fa_frame(ng).t);
    }
    if ((cls == FA_AGE_RENDER || cls == FA_AGE_MASONRY) && d.coastal > 0.5) {
        let salt = fa_noise(vec2<f32>(along / 0.55, local_y / 0.33), 71.0) * 0.7 + fa_noise(vec2<f32>(along / 0.12, local_y / 0.09), 73.0) * 0.3;
        let zone = 1.0 - fa_ss(0.2, AS_SALT_REACH, local_y);
        let bloom = fa_ss(0.56, 0.72, salt + zone * 0.25) * zone * d.coastal * wear * upright * AS_SALT_STRENGTH;
        color = mix(color, vec3<f32>(0.78, 0.77, 0.73), bloom);
        rough = rough + bloom * 0.2;
    }
    if (wx_level() != 0u) {
        // weathering (`--grime`, weathering.wgsl): streaks, roof-edge soot, splash-back, sun fade.
        wx_facade(&color, &rough, world, ng, along, local_y, d, cls, upright, ob.max.y, wx_fw(dpx, dpy));
        // stage W5: old painted sashes and frames chalked and peeling, dirt on the trim's ledges, drip lines under them.
        wx_window_trim(&color, &rough, world, ng, local_y, d, di, wx_fw(dpx, dpy));
    }
    (*s).albedo = color;
    (*s).rough = clamp(rough, 0.03, 1.0);
    (*s).ao = clamp((*s).ao * occlusion, 0.0, 1.0);
}

// ---- the scene probe (probe.rs; environment-ibl.js scene bake) ----------------

// FA_PROBE_SHADER (look.rs `city_shader_source_variant_probes`): false
// compiles the single probe's lookups out of a pipeline whose frame never
// names one (props, agents: their group 0 binds stand-ins, probe_info zero).
fn fa_probe_on() -> bool {
    return FA_PROBE_SHADER && frame.probe_info.w > 0.5 && (fa_run() & 8u) != 0u && frame.copy_step.z < 0.5;
}

// three's cubeUV roughness -> level (mip = -2 log2(1.16 r), level 0 = the
// full face): 0 sharpest .. FA_PROBE_MAXLOD.
fn fa_probe_lod(r: f32) -> f32 {
    return clamp(FA_PROBE_LOG2 + 2.0 * log2(max(1.16 * r, 1e-4)), 0.0, FA_PROBE_MAXLOD);
}

// A direction's face and texel (the same basis probe.rs renders with).
fn fa_probe_sample(d: vec3<f32>, lod: f32) -> vec3<f32> {
    let a = abs(d);
    var f = 0u;
    var fw = vec3<f32>(1.0, 0.0, 0.0);
    var up = vec3<f32>(0.0, 1.0, 0.0);
    if (a.x >= a.y && a.x >= a.z) {
        f = select(1u, 0u, d.x > 0.0);
        fw = vec3<f32>(sign(d.x), 0.0, 0.0);
    } else if (a.y >= a.z) {
        f = select(3u, 2u, d.y > 0.0);
        fw = vec3<f32>(0.0, sign(d.y), 0.0);
        up = vec3<f32>(0.0, 0.0, -sign(d.y));
    } else {
        f = select(5u, 4u, d.z > 0.0);
        fw = vec3<f32>(0.0, 0.0, sign(d.z));
    }
    let right = cross(fw, up);
    let k = 1.0 / max(dot(d, fw), 1e-6);
    let uv = vec2<f32>(dot(d, right) * k * 0.5 + 0.5, 0.5 - dot(d, up) * k * 0.5);
    return textureSampleLevel(fa_probe_tex, fa_probe_samp, uv, f, lod).rgb;
}

// glazing-environment.js: never sharper than the probe's 4-texel footprint
// (roughness floor), the lookup lifted as if pane and capture point stood in
// one street canyon of width FA_CANYON_M (lift only), and where the lifted
// sample is open sky the dome's term along the pane's own ray.
fn fa_glazing(dir: vec3<f32>, world: vec3<f32>, rough: f32) -> vec3<f32> {
    let h = max(world.y - frame.probe_info.y, 0.0);
    let horizontal = max(length(dir.xz), 1e-4);
    let corrected = normalize(vec3<f32>(dir.x, dir.y + horizontal * (h / FA_CANYON_M), dir.z));
    let lifted = fa_probe_sample(corrected, fa_probe_lod(max(rough, FA_GLAZING_FLOOR)));
    // the JS reads `skyDomeRadiance` here (wet-surface-reflection.js: the
    // horizon/zenith mix, clamped at the horizon), not the visible dome with
    // its street field below the horizon: a downward reflection is open sky
    // only where the probe there is as bright as the horizon, and the
    // own-ray term below the horizon is the horizon colour, not the dark
    // street field (the hard line and dark lower half in large panes).
    let dome_lifted = lk_js_dome(corrected);
    let dome_own = lk_js_dome(normalize(dir));
    let luma = vec3<f32>(0.2126, 0.7152, 0.0722);
    let lp = dot(lifted, luma);
    let ld = dot(dome_lifted, luma);
    let sky_like = fa_ss(0.55, 0.85, min(lp, ld) / max(max(lp, ld), 1e-6));
    return max(lifted + (dome_own - dome_lifted) * sky_like, vec3<f32>(0.0));
}

// The front capture's irradiance (the probe's diffuse, as three reads the bound bake).
fn fa_probe_irradiance(n: vec3<f32>) -> vec3<f32> {
    let x = n.x;
    let y = n.y;
    let z = n.z;
    var e = fa_probe_sh[1].xyz * 0.282095;
    e = e + fa_probe_sh[2].xyz * (0.488603 * y) + fa_probe_sh[3].xyz * (0.488603 * z) + fa_probe_sh[4].xyz * (0.488603 * x);
    e = e + fa_probe_sh[5].xyz * (1.092548 * x * y) + fa_probe_sh[6].xyz * (1.092548 * y * z) + fa_probe_sh[7].xyz * (0.315392 * (3.0 * z * z - 1.0));
    e = e + fa_probe_sh[8].xyz * (1.092548 * x * z) + fa_probe_sh[9].xyz * (0.546274 * (x * x - y * y));
    return max(e, vec3<f32>(0.0));
}

// ---- (`--facade-weather`, facade.rs `weather_from_args`) the kit walls' run-off and foot ----
// Dust and soot settle on a window's sill; the rain washes them off its two
// ends and, where it has no drip groove, over its front edge, and the dirty
// water leaves dark streaks down the wall under it that widen as they fall
// and fade over a metre or two, more and longer on an old building. Right
// under the sill, sheltered from the rain, the dirt settles and stays. The
// kit marks every wall piece in a window's column with its place across the
// window and its depth under the sill above (kit.rs `weather_marks`): the
// band under a window and the band over the window below, one piece on the
// mid rung; the window's width comes from how fast the place changes over
// the wall. At every wall's foot: the splash-back the rain throws up off the
// walk (a ragged band of mud specks), on render and masonry rising damp with
// a pale salt tide line at its top, and the grime of the street's hands,
// bags and bins fading up the ground floor. Every detail gives way to its
// mean as it shrinks under a pixel (a streak widens and pales as its share
// of the pixel falls), so it holds its tone from 2 m to a block away.
// INFERRED sizes and strengths (FW_*), from photographs of aged sills.
// a streak's centre in from the window's jamb, m
const FW_END_IN: vec2<f32> = vec2<f32>(0.035, 0.11);
// its e-folding length down the wall, m (times 0.6-1.4 by the building's wear)
const FW_LEN: vec2<f32> = vec2<f32>(0.5, 3.0);
// its half-width under the sill and how much it widens a metre down, m
const FW_W0: vec2<f32> = vec2<f32>(0.022, 0.055);
const FW_SPREAD: vec2<f32> = vec2<f32>(0.012, 0.045);
// the share of sill ends that streak (new .. old) and of front-edge drips per FW_DRIP_PITCH
const FW_END_SHARE: vec2<f32> = vec2<f32>(0.45, 0.95);
const FW_DRIP_SHARE: vec2<f32> = vec2<f32>(0.12, 0.5);
const FW_DRIP_PITCH: f32 = 0.55;
// the dirt's colour as a multiplier of the wall's at full soiling (soot and dust: darker, a little warm)
const FW_DIRT: vec3<f32> = vec3<f32>(0.40, 0.38, 0.345);
// a wet wall's albedo multiplier and roughness (x, y): a porous finish (render, masonry: the water
// fills its pores) and a paint film; the run-off's sheet of water
const FW_WET_POROUS: vec2<f32> = vec2<f32>(0.6, 0.48);
const FW_WET_PAINT: vec2<f32> = vec2<f32>(0.84, 0.22);
const FW_FILM_ROUGH: f32 = 0.1;
// the salt's tone (efflorescence) at the damp's tide line
const FW_SALT: vec3<f32> = vec3<f32>(0.66, 0.65, 0.62);

fn fw_on() -> bool {
    return SF_FACADE_WEATHER && (fa_run() & 4194304u) != 0u;
}

// a kit wall piece kit.rs `weather_marks` marked (its w byte 1 + 61 u; 0 none, 63 and up a sign's glow code).
fn fw_marked(aux_y: f32) -> bool {
    let q = aux_y * 127.0;
    return q > 0.5 && q < 62.5;
}

fn fw_u(x: u32) -> u32 {
    let s = x * 747796405u + 2891336453u;
    let w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

fn fw_h(k: vec3<i32>, salt: u32) -> f32 {
    let b = bitcast<vec3<u32>>(k);
    return f32(fw_u(b.x ^ fw_u(b.y ^ fw_u(b.z ^ (salt * 2654435769u)))) >> 8u) / 16777216.0;
}

// value noise along one axis, keyed.
fn fw_n1(x: f32, k: vec3<i32>, salt: u32) -> f32 {
    let i = floor(x);
    let f = x - i;
    let a = fw_h(k + vec3<i32>(i32(i), 0, 0), salt);
    let b = fw_h(k + vec3<i32>(i32(i) + 1, 0, 0), salt);
    return mix(a, b, f * f * (3.0 - 2.0 * f));
}

// one streak's soiling at `x` across the window and `depth` under its sill,
// centred at `xc`; `scale` shrinks a front-edge drip; `fw` the pixel's footprint.
fn fw_streak(x: f32, depth: f32, xc: f32, key: vec3<i32>, salt: u32, wear: f32, fw: f32, scale: f32) -> f32 {
    let len = mix(FW_LEN.x, FW_LEN.y, fw_h(key, salt + 1u)) * mix(0.6, 1.4, wear) * scale;
    if (depth > len * 4.0) {
        return 0.0;
    }
    let w = (mix(FW_W0.x, FW_W0.y, fw_h(key, salt + 2u)) + depth * mix(FW_SPREAD.x, FW_SPREAD.y, fw_h(key, salt + 3u))) * mix(1.0, scale, 0.6);
    // under a pixel the streak widens to the footprint and pales by as much (its share of the pixel)
    let wf = sqrt(w * w + 0.3 * fw * fw);
    let keep = 1.0 - smoothstep(0.015, 0.05, fw);
    let wig = 0.012 * sin(depth * mix(4.0, 9.0, fw_h(key, salt + 4u)) + fw_h(key, salt + 5u) * 6.2832) * min(depth * 2.0, 1.0) * keep;
    let dx = (x - xc - wig) / wf;
    let across = exp(-dx * dx * 1.4) * (w / wf);
    let along = smoothstep(0.0, 0.04, depth) * exp(-depth / len);
    // the deposit lies unevenly down the streak
    let blot = mix(0.5 + 0.5 * fw_n1(depth / 0.2 + fw_h(key, salt + 6u) * 31.0, key, salt + 7u), 0.75, smoothstep(0.06, 0.25, fw));
    return across * along * blot;
}

fn fw_apply(s: ptr<function, Surface>, m: Material, world: vec3<f32>, ng: vec3<f32>, object: u32, code: f32, dcode: vec2<f32>, depth: f32, dpx: vec3<f32>, dpy: vec3<f32>) {
    let cls = (m.flags >> 8u) & 7u;
    if (cls == FA_AGE_ROOF || cls == FA_AGE_METAL || abs(ng.y) > 0.3) {
        return;
    }
    let ob = objects[object];
    let d = fa_drivers(fa_ages[ob.lod_group]);
    let wear = clamp(d.wear, 0.0, 1.0);
    let fw = max(length(dpx), length(dpy));
    let t = normalize(vec3<f32>(-ng.z, 0.0, ng.x));
    var dirt = 0.0;
    var run = 0.0;
    if (code > 0.0) {
        // the window's width from how fast the place across it changes along the wall
        let sx = dot(dpx, t);
        let sy = dot(dpy, t);
        let g = (dcode.x * sx + dcode.y * sy) / max(sx * sx + sy * sy, 1e-12);
        let width = 61.0 / max(abs(g), 1e-4);
        if (width > 0.2 && width < 60.0) {
            let x = clamp((code - 1.0) / 61.0, 0.0, 1.0) * width;
            let td = t * sign(g);
            let left = world - td * x;
            let right = left + td * width;
            let ky = i32(floor((world.y + depth) * 4.0 + 0.5));
            let kl = vec3<i32>(vec2<i32>(floor(left.xz * 4.0 + 0.5)), ky);
            let kr = vec3<i32>(vec2<i32>(floor(right.xz * 4.0 + 0.5)), ky);
            let k = mix(0.55, 1.05, wear);
            let share = mix(FW_END_SHARE.x, FW_END_SHARE.y, wear);
            // the sill's two ends
            for (var e = 0; e < 2; e = e + 1) {
                let key = select(kl, kr, e == 1);
                if (fw_h(key, 1u) < share) {
                    let inset = min(mix(FW_END_IN.x, FW_END_IN.y, fw_h(key, 2u)), 0.3 * width);
                    let xc = select(inset, width - inset, e == 1);
                    let st = fw_streak(x, depth, xc, key, 10u, wear, fw, 1.0);
                    dirt = dirt + st * k * mix(0.65, 1.0, fw_h(key, 9u));
                    run = max(run, st);
                }
            }
            // drips off the sill's front edge
            if (width > 0.6) {
                let cell = floor(x / FW_DRIP_PITCH);
                let dshare = mix(FW_DRIP_SHARE.x, FW_DRIP_SHARE.y, wear);
                for (var c = -1; c <= 1; c = c + 1) {
                    let ci = cell + f32(c);
                    let kd = vec3<i32>(kl.x + i32(ci) * 7 + 3, kl.y + 11, kl.z);
                    if (fw_h(kd, 4u) < dshare) {
                        let xc = (ci + 0.5 + (fw_h(kd, 5u) - 0.5) * 0.7) * FW_DRIP_PITCH;
                        if (xc > 0.15 && xc < width - 0.15) {
                            let st = fw_streak(x, depth, xc, kd, 20u, wear, fw, 0.45);
                            dirt = dirt + st * k * 0.6;
                            run = max(run, st * 0.8);
                        }
                    }
                }
            }
            // the sheltered strip right under the sill
            dirt = dirt + 0.22 * k * (1.0 - smoothstep(0.0, 0.16, depth));
        }
    }
    // the wall's foot
    var salt = 0.0;
    let ly = world.y - d.base_y;
    if (ly < 3.0 && ly > -0.05) {
        let along = dot(world.xz, t.xz);
        let edge = max(0.025, fw);
        let keep = 1.0 - smoothstep(0.01, 0.04, fw);
        // the splash-back: a ragged band of mud specks
        let top = mix(0.22, 0.45, wear) * (0.75 + 0.5 * fa_noise(vec2<f32>(along / 0.9, 1.3 + d.seed), 81.0));
        let ragged = top + 0.06 * (fa_noise(vec2<f32>(along / 0.13, ly / 0.11), 82.0) - 0.5) * keep;
        let splash = 1.0 - smoothstep(ragged - edge, ragged + edge, ly);
        let speck = mix(fa_ss(0.45, 0.8, fa_noise(vec2<f32>(along / 0.025, ly / 0.025), 84.0)), 0.3, 1.0 - keep);
        dirt = dirt + splash * (0.32 + 0.4 * speck) * mix(0.5, 1.0, wear);
        // rising damp on render and masonry, its tide line pale with salt
        if (cls == FA_AGE_RENDER || cls == FA_AGE_MASONRY) {
            let damp_top = mix(0.45, 1.15, fract(d.seed * 0.618)) * mix(0.55, 1.0, wear) * (0.85 + 0.3 * fa_noise(vec2<f32>(along / 1.7, 7.7), 83.0));
            let damp = 1.0 - smoothstep(damp_top - edge, damp_top + edge, ly);
            dirt = dirt + damp * 0.2 * wear;
            let tl = (ly - damp_top) / max(0.03, fw);
            salt = exp(-tl * tl) * wear * 0.3 * (0.5 + 0.5 * fa_noise(vec2<f32>(along / 0.4, 3.3), 86.0));
        }
        // the street's grime over the ground floor
        dirt = dirt + 0.14 * wear * (1.0 - smoothstep(0.3, 2.4, ly)) * (0.55 + 0.45 * fa_noise(vec2<f32>(along / 2.3, ly / 0.8), 85.0));
    }
    let kd = clamp(dirt, 0.0, 0.92);
    (*s).albedo = mix((*s).albedo, (*s).albedo * FW_DIRT, kd);
    (*s).albedo = mix((*s).albedo, FW_SALT * max(max((*s).albedo.r, (*s).albedo.g), (*s).albedo.b) * 1.15, salt);
    (*s).rough = clamp((*s).rough + kd * 0.08, 0.03, 1.0);
    // in the rain: the wall wet where the driven rain reaches it (more up the wall and under the
    // roof's edge, less on the sheltered ground floor) and in the run-off's paths under each sill
    let w = skyu.wet.x;
    if (sky_on(skyu.flags.x, SKY_WET) && w > 0.02) {
        let top = ob.max.y - world.y;
        let exposed = clamp(0.35 + 0.5 * smoothstep(1.5, 10.0, ly) + 0.35 * (1.0 - smoothstep(0.0, 3.0, top)), 0.0, 1.0);
        let ww = w * clamp(exposed + 1.4 * run, 0.0, 1.0);
        // a porous finish (render, masonry) darkens and deepens its colour as the water fills it and
        // stays matte; a paint film beads and sheets, darkening less and turning glossy
        let porous = cls == FA_AGE_RENDER || cls == FA_AGE_MASONRY;
        let dark = select(FW_WET_PAINT.x, FW_WET_POROUS.x, porous);
        let wet_rough = select(FW_WET_PAINT.y, FW_WET_POROUS.y, porous);
        let a = (*s).albedo;
        let l = dot(a, vec3<f32>(0.2126, 0.7152, 0.0722));
        let deep = max(mix(vec3<f32>(l), a, 1.0 + 0.35 * ww), vec3<f32>(0.0));
        (*s).albedo = deep * mix(1.0, dark, ww);
        // the run-off's film: a sheet of water down the streaks' paths
        (*s).rough = mix(mix((*s).rough, wet_rough, ww), FW_FILM_ROUGH, clamp(run * 1.6, 0.0, 1.0) * w);
    }
}
