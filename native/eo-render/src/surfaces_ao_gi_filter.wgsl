// (`--screen-gi`, SF_SCREEN_GI; eo-look `screen_gi`) the occlusion pass's
// spatial filter: the gather's history blend (surfaces_ao_gi.wgsl) over
// 5 x 5 half-resolution texels (binomial weights) into the texture the lit
// shader reads, each neighbour weighted down by its distance from the
// point's own plane (the view depth extrapolated along its gradient), so
// the bounce and the occlusion never cross a silhouette. The history keeps
// the unfiltered blend (no blur feeds back). Its own module (constants GI_*
// generated by look.rs `ao_gi_filter_source`).

@group(0) @binding(0) var gf_in: texture_2d<f32>;
@group(0) @binding(1) var gf_z: texture_2d<f32>;
@group(0) @binding(2) var gf_out: texture_storage_2d<rgba16float, write>;

fn gf_depth(p: vec2<i32>, dims: vec2<i32>) -> f32 {
    return textureLoad(gf_z, clamp(p, vec2<i32>(0), dims - 1), 0).r;
}

// The view depth's step per texel along one axis: the smaller one-sided step (a silhouette's far side left out).
fn gf_slope(zc: f32, a: f32, b: f32) -> f32 {
    let da = zc - a;
    let db = b - zc;
    if (a <= 0.0) {
        return select(0.0, db, b > 0.0);
    }
    if (b <= 0.0) {
        return da;
    }
    return select(da, db, abs(db) < abs(da));
}

// The 5-tap binomial (1 4 6 4 1) at offset i.
fn gf_binomial(i: i32) -> f32 {
    let a = abs(i);
    return select(select(1.0, 4.0, a == 1), 6.0, a == 0);
}

@compute @workgroup_size(8, 8)
fn ao_gi_filter(@builtin(global_invocation_id) gid: vec3<u32>) {
    let dims = vec2<i32>(textureDimensions(gf_in));
    let hp = vec2<i32>(gid.xy);
    if (hp.x >= dims.x || hp.y >= dims.y) {
        return;
    }
    let c = textureLoad(gf_in, hp, 0);
    let zc = gf_depth(hp, dims);
    if (zc <= 0.0) {
        textureStore(gf_out, hp, vec4<f32>(c.rgb, clamp(c.a, 0.0, 1.0)));
        return;
    }
    let gx = gf_slope(zc, gf_depth(hp - vec2<i32>(1, 0), dims), gf_depth(hp + vec2<i32>(1, 0), dims));
    let gy = gf_slope(zc, gf_depth(hp - vec2<i32>(0, 1), dims), gf_depth(hp + vec2<i32>(0, 1), dims));
    let tol = GI_FILTER_PLANE_M + GI_FILTER_PLANE_REL * zc;
    var acc = vec4<f32>(0.0);
    var wsum = 0.0;
    for (var y = -2; y <= 2; y = y + 1) {
        for (var x = -2; x <= 2; x = x + 1) {
            let q = hp + vec2<i32>(x, y);
            if (any(q < vec2<i32>(0)) || any(q >= dims)) {
                continue;
            }
            let z = textureLoad(gf_z, q, 0).r;
            if (z <= 0.0) {
                continue;
            }
            let off = z - (zc + gx * f32(x) + gy * f32(y));
            let w = gf_binomial(x) * gf_binomial(y) * exp(-abs(off) / tol);
            acc = acc + w * textureLoad(gf_in, q, 0);
            wsum = wsum + w;
        }
    }
    // (the history may hold a visibility a little past 0..1: one slice a frame weighted against two)
    let o = select(c, acc / wsum, wsum > 1e-6);
    textureStore(gf_out, hp, vec4<f32>(o.rgb, clamp(o.a, 0.0, 1.0)));
}
