// Stage W1: a lived-in city (weathering.rs; `--grime 1|2`, off by default).
// Aged, soiled walks; worn, patched carriageways; chipped kerbs and their
// faded paint; washed-down, sooted facades; dusty cars. Albedo and roughness
// only: no emission, nothing painted into the lighting. Every function here
// runs only behind `wx_level() != 0u` at its call site, so with the level 0
// none of it is reached and the frame is as before. Constants WX_* are
// generated by weathering.rs (cited there). Composed into every city shader
// variant (look.rs); called from draw.wgsl (street, marking paint),
// facade_age.wgsl (kit and Blender buildings), cc0.wgsl (the decals) and
// agents_draw.wgsl (cars).

// The level from the frame's switches (facade::RUN_GRIME_*): 0 off, 1 high, 2 hyper.
// SF_GRIME false (look.rs `ShaderFeatures`: off at start) compiles every term out.
fn wx_level() -> u32 {
    if (!SF_GRIME) {
        return 0u;
    }
    return (u32(frame.copy_step.y) >> WX_RUN_SHIFT) & 3u;
}

// A pixel's footprint on the surface (metres).
fn wx_fw(dpx: vec3<f32>, dpy: vec3<f32>) -> f32 {
    return max(length(dpx), length(dpy));
}

// 1 while a detail of `scale` metres spans a few pixels, 0 once it is under
// one (the caller then draws the detail's mean: no shimmer, the same tone).
fn wx_keep(scale: f32, fw: f32) -> f32 {
    return 1.0 - smoothstep(scale * 0.2, scale * 0.6, fw);
}

// The cover of a band of half-width `hw` at distance `d` (m), filtered: a
// sharp band near, its area spread over the pixel once it is thinner.
fn wx_band(d: f32, hw: f32, fw: f32) -> f32 {
    return (1.0 - smoothstep(hw, hw + fw, d)) * min(1.0, 2.0 * hw / max(fw, 1e-5));
}

// The kerb-distance coordinate's world-xz gradient (the across direction of
// the walk or the carriageway), from its screen derivatives (draw.wgsl
// `shade` keeps them in cc0_daux / cc0_drx / cc0_dry).
fn wx_kerb_grad() -> vec2<f32> {
    let rx = cc0_drx;
    let ry = cc0_dry;
    let det = rx.x * ry.z - rx.z * ry.x;
    if (abs(det) < 1e-14) {
        return vec2<f32>(0.0);
    }
    return vec2<f32>(cc0_daux.x * ry.z - cc0_daux.y * rx.z, cc0_daux.y * rx.x - cc0_daux.x * ry.x) / det * 6.35;
}

// The kerb line's along coordinate from the eye (small numbers) and the eye's
// own whole periods `k` (a cell index is floor(along / period) + k), as
// cc0_scoring takes it: cells keyed on the world, not the eye.
struct WxRun {
    ok: bool,
    along: f32,
    k: f32,
};

fn wx_run(rel: vec3<f32>, g: vec2<f32>, period: f32) -> WxRun {
    var r: WxRun;
    let gl = length(g);
    r.ok = gl > 0.3;
    let nrm = g / max(gl, 1e-6);
    let tan = vec2<f32>(-nrm.y, nrm.x);
    let a_eye = dot(frame.cam_pos.xz, tan);
    r.k = floor(a_eye / period);
    r.along = (a_eye - r.k * period) + dot(rel.xz, tan);
    return r;
}

// ---- walks and kerbs --------------------------------------------------------

// Trodden chewing gum as statistical speckle: per cell at most one dark disc
// (the Mission St photo's 1-4 cm discs), present with probability `dens`;
// once a cell is under a pixel, the field's expected cover.
fn wx_gum(p: vec2<f32>, fw: f32, dens: f32) -> vec2<f32> {
    let c = WX_GUM_CELL_M;
    let cell = floor(p / c);
    let h = st_hash(cell + vec2<f32>(13.1, 71.7));
    let o = vec2<f32>(st_hash(cell + vec2<f32>(5.3, 2.9)), st_hash(cell + vec2<f32>(91.1, 33.3)));
    let u = st_hash(cell + vec2<f32>(27.7, 8.1));
    let r = WX_GUM_R_MIN + (WX_GUM_R_MAX - WX_GUM_R_MIN) * u * u;
    let ctr = (cell + 0.25 + 0.5 * o) * c;
    let d = length(p - ctr);
    // a trodden disc's ragged rim
    let rim = r * (0.8 + 0.4 * st_noise((p - ctr) / max(r, 1e-3) * 1.7 + o * 9.0));
    let disc = (1.0 - smoothstep(rim - 0.5 * fw, rim + 0.5 * fw, d)) * select(0.0, 1.0, h < dens);
    let mean = dens * WX_GUM_MEAN_AREA / (c * c);
    let keep = wx_keep(c, fw);
    // (cover, the disc's tone: fresh gum near black, old gum greying)
    return vec2<f32>(mix(mean, disc, keep), mix(0.5, st_hash(cell + vec2<f32>(61.9, 4.4)), keep));
}

// A crumbled arris: chips of aggregate and held dirt along a kerb's edge
// (`edge` 1 at the arris).
fn wx_chip(s: ptr<function, Surface>, world: vec3<f32>, edge: f32, fw: f32) {
    if (edge <= 0.0) {
        return;
    }
    let c = st_noise(world.xz / WX_CHIP_SCALE_M + world.y * 7.0) * 0.7 + st_noise(world.xz / (WX_CHIP_SCALE_M * 0.31) + 3.3) * 0.3;
    let chip = smoothstep(0.6, 0.72, c) * edge;
    let k = mix(0.18 * edge, chip, wx_keep(WX_CHIP_SCALE_M, fw));
    (*s).albedo = (*s).albedo * (1.0 - WX_CHIP_DARK * k);
    (*s).rough = min(1.0, (*s).rough + 0.12 * k);
    (*s).ao = (*s).ao * (1.0 - 0.35 * k);
}

// The walk concrete (footway, kerb top, ramp, kerb face) aged and soiled.
// `kd`: metres from the kerb line (the kerb face: above the flow line), < 0 none.
fn wx_walk(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, cls: u32, kd: f32, g: vec2<f32>, fw: f32, lvl: u32) {
    // The aged concrete's fold on the walks' and kerbs' concrete; a plaza's pavers (the footway
    // layer with no kerb line) keep their own tone and take only the soiling below.
    if (cls != SC_FOOTWAY || kd >= 0.0) {
        (*s).albedo = (*s).albedo * WX_WALK_FOLD;
    }
    // Where people stop and walk most: a slow field (decals add the surveyed shop doors and stops).
    let act = smoothstep(0.28, 0.78, st_noise(world.xz / 11.0 + 7.3));
    var clean = 0.0;
    if (cls == SC_FOOTWAY && kd >= 0.0 && CC0_SCORING_M > 0.0) {
        let pitch = CC0_SCORING_M;
        let r = wx_run(rel, g, pitch);
        if (r.ok) {
            let cell = floor(vec2<f32>(r.along, kd) / pitch) + vec2<f32>(r.k, 0.0);
            let r0 = st_hash(cell + vec2<f32>(41.3, 17.9));
            let r1 = st_hash(cell + vec2<f32>(3.7, 59.1));
            // Each slab its own pour; a few newer replacement slabs (lighter, cleaner), a few old dark ones.
            var tone = 1.0 + (r0 - 0.5) * WX_SLAB_SPREAD;
            if (r1 > 1.0 - WX_SLAB_NEW_SHARE) {
                tone = tone * WX_SLAB_NEW_TONE;
                clean = 1.0;
            } else if (r1 < WX_SLAB_OLD_SHARE) {
                tone = tone * WX_SLAB_OLD_TONE;
            }
            let keep = wx_keep(pitch, fw);
            (*s).albedo = (*s).albedo * mix(WX_SLAB_MEAN, tone, keep);
            clean = clean * keep;
            // Dirt held in the joints (both directions), its mean once the joints are under a pixel.
            let la = fract(r.along / pitch);
            let lc = fract(kd / pitch);
            // each joint its own dirt (some nearly clean, some packed): the nearer joint's.
            let da = min(la, 1.0 - la);
            let dc = min(lc, 1.0 - lc);
            let fill_a = 0.25 + 0.75 * st_hash(vec2<f32>(floor(r.along / pitch + 0.5) + r.k, 7.7));
            let fill_c = 0.25 + 0.75 * st_hash(vec2<f32>(floor(kd / pitch + 0.5), 19.3));
            let j = wx_band(min(da, dc) * pitch, WX_JOINT_DIRT_M, fw) * select(fill_c, fill_a, da < dc);
            (*s).albedo = (*s).albedo * (1.0 - WX_JOINT_DARK * j);
            (*s).rough = min(1.0, (*s).rough + 0.08 * j);
        }
        // Dirt along the kerb (gutter splash, leaves, grit).
        let kb = (1.0 - smoothstep(0.0, WX_KERB_BAND_M, kd)) * mix(0.7, 0.45 + 0.55 * st_noise(world.xz / 0.9 + 4.1), wx_keep(0.9, fw));
        (*s).albedo = (*s).albedo * (1.0 - WX_KERB_BAND_DARK * kb);
    }
    if (cls == SC_FOOTWAY || cls == SC_RAMP) {
        // Blotchy stains: a warped noise thresholded inside the activity field, filtered to its mean.
        let q = world.xz;
        let warp = vec2<f32>(st_noise(q / 2.3 + 1.3), st_noise(q / 2.3 + 8.7)) - 0.5;
        let b = st_noise(q / WX_STAIN_M + warp * 1.7);
        let blot = smoothstep(0.56, 0.72, b);
        let busy = 0.25 + 0.75 * act;
        let st = mix(0.1, blot, wx_keep(WX_STAIN_M, fw)) * busy * (1.0 - 0.7 * clean);
        (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), WX_STAIN_TINT, st);
        (*s).rough = (*s).rough * (1.0 - 0.18 * st);
        // A broad mottle of soiling that reads past the stains' reach (worn, dirtier patches).
        let mot = st_noise(q / 4.7 + 2.9) * 0.6 + st_noise(q / 1.9 + 6.1) * 0.4;
        (*s).albedo = (*s).albedo * (1.0 - 0.2 * smoothstep(0.35, 0.8, mot) * busy);
        // Trodden gum.
        // gum lies in clusters (where people stood), thin between them.
        let clus = 0.2 + 0.8 * smoothstep(0.3, 0.75, st_noise(q / 1.7 + 3.3));
        let dens = clamp(WX_GUM_BASE + WX_GUM_GAIN * act, 0.0, 1.0) * clus * (1.0 - 0.75 * clean);
        var gum = wx_gum(q, fw, dens);
        if (lvl >= 2u) {
            let g2 = wx_gum(q * 1.37 + vec2<f32>(5.1, 2.3), fw * 1.37, dens * 0.6);
            gum = select(gum, g2, g2.x > gum.x);
        }
        (*s).albedo = mix((*s).albedo, vec3<f32>(mix(WX_GUM_ALBEDO, WX_GUM_ALBEDO_OLD, gum.y)), gum.x);
        (*s).rough = mix((*s).rough, WX_GUM_ROUGH, gum.x);
    }
    if (cls == SC_KERB_FACE && kd >= 0.0) {
        // Grime rising from the gutter up the face, and the arris crumbled in places.
        let rise = 1.0 - smoothstep(0.0, CC0_CURB_H * 1.15, kd);
        let nz = mix(0.75, 0.45 + 0.55 * st_noise(world.xz / 0.4 + world.y * 2.0), wx_keep(0.4, fw));
        (*s).albedo = (*s).albedo * (1.0 - WX_KERB_GRIME * rise * nz);
        (*s).rough = min(1.0, (*s).rough + 0.05 * rise);
        wx_chip(s, world, 1.0 - smoothstep(0.0, WX_CHIP_M, abs(CC0_CURB_H - kd)), fw);
    } else if (cls == SC_KERB_TOP) {
        (*s).albedo = (*s).albedo * (1.0 - 0.1 * mix(0.6, st_noise(world.xz / 0.6 + 1.1), wx_keep(0.6, fw)));
        if (kd >= 0.0) {
            wx_chip(s, world, 1.0 - smoothstep(0.0, WX_CHIP_M, kd), fw);
        }
    }
}

// Faded, chipped kerb paint inside a DK_KERB_PAINT decal (cc0_decals.rs:
// the corner daylighting's red). Returns (linear colour, cover).
fn wx_kerb_paint(world: vec3<f32>, along: f32, half_len: f32, seed: f32, fw: f32) -> vec4<f32> {
    let rnd = fract(seed);
    // Some runs repainted lately, most chalky from the sun.
    let fade = clamp(0.3 + 0.6 * rnd + (st_noise(world.xz / 2.5 + rnd * 9.0) - 0.5) * 0.5, 0.0, 1.0);
    let col = mix(WX_PAINT_RED, WX_PAINT_RED_FADED, fade);
    // Chipped to bare concrete: small flakes, more on older paint.
    let ch = st_noise(world.xz / 0.05 + world.y * 13.0 + rnd * 5.0) * 0.55 + st_noise(world.xz / 0.19 + world.y * 5.0) * 0.45;
    let lo = 0.62 - 0.22 * fade;
    let bare = smoothstep(lo, lo + 0.08, ch);
    let cover = mix(1.0 - (0.2 + 0.4 * fade), 1.0 - bare, wx_keep(0.05, fw));
    let ends = smoothstep(half_len, half_len - 0.25, abs(along));
    return vec4<f32>(col, cover * ends);
}

// ---- carriageways ----------------------------------------------------------

// The patch quilt: trench patches and repaved pieces, road-aligned
// rectangles in the kerb frame, each its own grey (fresh hot-mix darker and
// tighter, old patches lighter with exposed aggregate), their saw cuts sealed.
fn wx_quilt(s: ptr<function, Surface>, r: WxRun, kd: f32, fw: f32) {
    let pc = WX_QUILT_CELL_M;
    let ci = floor(r.along / pc);
    let x = r.along - ci * pc;
    let cell = ci + r.k;
    var mul = 1.0;
    var rough = 1.0;
    var seam = 0.0;
    for (var i = 0; i < 2; i = i + 1) {
        let hs = vec2<f32>(cell, f32(i) * 7.31 + 0.5);
        if (st_hash(hs + vec2<f32>(1.3, 7.7)) > WX_QUILT_SHARE) {
            continue;
        }
        let h1 = st_hash(hs + vec2<f32>(4.1, 2.3));
        let h2 = st_hash(hs + vec2<f32>(8.9, 5.5));
        let h3 = st_hash(hs + vec2<f32>(2.7, 9.1));
        let h4 = st_hash(hs + vec2<f32>(6.3, 3.9));
        var len = 0.8 + 0.8 * h2;
        var w = WX_KD_MAX + 1.0;
        var y0 = -0.5;
        if (h1 < 0.4) {
            // a repaved piece of a lane
            len = 7.0 + (pc - 9.0) * h2;
            w = 2.4 + 1.2 * h4;
            y0 = 0.3 + (WX_KD_MAX - w - 0.3) * h3;
        } else if (h1 < 0.78) {
            // a longitudinal utility trench
            len = 5.0 + (pc - 7.0) * h2;
            w = 0.6 + 0.5 * h4;
            y0 = 0.6 + (WX_KD_MAX - w - 0.6) * h3;
        }
        // (else a transverse trench across the half street)
        let x0 = st_hash(hs + vec2<f32>(3.3, 1.1)) * (pc - len);
        let e = min(min(x - x0, x0 + len - x), min(kd - y0, y0 + w - kd));
        if (e < -fw) {
            continue;
        }
        let inside = smoothstep(-0.5 * fw, 0.5 * fw, e);
        let fresh = st_hash(hs + vec2<f32>(5.9, 8.3)) < WX_QUILT_FRESH;
        let tone = select(mix(WX_PATCH_OLD_LO, WX_PATCH_OLD_HI, h4), mix(WX_PATCH_NEW_LO, WX_PATCH_NEW_HI, h3), fresh);
        mul = mul * mix(1.0, tone, inside);
        rough = rough * mix(1.0, select(1.06, 0.84, fresh), inside);
        seam = max(seam, wx_band(abs(e), WX_SEAM_M, fw));
    }
    (*s).albedo = (*s).albedo * mul * (1.0 - WX_SEAM_DARK * seam);
    (*s).rough = clamp((*s).rough * rough, 0.04, 1.0);
}

// Crack sealant ("tar snakes"): bands of binder along the cracks of the
// asphalt's block cracking (the edges of a jittered cell network, wiggled),
// sealed in stretches, black and faintly glossy when fresh, greying as they
// age; filtered to their cover once under a pixel.
fn wx_snakes(s: ptr<function, Surface>, world: vec3<f32>, fw: f32, dist: f32) {
    let present = smoothstep(0.3, 0.45, st_noise(world.xz / (WX_SNAKE_PERIOD_M * 2.2) + 17.0));
    let far = 1.0 - smoothstep(WX_SNAKE_FAR * 0.6, WX_SNAKE_FAR, dist);
    if (present * far <= 0.0) {
        return;
    }
    // the crack's own wiggle: a decimetre meander and a finer kink.
    let wig = (vec2<f32>(st_noise(world.xz / 0.9 + 1.9), st_noise(world.xz / 0.9 + 6.2)) - 0.5) * 0.22 + (vec2<f32>(st_noise(world.xz / 0.23 + 4.4), st_noise(world.xz / 0.23 + 8.8)) - 0.5) * 0.06;
    let p = (world.xz + wig) / WX_SNAKE_PERIOD_M;
    let base = floor(p);
    // the two nearest jittered points: their bisector is the crack (distance in metres).
    var f1 = 1e9;
    var f2 = 1e9;
    var c1 = vec2<f32>(0.0);
    var c2 = vec2<f32>(0.0);
    for (var j = -1; j <= 1; j = j + 1) {
        for (var i = -1; i <= 1; i = i + 1) {
            let c = base + vec2<f32>(f32(i), f32(j));
            let pt = c + 0.15 + 0.7 * vec2<f32>(st_hash(c + vec2<f32>(3.1, 7.3)), st_hash(c + vec2<f32>(9.7, 1.3)));
            let dd = dot(p - pt, p - pt);
            if (dd < f1) {
                f2 = f1;
                c2 = c1;
                f1 = dd;
                c1 = pt;
            } else if (dd < f2) {
                f2 = dd;
                c2 = pt;
            }
        }
    }
    let m = 0.5 * (c1 + c2);
    let n = normalize(c2 - c1 + vec2<f32>(1e-6, 0.0));
    let d = abs(dot(p - m, n)) * WX_SNAKE_PERIOD_M;
    // not every crack sealed: by the crack (the pair of cells), and broken into runs along it.
    let sealed = step(0.25, st_hash(floor(c1 * 7.0) + floor(c2 * 7.0) * 1.37 + vec2<f32>(5.5, 2.2)));
    let runs = smoothstep(0.24, 0.36, st_noise(world.xz / 2.7 + 11.0));
    let k = wx_band(d, WX_SNAKE_HALF_M * (0.75 + 0.5 * st_noise(world.xz / 0.6)), fw) * present * far * sealed * runs;
    if (k <= 0.0) {
        return;
    }
    let age = st_noise(world.xz / (WX_SNAKE_PERIOD_M * 4.7) + 5.7);
    (*s).albedo = mix((*s).albedo, vec3<f32>(mix(WX_SNAKE_ALBEDO, WX_SNAKE_ALBEDO_AGED, age)), k);
    (*s).rough = mix((*s).rough, mix(WX_SNAKE_ROUGH, WX_SNAKE_ROUGH_AGED, age), k);
}

// The carriageway, junction pads and gutter pans worn and patched.
fn wx_road(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, cls: u32, kd: f32, g: vec2<f32>, fw: f32) {
    let dist = length(rel);
    if (cls == SC_GUTTER) {
        // Grime in the pan: silt, leaves, oil washed to the kerb.
        let nz = mix(0.55, st_noise(world.xz / 1.7 + 2.2) * 0.6 + st_noise(world.xz / 0.43 + 9.9) * 0.4, wx_keep(0.43, fw));
        (*s).albedo = (*s).albedo * (1.0 - WX_GUTTER_DARK * (0.45 + 0.55 * nz));
        (*s).rough = min(1.0, (*s).rough + 0.05);
        return;
    }
    if (cls == SC_ASPHALT && kd >= 0.0 && dist < WX_QUILT_FAR) {
        let r = wx_run(rel, g, WX_QUILT_CELL_M);
        if (r.ok) {
            wx_quilt(s, r, kd, fw);
        }
    }
    if (dist < WX_SNAKE_FAR) {
        wx_snakes(s, world, fw, dist);
    }
}

// The street (draw.wgsl `street_surface`, before the wet layer).
fn wx_street(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, cls: u32, kd: f32, dpx: vec3<f32>, dpy: vec3<f32>) {
    let fw = wx_fw(dpx, dpy);
    var g = vec2<f32>(0.0);
    if (kd >= 0.0) {
        g = wx_kerb_grad();
    }
    if (cls >= SC_KERB_FACE && cls <= SC_RAMP) {
        wx_walk(s, world, rel, cls, kd, g, fw, wx_level());
    } else if (cls <= SC_PAD) {
        wx_road(s, world, rel, cls, kd, g, fw);
    }
}

// Faded, chipped marking paint (draw.wgsl, street paint): soiled, worn thin
// and flaked to bare asphalt in places, older lines more (a slow field).
fn wx_paint(s: ptr<function, Surface>, world: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let fw = wx_fw(dpx, dpy);
    let age = smoothstep(0.2, 0.8, st_noise(world.xz / 17.0 + 2.9));
    let ch = st_noise(world.xz / 0.08 + 1.7) * 0.55 + st_noise(world.xz / 0.31 + 7.1) * 0.45;
    let lo = 0.66 - 0.3 * age;
    let bare_near = smoothstep(lo, lo + 0.08, ch);
    let bare = mix(0.1 + 0.45 * age, bare_near, wx_keep(0.08, fw)) * WX_PAINT_BARE;
    (*s).albedo = mix((*s).albedo * (1.0 - 0.3 * age), CC0_ASPHALT_TINT * CC0_ASPHALT_ALBEDO, clamp(bare, 0.0, 1.0));
    (*s).rough = mix((*s).rough, 0.85, clamp(bare + 0.3 * age, 0.0, 1.0));
}

// ---- buildings --------------------------------------------------------------

// Each building its own age: a few freshly repainted, most as their wear
// says, some filthy.
fn wx_building_k(seed: f32) -> f32 {
    let h = fract(sin(seed * 12.9898 + 78.233) * 43758.5453);
    return select(select(1.0, WX_BLDG_HEAVY, h > 1.0 - WX_BLDG_HEAVY_SHARE), WX_BLDG_FRESH, h < WX_BLDG_FRESH_SHARE);
}

// A kit building's wall (facade_age.wgsl `fa_apply`, after the JS ageing):
// wash-down streaks below every sill line, soot under the roof edge and on
// the upper storeys of older buildings, splash-back at the foot, sun-faded
// paint. `top`: the wall's top (its object's height); `fw`: pixel footprint.
fn wx_facade(color: ptr<function, vec3<f32>>, rough: ptr<function, f32>, world: vec3<f32>, ng: vec3<f32>, along: f32, local_y: f32, d: FaD, cls: u32, upright: f32, top: f32, fw: f32) {
    if (upright <= 0.5 || cls == FA_AGE_ROOF) {
        return;
    }
    let bk = wx_building_k(d.seed);
    let wear = d.wear;
    let walls = cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED || cls == FA_AGE_MASONRY;
    // Wash-down streaks below the sill line above (the building's own sill rhythm).
    if (walls && d.pitch > 0.0) {
        let k = floor((local_y - d.first_sill) / d.pitch);
        let sill = d.first_sill + (k + 1.0) * d.pitch;
        let below = sill - local_y;
        let reach = d.pitch * WX_STREAK_REACH;
        if (k >= -1.0 && below > 0.0 && below < reach) {
            let cw = WX_STREAK_COL_M;
            let col = floor(along / cw);
            let hk = vec2<f32>(col, k) + d.seed * 0.37;
            let share = 0.3 + 0.45 * wear;
            let hc = st_hash(hk);
            let strength = WX_STREAK_DARK * (0.5 + 0.5 * wear) * bk;
            let len = reach * (0.45 + 0.55 * st_hash(hk + 5.3));
            let fall = (1.0 - smoothstep(0.0, len, below)) * smoothstep(0.0, 0.06, below);
            var m = 0.0;
            if (hc < share) {
                let x = along / cw - col;
                let cx = 0.5 + (st_hash(hk + 3.1) - 0.5) * 0.5;
                let wdt = 0.12 + 0.28 * st_hash(hk + 9.7);
                let fine = st_noise(vec2<f32>(along / 0.06, local_y / 0.7 + col * 3.0));
                let core = 1.0 - smoothstep(0.25, 1.0, abs(x - cx) / wdt + (fine - 0.5) * 0.6);
                m = core * fall * (0.55 + 0.45 * st_hash(hk + 7.7));
            }
            // Past a few pixels a column: the streaks' mean.
            m = mix(share * 0.45 * fall, m, wx_keep(cw * 0.25, fw)) * strength;
            let rust = st_hash(hk + 21.1) > 1.0 - WX_RUST_SHARE * wear;
            *color = *color * mix(vec3<f32>(1.0), select(WX_STREAK_TINT, WX_RUST_TINT, rust), clamp(m, 0.0, 1.0));
            *rough = *rough + 0.06 * m;
        }
    }
    // Soot and run-off under the roof edge, streaky; the upper storeys of older buildings darker.
    let dtop = top - world.y;
    let soot_reach = WX_ROOF_SOOT_M * (1.0 + wear);
    if (dtop >= 0.0 && dtop < soot_reach) {
        let drip = mix(0.6, st_noise(vec2<f32>(along / 0.4, dtop / 1.6 + d.seed)), wx_keep(0.4, fw));
        let cap = (1.0 - smoothstep(0.0, soot_reach, dtop + (drip - 0.5) * soot_reach * 0.8));
        *color = *color * (1.0 - WX_ROOF_SOOT_DARK * cap * (0.4 + 0.6 * wear) * bk);
    }
    let up = smoothstep(d.base_y + 3.0, max(top, d.base_y + 3.5), world.y);
    *color = *color * (1.0 - WX_UPPER_DARK * up * wear * wear * bk * select(0.5, 1.0, cls == FA_AGE_MASONRY));
    // Splash-back: the bottom 0.3-1 m darker and soil-tinted, its top ragged.
    let reach = mix(WX_SPLASH_LO, WX_SPLASH_HI, clamp(wear * bk, 0.0, 1.0)) * (0.75 + 0.5 * st_noise(vec2<f32>(along / 0.7, 1.7 + d.seed)));
    let blot = mix(0.6, st_noise(vec2<f32>(along / 0.18, local_y / 0.12)), wx_keep(0.18, fw));
    let sp = (1.0 - smoothstep(0.0, reach, local_y)) * (0.65 + 0.35 * blot) * step(-0.05, local_y);
    *color = *color * mix(vec3<f32>(1.0), WX_SPLASH_TINT * (1.0 - WX_SPLASH_DARK), sp * (0.45 + 0.55 * min(bk, 1.2)));
    *rough = *rough + 0.08 * sp;
    // Sun-faded paint on the walls the day's sun reaches most (lighter, less saturated).
    if (cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED) {
        let sunward = clamp(dot(normalize(ng.xz + vec2<f32>(1e-6, 0.0)), WX_SUN_AXIS), 0.0, 1.0);
        let fd = WX_SUN_FADE * sunward * clamp(d.paint * 1.2 + 0.15, 0.0, 1.0) * min(bk, 1.2);
        let l = dot(*color, vec3<f32>(0.2126, 0.7152, 0.0722));
        *color = mix(*color, vec3<f32>(l) * 1.12 + 0.02, clamp(fd, 0.0, 0.85));
    }
    // Stage W2c: the patterns that still read from a block away.
    wx_mid(color, rough, along, local_y, top - d.base_y, d, cls, bk, fw, wx_level());
}

// Stage W2c: per-building stain patterns that read at 50-200 m (weathering.rs
// PLUME_*, DAMP_*, BLOCK_*, REPAINT_*, FADE_BLOCK_*): plumes down from the roof
// edge, damp at the foot, repainted and sun-faded paint blocks. Each shape is
// metres across with an edge of at least a pixel; the fine wander of its edge
// and its streaks inside fall to their mean once under a few pixels (no
// shimmer), the shape itself stays: it is what reads from far off.
// `h_wall`: the wall's height over its floor (its object's top).
fn wx_mid(color: ptr<function, vec3<f32>>, rough: ptr<function, f32>, along: f32, local_y: f32, h_wall: f32, d: FaD, cls: u32, bk: f32, fw: f32, lvl: u32) {
    let painted = cls == FA_AGE_RENDER || cls == FA_AGE_PAINTED;
    let masonry = cls == FA_AGE_MASONRY;
    let metal = cls == FA_AGE_METAL;
    if (!(painted || masonry || metal)) {
        return;
    }
    let s = fract(d.seed * 0.618) * 97.0;
    let gain = select(1.0, 1.25, lvl >= 2u) * min(bk, 1.4);
    let wear = d.wear;
    let soft = max(fw, 0.04);
    // ---- plumes down from the roof edge (soot; rust under iron)
    if (h_wall > 2.5) {
        let pitch = mix(WX_PLUME_PITCH_LO, WX_PLUME_PITCH_HI, st_hash(vec2<f32>(s, 1.3)));
        let col = floor(along / pitch);
        let hk = vec2<f32>(col * 1.37, s + 7.1);
        if (st_hash(hk) < mix(WX_PLUME_SHARE_LO, WX_PLUME_SHARE_HI, wear) * min(bk, 1.3)) {
            let width = mix(WX_PLUME_WIDTH_LO, WX_PLUME_WIDTH_HI, st_hash(hk + 2.9));
            let cx = (col + 0.5 + (st_hash(hk + 4.3) - 0.5) * max(1.0 - width / pitch, 0.0)) * pitch;
            let reach = max(h_wall * mix(WX_PLUME_REACH_LO, WX_PLUME_REACH_HI, st_hash(hk + 6.1)), 1.0);
            let t = (h_wall - local_y) / reach;
            if (t > -0.05 && t < 1.3) {
                // it wanders as it runs down, widens and thins out; streaky inside
                let wander = (st_noise(vec2<f32>(local_y / 2.6, col * 3.1 + s)) - 0.5) * width * 0.7;
                let w = width * (0.6 + 0.5 * clamp(t, 0.0, 1.0));
                let fine = mix(0.5, st_noise(vec2<f32>(along / 0.3, local_y / 0.9 + col * 5.0)), wx_keep(0.3, fw));
                let x = abs(along - cx - wander) / w + (fine - 0.5) * 0.45;
                let core = 1.0 - smoothstep(0.3, 1.0, x);
                let fall = (1.0 - smoothstep(0.25, 1.0, t + (fine - 0.5) * 0.25)) * smoothstep(-0.05, 0.04, t);
                let runs = mix(0.75, 0.5 + 0.5 * st_noise(vec2<f32>(along / 0.22, local_y / 3.0 + col)), wx_keep(0.22, fw));
                let m = clamp(core * fall * runs * WX_PLUME_DARK * gain * (0.6 + 0.4 * st_hash(hk + 8.3)), 0.0, 0.8);
                let rust = metal || (masonry && st_hash(hk + 9.7) < 0.3) || (painted && st_hash(hk + 9.7) < 0.12);
                let tint = select(WX_PLUME_SOOT_TINT, WX_PLUME_RUST_TINT, rust);
                *color = *color * mix(vec3<f32>(1.0), tint, min(m * 1.8, 1.0)) * (1.0 - m);
                *rough = *rough + 0.05 * m;
            }
        }
    }
    // ---- damp at the foot: blotchy along the wall, a darker tide line on top
    if (painted || masonry) {
        let on = smoothstep(0.42, 0.62, st_noise(vec2<f32>(along / 2.1 + 5.3, s * 1.9)));
        let zone = st_noise(vec2<f32>(along / 3.3, s * 3.7));
        let hd = mix(WX_DAMP_LO, WX_DAMP_HI, zone * zone) * (0.5 + 0.5 * wear) * min(bk, 1.3);
        if (on > 0.0 && local_y < hd * 1.3 + 0.1) {
            // the top edge wanders along the wall only (a 1D field: no islands, no holes)
            let edge = mix(0.5, st_noise(vec2<f32>(along / 0.6, s * 3.1)), wx_keep(0.6, fw));
            let fine = mix(0.5, st_noise(vec2<f32>(along / 0.25, local_y / 0.18 + s)), wx_keep(0.25, fw));
            let top = hd * (0.86 + 0.28 * (edge - 0.5));
            let body = 1.0 - smoothstep(top - max(0.3, soft), top, local_y);
            let tide = wx_band(abs(local_y - top + 0.03), 0.035, fw) * 0.7;
            let m = clamp((body * (0.65 + 0.35 * fine) + tide) * on * WX_DAMP_DARK * gain, 0.0, 0.7);
            *color = *color * mix(vec3<f32>(1.0), WX_DAMP_TINT, min(m * 2.0, 1.0)) * (1.0 - m);
        }
    }
    // ---- paint blocks: repainted in a paint that does not quite match, or sun-faded
    if (painted) {
        let bay = mix(WX_BLOCK_BAY_LO, WX_BLOCK_BAY_HI, st_hash(vec2<f32>(s, 3.3)));
        let storey = max(d.pitch, 2.5);
        let bx = floor(along / bay);
        let by = floor(max(local_y, 0.0) / storey);
        let hb = vec2<f32>(bx * 1.91 + s, by * 2.37 + 1.7);
        let h0 = st_hash(hb);
        let ground = by < 0.5;
        let k = clamp(bk, 0.0, 1.3);
        let repaint = h0 < select(WX_REPAINT_SHARE, WX_REPAINT_GROUND_SHARE, ground) * k;
        let faded = h0 > 1.0 - WX_FADE_BLOCK_SHARE * k;
        if (repaint || faded) {
            // the block inside its cell, inset by its own amounts (a patch, not a grid);
            // a ground-floor repaint runs from the foot
            let x0 = bx * bay + bay * 0.3 * st_hash(hb + 2.2);
            let x1 = (bx + 1.0) * bay - bay * 0.3 * st_hash(hb + 3.4);
            let y0 = by * storey + select(storey * 0.35 * st_hash(hb + 4.6), -0.1, ground);
            let y1 = (by + 1.0) * storey - storey * 0.35 * st_hash(hb + 5.8);
            let rag = (mix(0.5, st_noise(vec2<f32>(along / 0.35, local_y / 0.35) + hb), wx_keep(0.35, fw)) - 0.5) * 0.12;
            let dbox = max(max(x0 - along, along - x1), max(y0 - local_y, local_y - y1)) + rag;
            let inside = 1.0 - smoothstep(-soft * 0.5, soft * 0.5, dbox);
            let l = dot(*color, vec3<f32>(0.2126, 0.7152, 0.0722));
            if (repaint) {
                let tone = 1.0 + (st_hash(hb + 7.1) - 0.5) * WX_REPAINT_SPREAD * select(1.0, 1.25, lvl >= 2u);
                let neutral = vec3<f32>(l) * select(vec3<f32>(1.05, 1.0, 0.9), vec3<f32>(0.95, 1.0, 1.05), st_hash(hb + 8.3) > 0.5);
                let c = mix(*color, neutral, WX_REPAINT_NEUTRAL) * tone;
                *color = mix(*color, c, inside);
                *rough = *rough - 0.06 * inside;
            } else {
                *color = mix(*color, vec3<f32>(l) * 1.12 + 0.03, WX_FADE_BLOCK * inside);
            }
        }
    }
}

// Stage W2c: a Blender building's wall (facade_age.wgsl, after wx_authored):
// the plumes and the damp of wx_mid, as on old masonry (its finish class is
// not known here, so no paint blocks), at a middling wear.
fn wx_mid_authored(s: ptr<function, Surface>, world: vec3<f32>, ng: vec3<f32>, base_y: f32, top: f32, seed: f32, fw: f32) {
    var d: FaD;
    d.seed = seed;
    d.wear = 0.6;
    d.paint = 0.5;
    d.coastal = 0.0;
    d.base_y = base_y;
    d.pitch = 3.6;
    d.first_sill = 0.9;
    d.origin = vec2<f32>(0.0);
    var c = (*s).albedo;
    var r = (*s).rough;
    let nl = max(length(ng.xz), 1e-4);
    wx_mid(&c, &r, dot(world.xz, vec2<f32>(-ng.z, ng.x) / nl) + seed * 7.31, world.y - base_y, top - base_y, d, FA_AGE_MASONRY, wx_building_k(seed), fw, wx_level());
    (*s).albedo = c;
    (*s).rough = clamp(r, 0.03, 1.0);
}

// A Blender building (literal weathering): its weathering graph's darkening
// deepened, and splash-back at its foot.
fn wx_authored(color: f32, local_y: f32, along: f32, seed: f32) -> vec3<f32> {
    let bk = wx_building_k(seed);
    let c = 1.0 - (1.0 - color) * (1.0 + 0.8 * bk);
    let sp = (1.0 - smoothstep(0.0, mix(WX_SPLASH_LO, WX_SPLASH_HI, 0.5) * (0.75 + 0.5 * st_noise(vec2<f32>(along / 0.7, 1.7 + seed))), local_y)) * step(-0.05, local_y);
    return vec3<f32>(clamp(c, 0.2, 1.4)) * mix(vec3<f32>(1.0), WX_SPLASH_TINT * (1.0 - WX_SPLASH_DARK), sp * 0.7);
}

// ---- windows (stage W5) ------------------------------------------------------
//
// Glass people live behind: a dirt film on the kit glass (`--grime`: haze,
// grime against the frame and in the bottom rail's tide band, run-off from the
// head, dried rain spots, the unwashed upper storeys of old buildings, hand
// grease on shop doors), chalked and peeling paint on old painted sashes and
// frames and dirt on the trim's ledges (`--grime`, from facade_age.wgsl
// `fa_apply`), stickers on shop doors and glass and tags scratched or etched
// into ground-floor panes where the wall beside them carries tags
// (`--street-life`), and through rooms.wgsl `rm_room` (`rm_w5`) plants on
// flats' sills and paper taped inside vacant shops (`--street-life`). Draw.wgsl
// calls `wx_window_life_pre` before the room and `wx_window` after it, each
// behind its level; with both levels 0 none of this is reached. Albedo,
// roughness, metalness, the glass's clearcoat and opacity; the lit room's light
// is held back by what covers the pane. Plain shapes only: nothing here draws a
// letter, a word, a number or a mark.

// A kit glass fragment's window (the rooms.rs packing, decoded as rm_kit_pane does).
struct WxPane {
    // metres from the window's lower-left corner (along the pane's tangent, up)
    local: vec2<f32>,
    // the window's width and height (m)
    size: vec2<f32>,
    // 1 where that axis locates its window (0: a frame at the packing's range,
    // or none: world-anchored 3.6 m cells, as the rooms take them)
    framed: vec2<f32>,
    shop: bool,
    office: bool,
    // the window's own hash (its corner, as the room's seed)
    seed: f32,
    // the window's bottom over the building's floor (m)
    bottom: f32,
    // the world coordinate along the front (m)
    along: f32,
};

fn wx_pane(pane: vec4<f32>, pos: vec3<f32>, ng: vec3<f32>, base_y: f32, room: u32) -> WxPane {
    var p: WxPane;
    let b = u32(round(pane.z * 255.0));
    let qw = f32(b & 127u);
    let nwq = round(pane.w * 127.0);
    p.size = vec2<f32>(qw, abs(nwq)) / 8.0;
    p.local = pane.xy * p.size;
    p.framed = vec2<f32>(1.0);
    p.shop = (b >> 7u) != 0u || room == 2u; // packed as a shop window, or shop glass (rooms.rs ROOM_SHOP)
    p.office = nwq < -0.5;
    let n = normalize(ng + vec3<f32>(0.0, 0.0, 1e-5));
    let tangent = normalize(vec3<f32>(-n.z, 0.0, n.x) + vec3<f32>(1e-5, 0.0, 0.0));
    p.along = dot(pos, tangent);
    if (qw >= 127.0 || qw < 1.0) {
        p.local.x = p.along - floor(p.along / 3.6) * 3.6;
        p.size.x = 3.6;
        p.framed.x = 0.0;
    }
    if (abs(nwq) >= 127.0 || abs(nwq) < 1.0) {
        p.local.y = pos.y - floor(pos.y / 3.6) * 3.6;
        p.size.y = 3.6;
        p.framed.y = 0.0;
    }
    let corner = pos - tangent * p.local.x - vec3<f32>(0.0, p.local.y, 0.0);
    let c = floor(corner * 2.0 + 0.5);
    p.seed = fract(sin(fract(c.x * 0.1031 + c.y * 0.11369 + c.z * 0.13787) * 311.7) * 43758.5453);
    p.bottom = pos.y - p.local.y - base_y;
    return p;
}

// A shop door's glass: a narrow, tall pane standing on the floor.
fn wx_door(p: WxPane) -> bool {
    return p.shop && p.bottom < 0.35 && p.size.x < 2.6 && p.size.y > 1.75 && p.framed.x > 0.5 && p.framed.y > 0.5;
}

// ---- the dirt film (`--grime`) ----

// The film over a pane: (cover of light dust, cover of dark grime, hand grease).
fn wx_glass_film(p: WxPane, d: FaD, fw: f32, lvl: u32) -> vec3<f32> {
    let wear = d.wear;
    let h0 = fract(p.seed * 7.13 + 0.37);
    let h1 = fract(p.seed * 13.7 + 0.11);
    // who washes it: shopkeepers often, offices and curtain walls on a contract, a vacant shop nobody
    var care = 1.0;
    if (p.shop) {
        care = select(WX_GLASS_SHOP_CARE, WX_GLASS_VACANT, wx_vacant > 0.5);
    }
    if (p.office || p.framed.x + p.framed.y < 1.5) {
        care = mix(WX_GLASS_OFFICE_CARE_LO, WX_GLASS_OFFICE_CARE_HI, wear);
    }
    // each window its own: some washed lately, some never
    let win = select(mix(WX_GLASS_SPREAD_LO, WX_GLASS_SPREAD_HI, h1), WX_GLASS_FRESH, h0 < WX_GLASS_FRESH_SHARE);
    // the upper storeys of old buildings go unwashed
    let up = smoothstep(3.0, 12.0, p.bottom) * wear;
    let amt = care * win * clamp(wx_building_k(d.seed), 0.5, 1.3) * (1.0 + WX_GLASS_UPPER * up) * select(1.0, 1.25, lvl >= 2u);
    let dirt = mix(0.15, 1.0, wear);
    let lx = p.local.x;
    let ly = p.local.y;
    // the film itself, unevenly wiped; the rain washes the middle, the dust
    // stays under the head and settles toward the bottom rail
    let mot = mix(1.0, 0.75 + 0.5 * st_noise(p.local / 0.42 + vec2<f32>(p.seed * 17.0, 3.1)), wx_keep(0.42, fw));
    let hgt = max(p.size.y, 0.3);
    let prof = mix(1.0, (1.0 + 0.45 * (1.0 - smoothstep(0.0, 0.4 * hgt, ly))) * (1.0 + 0.3 * smoothstep(0.7 * hgt, hgt, ly)) * 0.82, p.framed.y);
    var dust = mix(WX_GLASS_FILM_LO, WX_GLASS_FILM_HI, wear) * mot * prof;
    // grime packed against the frame (corners take both sides), its edge ragged
    let r = WX_GLASS_RIM_M;
    let ex = select(9.0, max(min(lx, p.size.x - lx), 0.0), p.framed.x > 0.5);
    let eb = select(9.0, max(ly, 0.0), p.framed.y > 0.5);
    let et = select(9.0, max(p.size.y - ly, 0.0), p.framed.y > 0.5);
    let rag = mix(1.0, 0.7 + 0.6 * st_noise(p.local / 0.03 + vec2<f32>(p.seed * 31.0, 7.7)), wx_keep(0.03, fw));
    let rim_exact = min(exp(-ex / r) + exp(-min(eb, et) / r), 1.4) * rag;
    let rim_mean = min(2.0 * r * (p.framed.x / max(p.size.x, 0.2) + p.framed.y / max(p.size.y, 0.2)), 1.0);
    let rim = mix(rim_mean, rim_exact, wx_keep(r, fw));
    // the bottom rail's tide band: run-off pools and dries there, a darker line at its ragged top
    let top = WX_GLASS_RAIL_M * (0.5 + st_noise(vec2<f32>(lx / 0.06, p.seed * 23.0)));
    let rail_exact = ((1.0 - smoothstep(top * 0.55, top, eb)) + 0.6 * wx_band(abs(eb - top), 0.0025, fw)) * p.framed.y;
    let rail = mix(WX_GLASS_RAIL_M / max(p.size.y, 0.2) * p.framed.y, rail_exact, wx_keep(WX_GLASS_RAIL_M, fw));
    // dirty run-off down from the head, in some columns
    let pc = WX_GLASS_RUN_PITCH_M;
    let col = floor(lx / pc);
    let run_share = WX_GLASS_RUN_SHARE * (0.5 + wear);
    var run = 0.0;
    if (p.framed.y > 0.5 && st_hash(vec2<f32>(col * 1.37 + p.seed * 91.0, 4.1)) < run_share) {
        let hk = vec2<f32>(col * 2.11 + p.seed * 53.0, 9.3);
        let cx = (col + 0.5 + (st_hash(hk) - 0.5) * 0.5) * pc;
        let wdt = 0.006 + 0.016 * st_hash(hk + 1.7);
        let len = p.size.y * (0.25 + 0.65 * st_hash(hk + 3.9));
        let wob = (st_noise(vec2<f32>(ly / 0.13, col * 3.3 + p.seed)) - 0.5) * 0.014;
        let core = 1.0 - smoothstep(wdt * 0.4, wdt, abs(lx - cx - wob));
        run = core * smoothstep(0.0, 0.04, et) * (1.0 - smoothstep(len * 0.55, len, et));
    }
    run = mix(run_share * 0.6 * 0.12, run, wx_keep(0.02, fw));
    // dried rain spots (their mineral rings): one at most per cell
    let sc = WX_GLASS_SPOT_CELL_M;
    let q = p.local + vec2<f32>(p.seed * 37.0, p.seed * 11.0);
    let cell = floor(q / sc);
    let o = vec2<f32>(st_hash(cell + vec2<f32>(3.1, 8.3)), st_hash(cell + vec2<f32>(8.7, 1.9)));
    let u = st_hash(cell + vec2<f32>(12.9, 4.4));
    let sr = WX_GLASS_SPOT_R_LO + (WX_GLASS_SPOT_R_HI - WX_GLASS_SPOT_R_LO) * u * u;
    // more spots low on the pane, where the drops run and gather
    let dens = WX_GLASS_SPOT_SHARE * (0.25 + 0.75 * wear) * (0.5 + 0.5 * (1.0 - smoothstep(0.0, max(p.size.y, 0.5), ly)) * p.framed.y + 0.25 * (1.0 - p.framed.y));
    let sd = length(q - (cell + 0.25 + 0.5 * o) * sc);
    let spot_exact = (1.0 - smoothstep(sr - 0.5 * fw, sr + 0.5 * fw, sd)) * select(0.0, 1.0, st_hash(cell + vec2<f32>(17.3, 5.9)) < dens);
    let a = WX_GLASS_SPOT_R_LO;
    let bb = WX_GLASS_SPOT_R_HI - WX_GLASS_SPOT_R_LO;
    let spot_mean = dens * 3.14159 * (a * a + 2.0 * a * bb / 3.0 + bb * bb / 5.0) / (sc * sc);
    let spot = mix(spot_mean, spot_exact, wx_keep(sc, fw));
    dust = (dust + (spot * WX_GLASS_SPOT + run * WX_GLASS_RUN) * dirt) * amt;
    let dark = (rim * WX_GLASS_RIM + rail * WX_GLASS_RAIL) * dirt * amt;
    // hand grease on a shop door: smeared blotches at hand height, near its edges and its middle
    var grease = 0.0;
    if (wx_door(p)) {
        let hy = ly + p.bottom;
        let band = smoothstep(0.75, 0.95, hy) * (1.0 - smoothstep(1.4, 1.65, hy));
        let near = max(1.0 - smoothstep(0.12, 0.4, ex), 1.0 - smoothstep(0.1, 0.3, abs(lx - p.size.x * 0.5)));
        let blot = mix(0.45, smoothstep(0.45, 0.75, st_noise(p.local / 0.05 + vec2<f32>(p.seed * 41.0, 2.2))), wx_keep(0.05, fw));
        grease = band * near * blot * WX_GLASS_GREASE;
    }
    return vec3<f32>(dust, dark, grease);
}

// The film on the pane: the dust's diffuse cover over the clean glass (the
// partial-cover model), its reflection blurred, its clearcoat and the room's
// light behind it held back, its opacity raised (a blended pane).
fn wx_glass(s: ptr<function, Surface>, m: ptr<function, Material>, p: WxPane, d: FaD, fw: f32, lvl: u32) {
    let f = wx_glass_film(p, d, fw, lvl);
    let c = clamp(f.x + f.y + f.z * 0.4, 0.0, WX_GLASS_MAX);
    if (c <= 0.0) {
        return;
    }
    let tint = mix(WX_GLASS_DUST, WX_GLASS_SOOT, clamp(f.y / max(f.x + f.y, 1e-4), 0.0, 1.0));
    (*s).albedo = mix((*s).albedo, tint, c);
    (*s).metal = (*s).metal * (1.0 - c);
    (*s).rough = min(1.0, (*s).rough + WX_GLASS_HAZE * c + f.z);
    (*s).alpha = mix((*s).alpha, 1.0, WX_GLASS_OPAQUE * c);
    (*m).emissive.w = (*m).emissive.w * (1.0 - WX_GLASS_CC_LOSS * c);
    rm_emit = rm_emit * (1.0 - WX_GLASS_TRANSMIT_LOSS * c);
}

// ---- shop glass and ground-floor panes (`--street-life`) ----

// The wall beside a ground-floor pane, from the street-life decals
// (street_life.wgsl `sl_wall`'s rules: the decal whose building line the pane
// stands near and faces): (tags, posters, 1 found, the decal's own hash).
fn wx_wall_life(world: vec3<f32>, ng: vec3<f32>) -> vec4<f32> {
    if (!cc0_on(CC0_RUN_DECALS) || length(frame.cam_pos.xyz - world) > SL_WALL_FAR_M) {
        return vec4<f32>(0.0);
    }
    let nl = length(ng.xz);
    if (nl < 0.7) {
        return vec4<f32>(0.0);
    }
    let nx = ng.xz / nl;
    let gc = sl_cell(world);
    if (!gc.ok) {
        return vec4<f32>(0.0);
    }
    var best = vec4<f32>(0.0);
    for (var k = 0u; k < 8u; k = k + 1u) {
        let idx = (gc.cell[k / 2u] >> ((k % 2u) * 16u)) & 0xffffu;
        if (idx == 0xffffu) {
            break;
        }
        let rec = (gc.slot * CC0_MAX_DECALS + idx) * 2u;
        let d1 = cc0_decals[rec + 1u];
        let kind = u32(d1.z); // an exact integer (street_life.wgsl)
        if ((kind & 255u) != SL_DK_LIFE) {
            continue;
        }
        let pr = kind >> SL_KIND_SHIFT;
        if (((pr >> 15u) & 1u) == 0u) {
            continue;
        }
        let d0 = cc0_decals[rec];
        let q = world.xz - d0.xy;
        let ax = d0.zw;
        let px = vec2<f32>(-ax.y, ax.x);
        let along = dot(q, ax);
        let across = dot(q, px);
        if (abs(along) > d1.x || abs(across) > d1.y || across < d1.y - SL_WALL_REACH_M - SL_WALL_IN_M) {
            continue;
        }
        if (abs(dot(nx, ax)) > 0.3 || dot(nx, px) > -0.7) {
            continue;
        }
        let tags = f32((pr >> 8u) & 7u);
        let posters = f32((pr >> 11u) & 7u);
        if (best.z < 0.5 || tags + posters > best.x + best.y) {
            best = vec4<f32>(tags, posters, 1.0, sl_dseed(d0));
        }
    }
    return best;
}

// Set by `wx_window_life_pre` (with `--street-life`) for the pane being drawn:
// the wall beside it (`wx_wall_life`) and whether its shop stands vacant.
var<private> wx_life: vec4<f32>;
var<private> wx_vacant: f32;

// Before the room behind a kit pane is drawn (draw.wgsl, `--street-life`):
// the wall beside a ground-floor pane, its shops' vacancy (the building's: a
// door, its storefront and their small panes agree; more on fronts pasted with
// posters), and the rooms' inputs (rooms.wgsl `rm_w5`: x on, y the building's
// wear, z 1 a vacant shop, w the share of a flat's windows with sill plants).
fn wx_window_life_pre(pane: vec4<f32>, world: vec3<f32>, ng: vec3<f32>, object: u32, room: u32) {
    let group = objects[object].lod_group;
    let d = fa_drivers(fa_ages[group]);
    let p = wx_pane(pane, world, ng, d.base_y, room);
    wx_life = vec4<f32>(0.0);
    wx_vacant = 0.0;
    if (p.bottom < 3.0) {
        wx_life = wx_wall_life(world, ng);
        if (p.shop) {
            let share = WX_VACANT_SHARE * select(1.0, WX_VACANT_POSTER_GAIN, wx_life.y >= 4.0);
            wx_vacant = select(0.0, 1.0, st_hash(vec2<f32>(f32(group % 65536u) * 0.731, f32(group / 65536u) + 4.3)) < share);
        }
    }
    rm_w5 = vec4<f32>(1.0, d.wear, wx_vacant, mix(WX_PLANT_SHARE_LO, WX_PLANT_SHARE_HI, d.wear));
}

// One sticker shape's (colour, cover): a rounded rectangle (`kind` 0), a disc
// (1), a rectangle with a coloured band across its top (2), a disc with a
// white ring (3); `c` its centre, `h` its half size, `col`/`col2` its colours.
fn wx_sticker(x: vec2<f32>, c: vec2<f32>, h: vec2<f32>, kind: i32, col: vec3<f32>, col2: vec3<f32>, soft: f32) -> vec4<f32> {
    var d = 0.0;
    if (kind == 1 || kind == 3) {
        d = length(x - c) - h.x;
    } else {
        d = sl_rbox(x, c, h, min(h.x, h.y) * 0.25);
    }
    let a = sl_cov(d, soft);
    if (a <= 0.0) {
        return vec4<f32>(0.0);
    }
    var cc = col;
    if (kind == 2) {
        cc = mix(col, col2, sl_cov(c.y + h.y * 0.62 - x.y, soft));
    } else if (kind == 3) {
        cc = mix(col, col2, sl_cov(abs(length(x - c) - h.x * 0.62) - h.x * 0.11, soft));
    }
    return vec4<f32>(cc, a);
}

// The vinyl's colour (`h` 0..1): white, black, red, blue, yellow, green, orange, light blue.
fn wx_vinyl(h: f32) -> vec3<f32> {
    if (h < 0.3) {
        return vec3<f32>(0.74, 0.74, 0.72);
    } else if (h < 0.42) {
        return vec3<f32>(0.03, 0.03, 0.035);
    } else if (h < 0.56) {
        return vec3<f32>(0.46, 0.035, 0.03);
    } else if (h < 0.7) {
        return vec3<f32>(0.02, 0.07, 0.34);
    } else if (h < 0.8) {
        return vec3<f32>(0.76, 0.55, 0.03);
    } else if (h < 0.88) {
        return vec3<f32>(0.03, 0.28, 0.08);
    } else if (h < 0.94) {
        return vec3<f32>(0.8, 0.24, 0.02);
    }
    return vec3<f32>(0.2, 0.45, 0.75);
}

// Stickers on a shop's glass (`p.shop`), as (colour, cover); `x` along the
// pane, `y` over the floor. A door: at one edge (or the middle of a double
// door) from hand to eye height an opening-hours plate (a white field under a
// coloured band), a row of card marks, a round one, and an alarm firm's square
// near its foot. Another shop pane: one or two small ones in a lower corner.
// Plain shapes and colour fields, each faded by its own age.
fn wx_stickers(p: WxPane, fw: f32) -> vec4<f32> {
    let x = p.local.x;
    let y = p.local.y + p.bottom;
    let hs = fract(p.seed * 71.3 + 0.13);
    let soft = max(fw, 0.0008);
    var res = vec4<f32>(0.0);
    if (wx_door(p)) {
        if (hs > WX_STICKER_DOOR_SHARE) {
            return res;
        }
        let h2 = fract(hs * 7.31 + 0.2);
        // the column's edge (the lock side), or a double door's meeting stiles
        let mid = p.size.x > 1.4 && h2 < 0.5;
        let right = fract(hs * 3.7) > 0.5;
        let cx = select(select(0.11 + 0.05 * h2, p.size.x - 0.11 - 0.05 * h2, right), p.size.x * 0.5 + select(-0.13, 0.13, right), mid);
        let inward = select(select(1.0, -1.0, right), select(-1.0, 1.0, right), mid);
        // opening hours: a white plate under a coloured band
        if (fract(hs * 5.3) < 0.7) {
            let st = wx_sticker(vec2<f32>(x, y), vec2<f32>(cx + inward * 0.03, 1.42 + 0.08 * h2), vec2<f32>(0.075, 0.1), 2, vec3<f32>(0.74, 0.74, 0.72), wx_vinyl(fract(hs * 11.1) * 0.7 + 0.3), soft);
            res = sl_ov(res, st.rgb, st.a);
        }
        // a row of card marks
        if (fract(hs * 9.7) < 0.8) {
            let n = 2 + i32(fract(hs * 13.3) * 3.99);
            let row_y = 1.12 + 0.06 * fract(hs * 2.9);
            for (var i = 0; i < 5; i = i + 1) {
                if (i >= n) {
                    break;
                }
                let hi = fract(hs * 17.1 + f32(i) * 0.371);
                let c = vec2<f32>(cx - inward * 0.02 + inward * (f32(i) * 0.072 + 0.03), row_y);
                let st = wx_sticker(vec2<f32>(x, y), c, vec2<f32>(0.032, 0.021), select(0, 2, hi > 0.6), wx_vinyl(hi), wx_vinyl(fract(hi * 5.7)), soft);
                res = sl_ov(res, st.rgb, st.a);
            }
        }
        // a round one over the plate
        if (fract(hs * 19.9) < 0.45) {
            let st = wx_sticker(vec2<f32>(x, y), vec2<f32>(cx + inward * 0.05, 1.66), vec2<f32>(0.04, 0.04), 3, wx_vinyl(fract(hs * 23.3)), vec3<f32>(0.74, 0.74, 0.72), soft);
            res = sl_ov(res, st.rgb, st.a);
        }
        // an alarm firm's square near the foot
        if (fract(hs * 29.3) < 0.55) {
            let st = wx_sticker(vec2<f32>(x, y), vec2<f32>(cx, 0.32 + 0.1 * h2), vec2<f32>(0.05, 0.05), 0, wx_vinyl(0.56 + 0.2 * fract(hs * 31.7)), vec3<f32>(0.74), soft);
            res = sl_ov(res, st.rgb, st.a);
            let inner = wx_sticker(vec2<f32>(x, y), vec2<f32>(cx, 0.32 + 0.1 * h2), vec2<f32>(0.022, 0.022), 1, vec3<f32>(0.74, 0.74, 0.72), vec3<f32>(0.0), soft);
            res = vec4<f32>(mix(res.rgb, inner.rgb, inner.a * step(0.01, res.a)), res.a);
        }
    } else if (p.bottom < 1.2) {
        if (hs > WX_STICKER_PANE_SHARE) {
            return res;
        }
        let right = fract(hs * 3.7) > 0.5;
        let cx = select(0.09, p.size.x - 0.09, right);
        let inward = select(1.0, -1.0, right);
        let y0 = p.bottom + 0.12 + 0.25 * fract(hs * 5.9);
        let n = 1 + i32(fract(hs * 13.3) * 1.99);
        for (var i = 0; i < 2; i = i + 1) {
            if (i >= n) {
                break;
            }
            let hi = fract(hs * 17.1 + f32(i) * 0.371);
            let st = wx_sticker(vec2<f32>(x, y), vec2<f32>(cx + inward * f32(i) * 0.1, y0), vec2<f32>(0.04, 0.03), select(0, 2, hi > 0.5), wx_vinyl(hi), wx_vinyl(fract(hi * 3.3)), soft);
            res = sl_ov(res, st.rgb, st.a);
        }
    }
    if (res.a > 0.0) {
        // sun-faded by its age
        let age = fract(hs * 41.7);
        let l = dot(res.rgb, vec3<f32>(0.2126, 0.7152, 0.0722));
        res = vec4<f32>(mix(res.rgb, vec3<f32>(l) * 1.1 + 0.04, 0.5 * age * age), res.a);
    }
    return res;
}

// A scratched tag's line cover at `q` (metres from its box's lower-left
// corner, the box `size`): two jagged scrawls over each other (a stone or a
// key dragged back and forth), each through seven points that wander across
// the box and double back. A tangle, not handwriting: no glyph, no letter, no
// ring (a stroke beside a ring read as a digit pair in the sheet of samples). The line `w` wide, filtered to its area
// under a pixel.
fn wx_scrawl(q: vec2<f32>, size: vec2<f32>, hs: f32, w: f32, fw: f32) -> f32 {
    if (q.x < -0.03 || q.y < -0.03 || q.x > size.x + 0.03 || q.y > size.y + 0.03) {
        return 0.0;
    }
    var dmin = 1e9;
    for (var k = 0; k < 2; k = k + 1) {
        var prev = vec2<f32>(0.0);
        for (var i = 0; i < 7; i = i + 1) {
            let hx = st_hash(vec2<f32>(f32(i) * 1.37 + f32(k) * 9.1, hs * 71.0));
            let hy = st_hash(vec2<f32>(f32(i) * 2.11 + f32(k) * 5.3, hs * 37.0));
            let pt = vec2<f32>((f32(i) + 0.5 + (hx - 0.5) * 2.2) / 7.0, 0.05 + 0.9 * hy) * size;
            if (i > 0) {
                dmin = min(dmin, sl_seg(q, prev, pt));
            }
            prev = pt;
        }
    }
    return wx_band(dmin, w * 0.5, fw);
}

// Tags scratched (hairlines) or acid-etched (frosted strokes) into a
// ground-floor pane, one cell of 0.9 m at a time, more where the wall beside
// it carries more tags (`tags`, 0..7): (cover, 1 if etched).
fn wx_scratches(p: WxPane, tags: f32, fw: f32, lvl: u32) -> vec2<f32> {
    let cw = 0.9;
    let x = p.local.x;
    let y = p.local.y + p.bottom;
    let k = floor(x / cw);
    let wc = min(cw, p.size.x - k * cw);
    let chance = WX_SCRATCH_PER_TAG * tags * select(1.0, 1.35, lvl >= 2u);
    if (wc < 0.3 || st_hash(vec2<f32>(k * 2.31 + p.seed * 113.0, 6.7)) > chance) {
        return vec2<f32>(0.0);
    }
    let hs = st_hash(vec2<f32>(k * 1.71 + p.seed * 57.0, 2.3));
    let etched = hs > 0.62;
    let w = select(mix(WX_SCRATCH_W_LO, WX_SCRATCH_W_HI, fract(hs * 7.7)), mix(WX_ETCH_W_LO, WX_ETCH_W_HI, fract(hs * 7.7)), etched);
    // the box: 0.2-0.5 m wide, at hand to eye height, inside the pane (nothing cut at its frame)
    let ylo = max(p.bottom + 0.06, 0.85);
    let yhi = min(p.bottom + p.size.y - 0.06, 1.85);
    let size = vec2<f32>(min(0.16 + 0.32 * fract(hs * 3.3), wc - 0.1), min(0.08 + 0.2 * fract(hs * 5.9), yhi - ylo));
    if (size.x < 0.1 || size.y < 0.06) {
        return vec2<f32>(0.0);
    }
    let o = vec2<f32>(k * cw + 0.05 + (wc - 0.1 - size.x) * fract(hs * 11.3), ylo + (yhi - ylo - size.y) * fract(hs * 13.7));
    let a = wx_scrawl(vec2<f32>(x, y) - o, size, hs, w, fw);
    // a scratch's line is broken where the stone skipped
    let skip = select(mix(0.75, smoothstep(0.25, 0.4, st_noise(vec2<f32>(x, y) / 0.012 + hs * 9.0)), wx_keep(0.012, fw)), 1.0, etched);
    return vec2<f32>(a * skip * select(0.85, 0.95, etched), select(0.0, 1.0, etched));
}

// Stickers and scratched tags on a kit pane (`--street-life`).
fn wx_glass_life(s: ptr<function, Surface>, m: ptr<function, Material>, p: WxPane, world: vec3<f32>, fw: f32, lvl: u32) {
    if (p.bottom > 2.6 || p.framed.x + p.framed.y < 1.5) {
        return;
    }
    if (p.shop && p.bottom < 1.2) {
        let st = wx_stickers(p, fw);
        if (st.a > 0.0) {
            // vinyl: opaque, satin; it holds the room's light back
            (*s).albedo = mix((*s).albedo, st.rgb, st.a);
            (*s).metal = (*s).metal * (1.0 - st.a);
            (*s).rough = mix((*s).rough, 0.42, st.a);
            (*s).alpha = mix((*s).alpha, 1.0, st.a);
            (*m).emissive.w = (*m).emissive.w * (1.0 - 0.5 * st.a);
            rm_emit = rm_emit * (1.0 - 0.9 * st.a);
        }
    }
    if (wx_life.x > 0.0 && length(frame.cam_pos.xyz - world) < 60.0) {
        let sc = wx_scratches(p, wx_life.x, fw, lvl);
        if (sc.x > 0.0) {
            // the scratched or frosted glass scatters: a pale, matte line with no mirror in it
            let col = select(vec3<f32>(0.4, 0.41, 0.41), vec3<f32>(0.5, 0.52, 0.52), sc.y > 0.5);
            (*s).albedo = mix((*s).albedo, col, sc.x);
            (*s).metal = (*s).metal * (1.0 - sc.x);
            (*s).rough = mix((*s).rough, 0.8, sc.x);
            (*s).alpha = mix((*s).alpha, 1.0, 0.8 * sc.x);
            (*m).emissive.w = (*m).emissive.w * (1.0 - 0.85 * sc.x);
            rm_emit = rm_emit * (1.0 - 0.4 * sc.x);
        }
    }
}

// After the room behind a kit pane is drawn (draw.wgsl, `--grime` or
// `--street-life`): what is on the glass (stickers, scratched tags) and the
// dirt film over all of it.
fn wx_window(s: ptr<function, Surface>, m: ptr<function, Material>, pane: vec4<f32>, world: vec3<f32>, ng: vec3<f32>, object: u32, room: u32, dpx: vec3<f32>, dpy: vec3<f32>) {
    rm_w5 = vec4<f32>(0.0);
    let d = fa_drivers(fa_ages[objects[object].lod_group]);
    let p = wx_pane(pane, world, ng, d.base_y, room);
    let fw = wx_fw(dpx, dpy);
    if (sl_level() != 0u) {
        wx_glass_life(s, m, p, world, fw, sl_level());
    }
    if (wx_level() != 0u) {
        wx_glass(s, m, p, d, fw, wx_level());
    }
}

// ---- old sashes, frames and sills (`--grime`, facade_age.wgsl `fa_apply`) ----

// The trim finishes (`di`: the material's detail index): on a ledge's top dirt
// and droppings, on its underside a dark drip line; on old painted sashes and
// frames (`painted-white`) the paint chalked by its age and, once old,
// alligatored and peeling to grey wood or an older coat, more low on each
// storey where water stands. `along`/`local_y` the wall frame of fa_apply.
fn wx_window_trim(color: ptr<function, vec3<f32>>, rough: ptr<function, f32>, world: vec3<f32>, ng: vec3<f32>, local_y: f32, d: FaD, di: u32, fw: f32) {
    if (di == 0u || local_y < 0.3 || !(di == WX_DI_PAINTED_WHITE || di == WX_DI_TRIM || di == WX_DI_CAST_STONE)) {
        return;
    }
    let bk = min(wx_building_k(d.seed), 1.4);
    let wear = d.wear;
    if (ng.y > 0.45) {
        // a ledge's top: dirt, soot and droppings settle, blotchy
        let nz = mix(0.6, st_noise(world.xz / 0.09 + world.y * 3.0) * 0.6 + st_noise(world.xz / 0.31 + 5.0) * 0.4, wx_keep(0.09, fw));
        let k = clamp((0.3 + 0.7 * wear) * bk * (0.5 + 0.6 * nz), 0.0, 1.0);
        *color = *color * mix(vec3<f32>(1.0), WX_LEDGE_TINT * (1.0 - WX_LEDGE_DARK), k);
        *rough = *rough + 0.1 * k;
    } else if (ng.y < -0.45) {
        // the underside's drip edge: run-off hangs there and leaves its grime
        let nz = mix(0.7, st_noise(world.xz / 0.12 + 1.3), wx_keep(0.12, fw));
        *color = *color * (1.0 - WX_DRIP_DARK * (0.35 + 0.65 * wear) * bk * (0.6 + 0.4 * nz));
    }
    // old sashes, frames and trim are white or pale; a saturated board of the
    // same finish is a sign face (eo-kit clutter.rs: weathered by its own stage)
    let hi = max(max((*color).r, (*color).g), (*color).b);
    let lo = min(min((*color).r, (*color).g), (*color).b);
    if (di != WX_DI_PAINTED_WHITE || hi - lo > 0.3 * hi) {
        return;
    }
    let age = d.paint;
    // chalking: the binder weathers to a flat, greyer powder
    let ch = WX_CHALK * smoothstep(0.1, 0.8, age) * bk;
    let l = dot(*color, vec3<f32>(0.2126, 0.7152, 0.0722));
    *color = mix(*color, vec3<f32>(l) * 0.9 + 0.02, ch);
    *rough = *rough + 0.3 * ch;
    let peel = smoothstep(WX_PEEL_FROM, 1.0, age) * (0.5 + 0.5 * wear) * bk;
    if (peel <= 0.0) {
        return;
    }
    // the face's own frame (fa_frame: along it and up it), in alligator cells
    let fr = fa_frame(ng);
    let uv = vec2<f32>(dot(world, fr.t), dot(world, fr.b));
    // more low on each storey (the bottom rail and the sill, where water stands), and in patches
    let in_storey = fract((local_y - d.first_sill + 0.4) / max(d.pitch, 2.5)) * max(d.pitch, 2.5);
    let low = 1.0 - smoothstep(0.2, 1.4, in_storey);
    let patches = smoothstep(0.3, 0.72, st_noise(uv / 0.38 + d.seed * 3.1));
    let prob = clamp(WX_PEEL_MAX * peel * patches * (0.55 + 0.9 * low), 0.0, 0.9);
    let keep = wx_keep(WX_PEEL_CELL_M, fw);
    var lost = prob;
    var crack = 0.0;
    var under = 0.5;
    if (keep > 0.0) {
        // jittered cells: the nearest two points (the cracks run between them)
        let q = uv / WX_PEEL_CELL_M;
        let base = floor(q);
        var f1 = 9.0;
        var f2 = 9.0;
        var id = vec2<f32>(0.0);
        for (var j = -1; j <= 1; j = j + 1) {
            for (var i = -1; i <= 1; i = i + 1) {
                let c = base + vec2<f32>(f32(i), f32(j));
                let pt = c + 0.1 + 0.8 * vec2<f32>(st_hash(c + vec2<f32>(2.3, 7.9)), st_hash(c + vec2<f32>(6.1, 1.7)));
                let dd = length(q - pt);
                if (dd < f1) {
                    f2 = f1;
                    f1 = dd;
                    id = c;
                } else if (dd < f2) {
                    f2 = dd;
                }
            }
        }
        // flakes go in clusters (a failed patch lifts together), each cell its own edge
        let cl = st_noise(id * WX_PEEL_CELL_M / 0.16 + d.seed * 1.7);
        let gone = select(0.0, 1.0, cl * 0.85 + st_hash(id + vec2<f32>(9.3, 4.1)) * 0.15 > 1.0 - prob * 0.8);
        lost = mix(prob, gone, keep);
        // the paint's crazing round the flakes (only where it is about to go)
        crack = (1.0 - smoothstep(0.0, 0.06 + fw / WX_PEEL_CELL_M, f2 - f1)) * keep * smoothstep(0.55, 0.85, cl) * clamp(peel * 1.5, 0.0, 1.0);
        under = st_hash(id + vec2<f32>(1.1, 8.8));
    }
    // bare weathered wood, or an older coat showing
    let bare = mix(WX_PEEL_WOOD, WX_PEEL_UNDERCOAT, step(0.65, under) * keep);
    *color = mix(*color, bare, lost) * (1.0 - 0.3 * crack);
    *rough = mix(*rough, 0.88, lost) + 0.1 * crack;
}

// ---- behind the glass (`--street-life`, rooms.wgsl `rm_room`) ----

// One sill plant at `q` (metres from its pot's foot on the sill, x along, y
// up), its seed `s`, the pixel footprint `fp`: (albedo, cover) and its leaf
// share (`leaf`: the share of the cover that is leaf, for the light through
// it). A pot (terracotta, white or blue glazed, dark plastic) and a bushy
// clump, a flowering one, a spray of long upright leaves, or a column cactus.
fn wx_plant(q: vec2<f32>, s: f32, fp: f32, leaf: ptr<function, f32>) -> vec4<f32> {
    let h0 = rm_h(s, 1.0);
    let h1 = rm_h(s, 2.0);
    let h2 = rm_h(s, 3.0);
    let ph = 0.09 + 0.1 * h0;
    let tw = 0.06 + 0.06 * h1;
    let bw = tw * 0.72;
    let soft = max(fp, 0.0015);
    *leaf = 0.0;
    if (abs(q.x) > tw * 4.0 + 0.1 || q.y < -0.01 || q.y > ph + 0.7) {
        return vec4<f32>(0.0);
    }
    // the pot: a tapered body and a rim
    let hw = mix(bw, tw, clamp(q.y / ph, 0.0, 1.0));
    let body = max(abs(q.x) - hw, max(-q.y, q.y - ph));
    let rim = max(abs(q.x) - tw - 0.006, abs(q.y - ph + 0.008) - 0.012);
    let pot_d = min(body, rim);
    var pot_col = WX_POT_TERRACOTTA;
    if (h2 > 0.88) {
        pot_col = vec3<f32>(0.03, 0.03, 0.032);
    } else if (h2 > 0.75) {
        pot_col = vec3<f32>(0.05, 0.12, 0.32);
    } else if (h2 > 0.55) {
        pot_col = vec3<f32>(0.68, 0.67, 0.64);
    }
    // round: darker toward its sides
    pot_col = pot_col * (1.0 - 0.35 * clamp(q.x / max(hw, 1e-3), -1.0, 1.0) * clamp(q.x / max(hw, 1e-3), -1.0, 1.0));
    let pot_a = sl_cov(pot_d, soft);
    // the foliage, standing on the pot's top
    let t = rm_h(s, 4.0);
    let fq = q - vec2<f32>(0.0, ph);
    var fd = 9.0;
    var flowers = 0.0;
    var lc = WX_LEAF_ALBEDO * (0.7 + 0.6 * rm_h(s, 5.0));
    if (t < 0.6) {
        // a clump of leaves (some flowering): overlapping lobes in a dome, their edge leafy
        let rr = tw * (1.4 + 1.3 * rm_h(s, 6.0));
        for (var i = 0; i < 6; i = i + 1) {
            let a = rm_h(s + f32(i) * 0.113, 7.0);
            let b = rm_h(s + f32(i) * 0.113, 8.0);
            let c = vec2<f32>((a - 0.5) * 1.5 * rr, rr * (0.35 + 0.75 * b));
            let r = rr * (0.38 + 0.25 * rm_h(s + f32(i) * 0.113, 9.0));
            fd = min(fd, length(fq - c) - r);
        }
        let edge = mix(0.5, st_noise(fq / 0.018 + vec2<f32>(s * 19.0, 3.3)), sl_keep(0.018, fp));
        fd = fd + (edge - 0.5) * 0.022;
        if (t < 0.22) {
            // flowers on its upper part: red, pink, white or yellow
            let fc = floor(fq / 0.03);
            let fo = vec2<f32>(st_hash(fc + s * 7.0), st_hash(fc + s * 11.0 + 3.1));
            let fl = length(fq - (fc + 0.2 + 0.6 * fo) * 0.03) - 0.007;
            flowers = sl_cov(fl, soft) * step(st_hash(fc + s * 13.0 + 5.7), 0.45) * smoothstep(rr * 0.4, rr * 1.0, fq.y) * sl_keep(0.03, fp);
        }
    } else if (t < 0.87) {
        // a spray of long upright leaves (a snake plant, an aloe), leaning out
        let n = 4 + i32(rm_h(s, 10.0) * 3.99);
        for (var i = 0; i < 7; i = i + 1) {
            if (i >= n) {
                break;
            }
            let a = rm_h(s + f32(i) * 0.171, 11.0);
            let b = rm_h(s + f32(i) * 0.171, 12.0);
            let x0 = (a - 0.5) * tw * 1.2;
            let len = 0.2 + 0.38 * b * (0.6 + 0.4 * h0);
            let tip = vec2<f32>(x0 + (a - 0.5) * len * 0.8, len);
            let ab = tip - vec2<f32>(x0, 0.0);
            let tt = clamp(dot(fq - vec2<f32>(x0, 0.0), ab) / dot(ab, ab), 0.0, 1.0);
            let wd = (0.008 + 0.012 * rm_h(s + f32(i) * 0.171, 13.0)) * (1.0 - tt * 0.9);
            fd = min(fd, length(fq - vec2<f32>(x0, 0.0) - ab * tt) - wd);
        }
        lc = lc * vec3<f32>(1.0, 1.05, 0.9);
    } else {
        // a column cactus, ribbed
        let cw = 0.025 + 0.02 * rm_h(s, 14.0);
        let ch = 0.14 + 0.24 * rm_h(s, 15.0);
        fd = length(vec2<f32>(fq.x, max(fq.y - (ch - cw), 0.0) + min(fq.y, 0.0))) - cw;
        let rib = mix(1.0, 0.8 + 0.2 * abs(sin(fq.x / max(cw, 1e-3) * 7.0)), sl_keep(0.01, fp));
        lc = vec3<f32>(0.05, 0.1, 0.06) * rib;
    }
    // lit from the window: the tops brighter, the clump's inside darker
    let shade = 0.75 + 0.35 * smoothstep(-0.02, 0.25, fq.y) + 0.2 * (mix(0.5, st_noise(fq / 0.025 + s * 5.0), sl_keep(0.025, fp)) - 0.5);
    let leaf_a = sl_cov(fd, soft);
    let fcol = mix(vec3<f32>(0.6, 0.04, 0.05), vec3<f32>(0.72, 0.6, 0.62), step(0.5, rm_h(s, 16.0)));
    let leaf_col = mix(lc * shade, fcol, flowers);
    // the pot in front of the stems: over the leaves where both
    var out = vec4<f32>(leaf_col, leaf_a);
    out = vec4<f32>(mix(out.rgb, pot_col, pot_a), max(out.a, pot_a));
    *leaf = leaf_a * (1.0 - pot_a) / max(out.a, 1e-4);
    return out;
}

// What a stage W5 room shows at the glass (rm_room's hook, `rm_w5.x` on): on a
// flat's sill (a home's window, its bottom cell) up to three potted plants
// standing a little behind the glass (seen in parallax: from the street below
// the frame's rail hides the pots and the leaves show over it; by night dark
// against the lit room, the leaves letting a little green light through), or a
// vacant shop's dark empty room behind paper and board taped inside its glass.
// `local`, `size`: the window's (not the room cell's); `seed` the window's;
// `pix` the pixel angle; `dist` the eye's distance.
fn wx_room_life(o: ptr<function, RmOut>, local: vec2<f32>, size: vec2<f32>, dir: vec3<f32>, seed: f32, shop: f32, office: f32, pix: f32, dist: f32) {
    if (shop > 0.5) {
        if (rm_w5.z > 0.5) {
            wx_vacant_shop(o, local, size, seed, pix, dist);
        }
        return;
    }
    if (office > 0.5 || size.y < 0.6 || dist > 150.0 || rm_h(seed, 90.0) > rm_w5.w) {
        return;
    }
    let into = max(dir.z, 0.05);
    let n = 1 + i32(rm_h(seed, 91.0) * 2.99);
    var acc = vec4<f32>(0.0);
    var acc_leaf = 0.0;
    var acc_z = 9.0;
    for (var i = 0; i < 3; i = i + 1) {
        if (i >= n) {
            break;
        }
        let si = fract(seed + f32(i) * 0.1373);
        let z = 0.05 + 0.12 * rm_h(si, 93.0);
        // the ray at the plant's depth; the pot's foot on the sill, a frame rail below the glass
        let q = local + dir.xy / into * z;
        let cx = size.x * (f32(i) + 0.5 + (rm_h(si, 92.0) - 0.5) * 0.6) / f32(n);
        var lf = 0.0;
        let pl = wx_plant(q - vec2<f32>(cx, -0.045), si, max((dist + z / into) * pix, 0.0015), &lf);
        if (pl.a <= 0.0) {
            continue;
        }
        if (z < acc_z) {
            // nearer: over what is there
            acc_leaf = mix(acc_leaf * acc.a, lf, pl.a) / max(pl.a + acc.a * (1.0 - pl.a), 1e-4);
            acc = sl_ov(acc, pl.rgb, pl.a);
            acc_z = z;
        } else {
            let back = sl_ov(vec4<f32>(0.0), pl.rgb, pl.a);
            let a = acc.a + back.a * (1.0 - acc.a);
            acc_leaf = (acc_leaf * acc.a + lf * back.a * (1.0 - acc.a)) / max(a, 1e-4);
            acc = vec4<f32>((acc.rgb * acc.a + back.rgb * back.a * (1.0 - acc.a)) / max(a, 1e-5), a);
        }
    }
    let cov = acc.a * (1.0 - smoothstep(80.0, 150.0, dist));
    if (cov <= 0.0) {
        return;
    }
    // by day lit through the window, as the curtains at the glass; by night the lit room behind
    (*o).day = vec4<f32>(mix((*o).day.rgb, acc.rgb * 0.62 * RM_DAY_THROUGH, cov), (*o).day.w);
    (*o).night = mix((*o).night, (*o).night * WX_LEAF_TRANSMIT * acc_leaf, cov);
}

// A vacant shop: no light, an emptied room, and on the inside of its glass
// paper or board: kraft paper hung in lengths over all of it, newspaper
// sheets, white sheets over its lower part, board pieces, or the glass soaped
// over in swirls. Tape at the corners, sheets missing, a corner torn. Plain
// fields with a little tone; nothing printed reads.
fn wx_vacant_shop(o: ptr<function, RmOut>, local: vec2<f32>, size: vec2<f32>, seed: f32, pix: f32, dist: f32) {
    (*o).night = vec3<f32>(0.0);
    let fp = max(dist * pix, 0.0015);
    let x = local.x;
    let y = local.y;
    let style = rm_h(seed, 110.0);
    var paper = vec4<f32>(0.0);
    if (style < 0.28) {
        // kraft paper in 0.9 m lengths, wrinkled, a tear low in one
        let k = floor(x / 0.9);
        let hk = rm_h(seed + k * 0.131, 111.0);
        let wr = mix(1.0, 0.86 + 0.28 * (st_noise(vec2<f32>(x + y * 0.6, y - x * 0.5) / 0.21 + k * 7.0) * 0.7 + st_noise(vec2<f32>(x, y) / 0.07 + k * 3.0) * 0.3), sl_keep(0.1, fp));
        var c = WX_PAPER_KRAFT * (0.85 + 0.3 * hk) * wr;
        // the overlap at each length's edge
        c = c * (1.0 - 0.18 * sl_cov(abs(x - k * 0.9 - 0.012) - 0.012, fp));
        var a = 1.0;
        if (hk > 0.7) {
            let tc = vec2<f32>(k * 0.9 + 0.45, 0.3 + 0.5 * rm_h(seed + k * 0.131, 112.0));
            let tear = length((vec2<f32>(x, y) - tc) / vec2<f32>(0.12, 0.2)) - 1.0 + (st_noise(vec2<f32>(x, y) / 0.03) - 0.5) * 0.5;
            a = 1.0 - sl_cov(tear * 0.1, fp);
        }
        paper = vec4<f32>(c, a);
    } else if (style < 0.5) {
        // newspaper sheets in a loose grid, some gone, yellowed, a grey photo block on some
        let sz = vec2<f32>(0.42, 0.58);
        // rows laid like bricks, each a little off the last
        let row = floor(y / sz.y);
        let xs = x + sz.x * (0.5 * (row - 2.0 * floor(row * 0.5)) + 0.15 * rm_h(seed + row * 0.37, 121.0));
        let g = vec2<f32>(floor(xs / sz.x), row);
        let hk = rm_h(seed + g.x * 0.173 + g.y * 0.311, 113.0);
        let lp = vec2<f32>(xs, y) - g * sz;
        let inside = sl_cov(max(abs(lp.x - sz.x * 0.5) - sz.x * 0.48, abs(lp.y - sz.y * 0.5) - sz.y * 0.48), fp);
        var c = WX_PAPER_NEWS * mix(vec3<f32>(1.0), vec3<f32>(1.05, 1.0, 0.82), rm_h(seed + hk, 114.0));
        let photo = sl_cov(sl_rbox(lp, sz * vec2<f32>(0.3 + 0.4 * hk, 0.35 + 0.3 * fract(hk * 7.0)), sz * vec2<f32>(0.18, 0.12), 0.0), fp);
        c = mix(c, c * 0.45, photo * step(0.4, hk));
        paper = vec4<f32>(c, inside * step(0.12, hk));
    } else if (style < 0.72) {
        // white sheets over the lower part, up to 1.4-2 m, some missing, a corner peeled off
        let sz = vec2<f32>(0.6, 0.86);
        let row = floor(y / sz.y);
        let xs = x + sz.x * (0.5 * (row - 2.0 * floor(row * 0.5)) + 0.2 * rm_h(seed + row * 0.41, 122.0));
        let g = vec2<f32>(floor(xs / sz.x), row);
        let hk = rm_h(seed + g.x * 0.173 + g.y * 0.311, 115.0);
        let lp = vec2<f32>(xs, y) - g * sz;
        let top = 1.4 + 0.6 * rm_h(seed, 116.0);
        var inside = sl_cov(max(abs(lp.x - sz.x * 0.5) - sz.x * 0.47, abs(lp.y - sz.y * 0.5) - sz.y * 0.47), fp);
        // a peeled corner: the sheet's top corner folded away
        inside = inside * (1.0 - step(0.75, hk) * sl_cov(sz.x * 0.2 - (sz.x - lp.x) - (sz.y - lp.y), fp));
        let c = WX_PAPER_WHITE * (0.9 + 0.12 * hk);
        paper = vec4<f32>(c, inside * step(0.1, hk) * (1.0 - sl_cov(y - top, fp)));
    } else if (style < 0.86) {
        // board: pieces of corrugated box over the lower half
        let sz = vec2<f32>(0.7 + 0.3 * rm_h(seed, 117.0), 0.55);
        let g = floor(vec2<f32>(x + y * 0.13, y) / sz);
        let hk = rm_h(seed + g.x * 0.173 + g.y * 0.311, 118.0);
        let lp = vec2<f32>(x + y * 0.13, y) - g * sz;
        let inside = sl_cov(max(abs(lp.x - sz.x * 0.5) - sz.x * (0.44 + 0.06 * hk), abs(lp.y - sz.y * 0.5) - sz.y * 0.46), fp);
        paper = vec4<f32>(WX_BOARD * (0.8 + 0.35 * hk), inside * step(0.15, hk) * (1.0 - sl_cov(y - 1.3 - 0.5 * rm_h(seed, 119.0), fp)));
    } else {
        // soaped over: whiting wiped on by hand, circling wipes of every size
        // over each other (the nearest of jittered wipe centres), thick and thin
        // across the pane, a few patches nearly clear
        let cs = 0.55;
        let q = vec2<f32>(x, y) / cs;
        let base = floor(q);
        var best = 9.0;
        var lp = vec2<f32>(0.0);
        var hk = 0.0;
        for (var j = -1; j <= 1; j = j + 1) {
            for (var i = -1; i <= 1; i = i + 1) {
                let c = base + vec2<f32>(f32(i), f32(j));
                let ctr = c + 0.15 + 0.7 * vec2<f32>(rm_h(seed + c.x * 0.173 + c.y * 0.311, 123.0), rm_h(seed + c.x * 0.291 + c.y * 0.137, 124.0));
                let dd = length(q - ctr) * (0.7 + 0.6 * rm_h(seed + c.x * 0.53 + c.y * 0.71, 125.0));
                if (dd < best) {
                    best = dd;
                    lp = (q - ctr) * cs;
                    hk = rm_h(seed + c.x * 0.37 + c.y * 0.71, 120.0);
                }
            }
        }
        let wob = st_noise(vec2<f32>(x, y) / 0.08 + hk * 9.0);
        let arcs = 0.5 + 0.5 * sin(length(lp) * (35.0 + 40.0 * hk) + atan2(lp.y, lp.x) * select(1.0, -1.0, hk > 0.5) + wob * 4.0 + hk * 6.28);
        let thick = smoothstep(0.2, 0.75, st_noise(vec2<f32>(x, y) / 0.6 + seed * 13.0));
        // a milky film, the wipes' arcs faint in it
        let cover = clamp(0.5 + 0.32 * thick + 0.14 * (mix(0.5, arcs, sl_keep(0.04, fp)) - 0.5), 0.0, 0.9);
        paper = vec4<f32>(vec3<f32>(0.66, 0.66, 0.63), cover);
    }
    // masking tape at the sheets' corners (the paper styles)
    if (style < 0.86 && paper.a > 0.0) {
        let sz = select(select(vec2<f32>(0.6, 0.86), vec2<f32>(0.42, 0.58), style < 0.5), vec2<f32>(0.9, 9.0), style < 0.28);
        let lp = vec2<f32>(x, y) - floor(vec2<f32>(x, y) / sz) * sz;
        let cd = min(lp, sz - lp);
        let tape = sl_cov(max(cd.x - 0.06, cd.y - 0.025), fp) * step(cd.x, 0.07) * step(style, 0.72) + sl_cov(abs(y - size.y + 0.03) - 0.02, fp) * step(style, 0.28);
        paper = vec4<f32>(mix(paper.rgb, WX_TAPE, clamp(tape, 0.0, 1.0) * paper.a), paper.a);
    }
    // the unlit, emptied room through the gaps; the paper at the glass, lit through it by day
    let room = (*o).day.rgb * 0.35;
    (*o).day = vec4<f32>(mix(room, paper.rgb * 0.85 * RM_DAY_THROUGH, paper.a), (*o).day.w);
}
