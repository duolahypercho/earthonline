// the CC0 scanned sets on walls, roofs, streets, the ground and the open
// spaces (cc0.rs; appended to the city shader by look.rs). Constants CC0_* are
// generated by cc0.rs `wgsl_constants`.
//
// The scans replace base maps only: a kit wall keeps its bake's mean colour
// (natural sets are scaled to it channel by channel, painted sets give their
// luminance detail), then the JS-ported per-building paint, tint, weathering
// and ageing apply as before (facade_age.wgsl). The street keeps the JS
// ground material (draw.wgsl street_surface): a scan enters normalised to the
// JS set's mean, so the delivered tone is the JS one and the scan adds its
// structure. Every texture read is textureSampleGrad (no implicit derivatives
// in the branches).

@group(0) @binding(17) var cc0_albedo: texture_2d_array<f32>;
@group(0) @binding(18) var cc0_normal: texture_2d_array<f32>;
@group(0) @binding(19) var cc0_rhm: texture_2d_array<f32>;
@group(0) @binding(20) var cc0_samp: sampler;
@group(0) @binding(21) var<storage, read> cc0_mats: array<vec4<f32>>;
@group(0) @binding(22) var<storage, read> cc0_layers: array<vec4<f32>>;
@group(0) @binding(23) var cc0_dalbedo: texture_2d_array<f32>;
@group(0) @binding(24) var cc0_dnormal: texture_2d_array<f32>;
@group(0) @binding(25) var cc0_drhm: texture_2d_array<f32>;
@group(0) @binding(26) var<storage, read> cc0_grid: array<vec4<u32>>;
@group(0) @binding(27) var<storage, read> cc0_decals: array<vec4<f32>>;

const CC0_LUMA: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);
// Parallax occlusion: crisp mortar/clapboard/stone relief across a full street width.
const CC0_POM_FAR: f32 = 24.0;
const CC0_POM_STEPS: i32 = 10;
// The street's extra scans (worn walk, cracked asphalt, the decals) and the
// ground's anti-tiling phase only this close (metres): past it a 2-3 m repeat
// is a few pixels and the mips average them to the set's mean.
const CC0_EXTRA_FAR: f32 = 140.0;

// Set by `shade` before the surface: a wall drew a scan (the facade-detail
// sheet's knotted-pine / plaster cells then stand down), and the street's
// footway gradient of its across-the-walk coordinate (scoring joints).
var<private> cc0_wall_hit: bool;
var<private> cc0_daux: vec2<f32>;
var<private> cc0_drx: vec3<f32>;
var<private> cc0_dry: vec3<f32>;
// Street decal results carried from the scan stage to the lit surface.
var<private> cc0_p_dark: f32;
var<private> cc0_p_rough: vec2<f32>; // (value, weight)
var<private> cc0_p_alb: vec4<f32>;   // (linear colour, weight)
var<private> cc0_p_n: vec3<f32>;     // (tangent xy in the street plane, weight)
var<private> cc0_p_metal: f32;
var<private> cc0_p_plaza: vec4<f32>; // (paver albedo over its mean, weight)

fn cc0_run() -> u32 {
    return u32(frame.copy_step.w);
}

fn cc0_on(bit: u32) -> bool {
    let r = cc0_run();
    return (r & CC0_RUN_ON) != 0u && (r & bit) != 0u;
}

struct Cc0Tap {
    alb: vec4<f32>,
    n: vec2<f32>,
    rough: f32,
    ao: f32,
    h: f32,
    metal: f32,
};

fn cc0_tap(uv: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, layer: i32) -> Cc0Tap {
    var t: Cc0Tap;
    t.alb = textureSampleGrad(cc0_albedo, cc0_samp, uv, layer, gx, gy);
    t.n = textureSampleGrad(cc0_normal, cc0_samp, uv, layer, gx, gy).xy * 2.0 - 1.0;
    let r = textureSampleGrad(cc0_rhm, cc0_samp, uv, layer, gx, gy);
    t.rough = r.x;
    t.ao = r.y;
    t.h = r.z;
    t.metal = r.w;
    return t;
}

// Albedo and relief only (two reads): for second layers over a full tap.
fn cc0_tap2(uv: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, layer: i32) -> Cc0Tap {
    var t: Cc0Tap;
    t.alb = textureSampleGrad(cc0_albedo, cc0_samp, uv, layer, gx, gy);
    t.n = textureSampleGrad(cc0_normal, cc0_samp, uv, layer, gx, gy).xy * 2.0 - 1.0;
    t.rough = cc0_lmisc(layer).x;
    t.ao = cc0_lmisc(layer).y;
    t.h = cc0_lmisc(layer).z;
    t.metal = 0.0;
    return t;
}

fn cc0_dtap(uv: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, layer: i32) -> Cc0Tap {
    var t: Cc0Tap;
    t.alb = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, layer, gx, gy);
    t.n = textureSampleGrad(cc0_dnormal, cc0_samp, uv, layer, gx, gy).xy * 2.0 - 1.0;
    let r = textureSampleGrad(cc0_drhm, cc0_samp, uv, layer, gx, gy);
    t.rough = r.x;
    t.ao = r.y;
    t.h = r.z;
    t.metal = r.w;
    return t;
}

// Per layer: (mean linear rgb, mean luma), (mean rough, ao, height), (1/size u, 1/size v, size u, size v).
fn cc0_lmean(l: i32) -> vec4<f32> {
    return cc0_layers[u32(l) * 3u];
}
fn cc0_lmisc(l: i32) -> vec4<f32> {
    return cc0_layers[u32(l) * 3u + 1u];
}
fn cc0_linv(l: i32) -> vec2<f32> {
    return cc0_layers[u32(l) * 3u + 2u].xy;
}
fn cc0_dmean(l: i32) -> vec4<f32> {
    return cc0_layers[(CC0_MAT_LAYERS + u32(l)) * 3u];
}
// A decal layer's size (metres, u x v): one decal, or one repeat of a tiling mask.
fn cc0_dsize(l: i32) -> vec2<f32> {
    return cc0_layers[(CC0_MAT_LAYERS + u32(l)) * 3u + 2u].zw;
}
// A mirrored repeat (period 2, 0..1..0): tiles a window of a scan without a seam.
fn cc0_tri(x: f32) -> f32 {
    return abs(fract(x * 0.5) * 2.0 - 1.0);
}
// the carriageway's base colour: aged asphalt's albedo (cc0.rs ASPHALT_ALBEDO),
// neutral grey, the JS class and age variation kept as its luminance.
fn cc0_asphalt_base(b: vec3<f32>) -> vec3<f32> {
    return CC0_ASPHALT_TINT * (pow(max(dot(b, CC0_LUMA) / CC0_ASPHALT_REF_LUMA, 0.0), CC0_ASPHALT_SPREAD) * CC0_ASPHALT_ALBEDO);
}

// Shading choices of the grime and wear (metres; not street dimensions).
// Grime rises this high from a wall's foot (rain splash and street dirt).
const CC0_WALL_GRIME_M: f32 = 0.8;
// Grime reaches this far out from the kerb line across the gutter.
const CC0_GUTTER_GRIME_M: f32 = 0.9;
// The tooled border along a sidewalk joint (an edger's width), as a share of the scoring pitch.
const CC0_TOOLED_EDGE_FRAC: f32 = 0.055;

// Steep parallax with one linear refinement on the height channel (1 = the
// face, 0 = `depth` behind it). `vt`: the view direction in (t, image-up, n);
// `dsc`: uv per metre along t and image-up.
fn cc0_pom(uv: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, layer: i32, vt: vec3<f32>, depth: f32, dsc: vec2<f32>, fade: f32) -> vec2<f32> {
    let vz = max(vt.z, 0.2);
    // Going in along the view ray: -vt in tangent metres; u follows t, v runs against image-up.
    let full = vec2<f32>(-vt.x, vt.y) / vz * depth * dsc * fade;
    let steps = i32(mix(f32(CC0_POM_STEPS) * 0.5, f32(CC0_POM_STEPS), clamp(1.0 - vt.z, 0.0, 1.0)));
    let dl = 1.0 / f32(steps);
    var prev_d = 0.0;
    var prev_s = 0.0;
    var d = 0.0;
    var hit = uv;
    for (var i = 0; i <= steps; i = i + 1) {
        d = f32(i) * dl;
        let p = uv + full * d;
        let h = textureSampleGrad(cc0_rhm, cc0_samp, p, layer, gx, gy).z;
        let surf = 1.0 - h;
        if (d >= surf) {
            // Refine between the last step above the surface and this one.
            let a = prev_s - prev_d;
            let b = d - surf;
            let t = a / max(a + b, 1e-5);
            hit = uv + full * mix(prev_d, d, t);
            return hit;
        }
        prev_d = d;
        prev_s = surf;
        hit = p;
    }
    return hit;
}

fn cc0_frame_normal(fr: FaFrame, tn: vec2<f32>, strength: f32) -> vec3<f32> {
    let t = tn * strength;
    let z = sqrt(max(0.0, 1.0 - dot(t, t)));
    return normalize(fr.t * t.x + fr.b * t.y + fr.n * z);
}

// ---- walls, roofs, the open spaces' paving ------------------------------------

// A material with a scan (`cc0_mats[mi]`): albedo, roughness, occlusion,
// normal from the scan on the directional face frame. Returns false when the
// material has none (it then draws as before). `vertex_colour`: the material's
// colour is the vertex colour (open spaces), not the kit bake.
fn cc0_surface(s: ptr<function, Surface>, m: Material, mi: u32, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, vcol: vec3<f32>, object: u32, vertex_colour: bool) -> bool {
    // The switch first: until the sets are resident the table is a 16-byte placeholder.
    if (!cc0_on(select(CC0_RUN_WALLS, CC0_RUN_GROUND, vertex_colour))) {
        return false;
    }
    let ob = objects[object];
    let kind = ob.kind & 255u;
    // Blender-building foundation skirts (`ObjectKind::Skirt = 8`, vertex-coloured concrete):
    // give them real board-formed cast concrete texture, pour lifts, normal relief, and sloped-sidewalk contact AO.
    if (vertex_colour && kind == 8u && abs(n.y) < 0.82) {
        let dist_s = length(frame.cam_pos.xyz - world);
        let vfade_s = 1.0 - smoothstep(select(180.0, 340.0, SF_AAA_DETAIL), select(280.0, 480.0, SF_AAA_DETAIL), dist_s);
        if (vfade_s <= 0.0) {
            return false;
        }
        let fr_s = fa_frame(n);
        let lay_s = CC0_L_WOOD_TEXTURED_CONCRETE;
        let inv_s = cc0_linv(lay_s);
        let uv_s = vec2<f32>(dot(world, fr_s.t) * inv_s.x, -dot(world, fr_s.b) * inv_s.y);
        let gx_s = vec2<f32>(dot(dpx, fr_s.t) * inv_s.x, -dot(dpx, fr_s.b) * inv_s.y);
        let gy_s = vec2<f32>(dot(dpy, fr_s.t) * inv_s.x, -dot(dpy, fr_s.b) * inv_s.y);
        let t_s = cc0_tap(uv_s, gx_s, gy_s, lay_s);
        let lm_s = cc0_lmean(lay_s);
        let lx_s = cc0_lmisc(lay_s);
        let rel_s = t_s.alb.rgb / max(lm_s.rgb, vec3<f32>(1e-3));
        var alb_s = (*s).albedo * clamp(rel_s, vec3<f32>(0.55), vec3<f32>(1.45)) * vec3<f32>(0.88, 0.87, 0.84);
        var tn_s = t_s.n;
        var ao_s = clamp(t_s.ao / max(lx_s.y, 0.05), 0.35, 1.0);
        let fw_s = max(length(dpx), length(dpy));
        let keep_s = 1.0 - smoothstep(0.015, 0.09, fw_s);
        let wu_s = dot(world, fr_s.t);
        let wv_s = world.y;
        // Board-form cast-concrete pour lifts (0.55 m) & vertical panel joints (1.8 m)
        let fpu = fract(wu_s / 1.8);
        let fpv = fract(wv_s / 0.55);
        let p_var = (st_hash(floor(vec2<f32>(wu_s / 1.8, wv_s / 0.55))) - 0.5) * 0.11;
        alb_s = alb_s * (1.0 + p_var * (1.0 - smoothstep(0.12, 0.55, fw_s)));
        if (keep_s > 0.01) {
            let du = min(fpu, 1.0 - fpu) * 1.8;
            let dv = min(fpv, 1.0 - fpv) * 0.55;
            let gu = 1.0 - smoothstep(0.006, 0.020, du);
            let gv = 1.0 - smoothstep(0.006, 0.022, dv);
            let gr = max(gu, gv) * keep_s;
            alb_s = alb_s * (1.0 - 0.30 * gr);
            ao_s = ao_s * (1.0 - 0.38 * gr);
            tn_s = tn_s + vec2<f32>(select(-1.0, 1.0, fpu < 0.5) * gu, select(-1.0, 1.0, fpv < 0.5) * gv) * (0.42 * keep_s);
        }
        if (SF_AAA_DETAIL) {
            // Macro pilaster buttresses & horizontal rustication readable on tall hillside skirts in `05a`
            let keep_ms = 1.0 - smoothstep(0.30, 1.45, fw_s);
            if (keep_ms > 0.01) {
                let drop_s = max(ob.max.y - world.y, 0.0);
                let bay_su = fract(wu_s / 3.6);
                let d_sp = min(bay_su, 1.0 - bay_su) * 3.6;
                let in_sp = (1.0 - smoothstep(0.28, 0.36 + fw_s * 0.5, d_sp)) * keep_ms;
                let sp_e = (smoothstep(0.24, 0.32, d_sp) * (1.0 - smoothstep(0.34, 0.52 + fw_s * 0.5, d_sp))) * keep_ms;
                let lf_s = fract(drop_s / 2.2);
                let rust_s = (1.0 - smoothstep(0.03, 0.11 + fw_s * 0.4, min(lf_s, 1.0 - lf_s) * 2.2)) * keep_ms;
                alb_s = alb_s * (1.0 + 0.14 * in_sp - 0.22 * sp_e) * (1.0 - 0.26 * rust_s);
                ao_s = ao_s * (1.0 - 0.34 * sp_e) * (1.0 - 0.36 * rust_s);
                tn_s.x = tn_s.x + select(1.0, -1.0, bay_su < 0.5) * sp_e * 0.48;
                tn_s.y = tn_s.y + select(-1.0, 1.0, lf_s < 0.5) * rust_s * 0.38;
            }
        }
        // Exact sloped-sidewalk contact crevice AO & rising damp via ambient ground plane
        if (amb_on()) {
            let h_w = max(world.y - amb_plane(world.xz + fr_s.n.xz * 0.6).z, 0.0);
            let contact_s = 1.0 - smoothstep(0.0, 0.45, h_w);
            let tight_s = 1.0 - smoothstep(0.0, 0.14, h_w);
            let damp_s = 1.0 - smoothstep(0.0, 0.72 + 0.25 * st_noise(vec2<f32>(wu_s * 0.6, 3.1)), h_w);
            alb_s = alb_s * (1.0 - 0.24 * damp_s - 0.22 * tight_s);
            ao_s = ao_s * (1.0 - 0.48 * contact_s) * (1.0 - 0.30 * tight_s);
        }
        (*s).albedo = mix((*s).albedo, alb_s, vfade_s);
        (*s).rough = clamp(mix(0.86, t_s.rough / max(lx_s.x, 0.05) * 0.88, 0.75 * vfade_s), 0.62, 0.98);
        (*s).ao = mix((*s).ao, clamp(ao_s, 0.16, 1.0), vfade_s);
        (*s).n = cc0_frame_normal(fr_s, tn_s, 1.25 * vfade_s);
        cc0_wall_hit = true;
        return true;
    }
    let e0 = cc0_mats[mi * 4u];
    if (e0.x < 0.0) {
        return false;
    }
    let e1 = cc0_mats[mi * 4u + 1u];
    let e2 = cc0_mats[mi * 4u + 2u];
    let e3 = cc0_mats[mi * 4u + 3u];
    var paint = 0.5;
    var wear = 0.5;
    var seed = f32(ob.lod_group % 4093u) * 1.618034;
    var kit_base_y = -1e9;
    var kit_skirt = false;
    if (kind == 5u) {
        let d = fa_drivers(fa_ages[ob.lod_group]);
        paint = d.paint;
        wear = d.wear;
        seed = d.seed;
        kit_base_y = d.base_y;
        kit_skirt = !vertex_colour && abs(n.y) < 0.35 && world.y < d.base_y - 0.02;
    }
    let code = u32(e1.w + 0.5);
    var mode = code & 15u;
    let drive = code >> 4u;
    var layer = i32(e0.x);
    var mul = e1.rgb;
    var inv = e0.zw;
    var n_str = e2.w;
    if (kit_skirt) {
        // Sloped SF hillside foundation skirts: architectural board-formed poured concrete instead of blank dark cliff.
        layer = CC0_L_WOOD_TEXTURED_CONCRETE;
        let lm_sk = cc0_lmean(layer);
        let sk_base = select(vec3<f32>(0.29, 0.28, 0.26), vec3<f32>(0.36, 0.35, 0.33), SF_AAA_DETAIL);
        mul = sk_base / max(lm_sk.rgb, vec3<f32>(1e-3));
        inv = cc0_linv(layer);
        mode = CC0_MODE_NATURAL;
        n_str = 1.35;
    } else if (e0.y >= 0.0 && drive != 0u) {
        // The building's paint age (or wear) picks the other state, at a threshold of its own.
        let v = select(wear, paint, drive == 1u);
        let th = 0.5 + (fract(seed * 0.6180340) - 0.5) * 0.3;
        if (v > th) {
            layer = i32(e0.y);
            mul = e2.rgb;
            inv = cc0_linv(layer);
        }
    }
    let fr = fa_frame(n);
    if (mode == CC0_MODE_PLAZA) {
        // The plaza style by its vertex colour (plaza-paving.js tones): brick, light concrete, grey stone.
        let warm = vcol.r - vcol.b;
        layer = select(select(CC0_L_COBBLESTONE_FLOOR_08, CC0_L_PATTERNED_CONCRETE_PAVERS, dot(vcol, CC0_LUMA) > 0.6), CC0_L_HERRINGBONE_PAVEMENT, warm > 0.12);
        inv = cc0_linv(layer);
    } else if (mode == CC0_MODE_SAND) {
        // Wet below the swash's reach (beach-surface.js wet margin, widened to the sand sheet).
        let wet = world.y < LM_SEA_LEVEL_Y + 1.2 + st_noise(world.xz / 9.0) * 0.8;
        layer = select(CC0_L_COAST_SAND_04, CC0_L_DAMP_BEACH_SAND, wet);
        inv = cc0_linv(layer);
    }
    // Each building its own phase of the repeat (neighbours do not line up).
    var off = vec2<f32>(0.0);
    if (cc0_on(CC0_RUN_TILING)) {
        off = fract(vec2<f32>(seed * 0.7548777, seed * 0.5698403));
    }
    var uv = vec2<f32>(dot(world, fr.t) * inv.x, -dot(world, fr.b) * inv.y) + off;
    let gx = vec2<f32>(dot(dpx, fr.t) * inv.x, -dot(dpx, fr.b) * inv.y);
    let gy = vec2<f32>(dot(dpy, fr.t) * inv.x, -dot(dpy, fr.b) * inv.y);
    let to_eye = frame.cam_pos.xyz - world;
    let dist = length(to_eye);
    // The open spaces' surfaces (quay, aprons, decks, plazas, sand) are large
    // and seen far: their scan fades out between 150 and 220 m, where its mips
    // are close to their mean.
    var vfade = 1.0;
    if (SF_STREET_PBR && mode == CC0_MODE_PLAZA) {
        // (`--street-pbr`, street_pbr.wgsl) the paving at its material's albedo, at every distance
        (*s).albedo = (*s).albedo * sp_pave_cal(layer);
    }
    if (vertex_colour) {
        vfade = 1.0 - smoothstep(150.0, 220.0, dist);
        if (vfade <= 0.0) {
            return false;
        }
    }
    if (SF_STREET_PBR && mode == CC0_MODE_PLAZA && n.y > 0.9) {
        // (`--street-pbr`, street_pbr.wgsl) the paving's scan stochastically tiled (the random setts), in relief, self-shadowed
        let pv = sp_pave(layer, world.xz, dpx.xz, dpy.xz, world, layer == CC0_L_COBBLESTONE_FLOOR_08);
        (*s).albedo = mix((*s).albedo, (*s).albedo * max(mix(vec3<f32>(1.0), pv.alb, e3.z), vec3<f32>(0.0)), vfade);
        (*s).rough = clamp((*s).rough * mix(1.0, pv.rough, 0.7 * vfade), 0.04, 1.0);
        (*s).ao = mix((*s).ao, clamp(mix(1.0, pv.ao, 0.85), 0.25, 1.0), vfade);
        (*s).n = normalize(n + vec3<f32>(pv.tn.x, 0.0, pv.tn.y) * e2.w * vfade);
        cc0_wall_hit = true;
        return true;
    }
    if (cc0_on(CC0_RUN_POM) && e3.x > 0.0 && dist < CC0_POM_FAR) {
        let v = to_eye / max(dist, 1e-4);
        let vt = vec3<f32>(dot(v, fr.t), dot(v, fr.b), dot(v, fr.n));
        let fade = 1.0 - smoothstep(CC0_POM_FAR * 0.6, CC0_POM_FAR, dist);
        uv = cc0_pom(uv, gx, gy, layer, vt, e3.x, inv, fade);
    }
    let t = cc0_tap(uv, gx, gy, layer);
    let lm = cc0_lmean(layer);
    let lx = cc0_lmisc(layer);
    var alb: vec3<f32>;
    var mean: vec3<f32>;
    if (vertex_colour) {
        // Around the vertex colour: the scan's own variation, mean one.
        let rel = select(t.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), vec3<f32>(dot(t.alb.rgb, CC0_LUMA) / max(lm.w, 1e-3)), mode == CC0_MODE_PAINTED);
        alb = (*s).albedo * rel;
        mean = (*s).albedo;
    } else if (mode == CC0_MODE_PAINTED) {
        alb = vec3<f32>(dot(t.alb.rgb, CC0_LUMA)) * mul;
        mean = vec3<f32>(lm.w) * mul;
    } else {
        alb = t.alb.rgb * mul;
        mean = lm.rgb * mul;
    }
    alb = max(mix(mean, alb, e3.z), vec3<f32>(0.0));
    if (cc0_on(CC0_RUN_TILING)) {
        // A slow tone field over the wall (pour, batch and repaint differences).
        let mv = st_noise(vec2<f32>(dot(world, fr.t), world.y) / 6.7 + seed * 3.1) * 0.6 + st_noise(world.xz / 23.0 + world.y * 0.05) * 0.4;
        alb = alb * (1.0 + (mv - 0.5) * 0.12);
    }
    if (cc0_on(CC0_RUN_GRIME) && e3.y > 0.0) {
        // Dirt held in the low ground of the relief: mortar joints, board laps, grooves.
        let low = 1.0 - smoothstep(lx.z - 0.25, lx.z + 0.02, t.h);
        alb = alb * (1.0 - low * e3.y * (0.35 + 0.45 * wear));
    }
    var micro_tn = t.n;
    var micro_rough = t.rough / max(lx.x, 0.05);
    var micro_ao = mix(1.0, t.ao / max(lx.y, 0.05), 0.85);
    let blender_ext = kind == 4u && ob.lod_role == 1u && (!SF_HOUSE || (ob.kind & 0xfffffe00u) == 0u);
    let bldg_ext = kind == 5u || blender_ext;
    let bldg_base_y = select(ob.min.y, kit_base_y, kind == 5u);
    // Architectural PBR micro-depth on upright kit AND exterior Blender walls (precast V-grooves,
    // stone/granite sheen contrast, clapboard lap shadows, stucco joints, per-building warm/cool
    // value diversity — filtered by pixel footprint).
    if (!vertex_colour && bldg_ext && abs(n.y) < 0.35) {
        let fw = max(length(dpx), length(dpy));
        let keep_j = 1.0 - smoothstep(0.018, 0.095, fw);
        let wall_u = dot(world, fr.t) + fract(seed * 0.413) * 1.8;
        let wall_v = world.y;
        // Subtle per-building hue/value diversity (breaks copy-paste blocks while preserving palettes).
        if (SF_FACADE_PATINA && !kit_skirt) {
            let b_val = (fract(seed * 0.7548777) - 0.5) * 0.10;
            let b_temp = (fract(seed * 0.5698403) - 0.5) * 0.045;
            alb = alb * (1.0 + b_val) * vec3<f32>(1.0 + b_temp, 1.0, 1.0 - b_temp);
        }
        if (kit_skirt) {
            // Board-formed cast-in-place hillside concrete: horizontal pour lifts (0.55 m), vertical formwork
            // panel joints (1.8 m), tie-rod cone dimples, water-table shadow, and exact sloped-sidewalk contact AO.
            let pu = wall_u / 1.8;
            let pv = max(kit_base_y - world.y, 0.0) / 0.55;
            let cell = floor(vec2<f32>(pu, pv));
            let fuv = vec2<f32>(fract(pu), fract(pv));
            let panel_var = (st_hash(cell + vec2<f32>(seed * 0.17, 5.1)) - 0.5) * 0.14;
            alb = alb * (1.0 + panel_var * (1.0 - smoothstep(0.14, 0.60, fw)));
            if (keep_j > 0.01) {
                let du = min(fuv.x, 1.0 - fuv.x) * 1.8;
                let dv = min(fuv.y, 1.0 - fuv.y) * 0.55;
                let gu = 1.0 - smoothstep(0.007, 0.022, du);
                let gv = 1.0 - smoothstep(0.007, 0.024, dv);
                let groove = max(gu, gv) * keep_j;
                // Recessed formwork tie-rod cone holes (two per 1.8 m x 0.55 m lift)
                let tie_u = min(abs(fuv.x - 0.25), abs(fuv.x - 0.75)) * 1.8;
                let tie_v = abs(fuv.y - 0.5) * 0.55;
                let tie = (1.0 - smoothstep(0.014, 0.030, length(vec2<f32>(tie_u, tie_v)))) * keep_j;
                alb = alb * (1.0 - 0.34 * groove - 0.42 * tie);
                micro_ao = micro_ao * (1.0 - 0.42 * groove) * (1.0 - 0.48 * tie);
                micro_rough = mix(micro_rough, 1.18, max(groove, tie));
                let su = select(-1.0, 1.0, fuv.x < 0.5) * gu * keep_j;
                let sv = select(-1.0, 1.0, fuv.y < 0.5) * gv * keep_j;
                micro_tn = micro_tn + vec2<f32>(su, sv) * 0.45;
            }
            // Water-table overhang shadow directly under the floor slab (`kit_base_y`)
            let under_wt = 1.0 - smoothstep(0.0, select(0.28, 0.48, SF_AAA_DETAIL), max(kit_base_y - world.y, 0.0));
            alb = alb * (1.0 - 0.24 * under_wt);
            micro_ao = micro_ao * (1.0 - 0.44 * under_wt);
            if (SF_AAA_DETAIL) {
                // Macro architectural retaining-wall articulation readable at hillside vista distances (10-420 m in `05a`):
                // 3.6 m rhythmic pilaster buttress bays, recessed coffered wall panels, 2.2 m horizontal rustication grooves,
                // and recessed ventilation / basement garage openings on tall > 3.2 m hillside retaining walls.
                let keep_m = 1.0 - smoothstep(0.30, 1.45, fw);
                if (keep_m > 0.01) {
                    let drop_y = max(kit_base_y - world.y, 0.0);
                    let bay_u = fract(wall_u / 3.6);
                    let bay_cell = floor(wall_u / 3.6);
                    let d_pil = min(bay_u, 1.0 - bay_u) * 3.6;
                    let pil_w = 0.28;
                    let in_pil = (1.0 - smoothstep(pil_w, pil_w + 0.08 + fw * 0.5, d_pil)) * keep_m;
                    let pil_edge = (smoothstep(pil_w - 0.04, pil_w + 0.04, d_pil) * (1.0 - smoothstep(pil_w + 0.06, pil_w + 0.24 + fw * 0.5, d_pil))) * keep_m;
                    // Coffered panel tone variation + sunlit pilaster contrast
                    let bay_tone = (st_hash(vec2<f32>(bay_cell, floor(seed * 73.0))) - 0.5) * 0.14 * keep_m;
                    alb = alb * (1.0 + bay_tone + 0.14 * in_pil - 0.22 * pil_edge);
                    micro_ao = micro_ao * (1.0 - 0.34 * pil_edge);
                    micro_tn.x = micro_tn.x + select(1.0, -1.0, bay_u < 0.5) * pil_edge * 0.48;
                    // Bold 2.2 m horizontal rustication / concrete pour-lift shadow bands
                    let lift_f = fract(drop_y / 2.2);
                    let d_lift = min(lift_f, 1.0 - lift_f) * 2.2;
                    let rust = (1.0 - smoothstep(0.03, 0.11 + fw * 0.4, d_lift)) * keep_m;
                    alb = alb * (1.0 - 0.26 * rust);
                    micro_ao = micro_ao * (1.0 - 0.36 * rust);
                    micro_tn.y = micro_tn.y + select(-1.0, 1.0, lift_f < 0.5) * rust * 0.38;
                    // Recessed dark basement garage / vent louver bays on tall hillside skirts (`drop_y > 1.6 m`)
                    let b_open = step(0.35, st_hash(vec2<f32>(bay_cell * 1.7 + 3.1, floor(seed * 41.0))));
                    let in_open_u = smoothstep(0.22, 0.26, bay_u) * (1.0 - smoothstep(0.74, 0.78, bay_u));
                    let open_v = fract((drop_y - 0.8) / 3.4);
                    let in_open_v = step(1.4, drop_y) * smoothstep(0.18, 0.24, open_v) * (1.0 - smoothstep(0.78, 0.84, open_v));
                    let recess = in_open_u * in_open_v * b_open * keep_m;
                    alb = mix(alb, alb * 0.38, recess * 0.80);
                    micro_ao = micro_ao * (1.0 - 0.52 * recess);
                    micro_rough = mix(micro_rough, 0.96, recess);
                }
            }
            // Exact sloped-sidewalk contact crevice AO & rising damp concrete plinth via ambient plane
            var h_walk = max(world.y - ob.min.y, 0.0);
            if (amb_on()) {
                let pl_y = amb_plane(world.xz + fr.n.xz * 0.6).z;
                h_walk = max(world.y - pl_y, 0.0);
            }
            let contact_s = 1.0 - smoothstep(0.0, 0.46, h_walk);
            let tight_s = 1.0 - smoothstep(0.0, 0.14, h_walk);
            let damp_h = 0.62 + 0.34 * st_noise(vec2<f32>(wall_u * 0.55, seed * 0.7));
            let damp_s = 1.0 - smoothstep(0.0, damp_h, h_walk);
            alb = alb * (1.0 - 0.24 * damp_s - 0.26 * tight_s);
            micro_ao = micro_ao * (1.0 - 0.48 * contact_s) * (1.0 - 0.34 * tight_s);
            micro_rough = micro_rough * (1.0 - 0.12 * damp_s);
        } else if (layer == CC0_L_CONCRETE_WALL_008 || layer == CC0_L_WOOD_TEXTURED_CONCRETE) {
            // Architectural precast panel V-grooves (1.8 m x 3.2 m modules) + subtle per-panel pour variation.
            let pu = wall_u / 1.8;
            let pv = wall_v / 3.2;
            let cell = floor(vec2<f32>(pu, pv));
            let fuv = vec2<f32>(fract(pu), fract(pv));
            let panel_var = (st_hash(cell + vec2<f32>(seed * 0.13, 3.7)) - 0.5) * 0.09;
            alb = alb * (1.0 + panel_var * (1.0 - smoothstep(0.15, 0.65, fw)));
            if (keep_j > 0.01) {
                let du = min(fuv.x, 1.0 - fuv.x) * 1.8;
                let dv = min(fuv.y, 1.0 - fuv.y) * 3.2;
                let gu = 1.0 - smoothstep(0.008, 0.022, du);
                let gv = 1.0 - smoothstep(0.008, 0.022, dv);
                let groove = max(gu, gv) * keep_j;
                alb = alb * (1.0 - 0.28 * groove);
                micro_ao = micro_ao * (1.0 - 0.35 * groove);
                micro_rough = mix(micro_rough, 1.15, groove);
                let su = select(-1.0, 1.0, fuv.x < 0.5) * gu * keep_j;
                let sv = select(-1.0, 1.0, fuv.y < 0.5) * gv * keep_j;
                micro_tn = micro_tn + vec2<f32>(su, sv) * 0.32;
                if (SF_AAA_DETAIL) {
                    // Crisp chamfered outer precast edge-bevel catching raking sun highlights
                    let bu = (smoothstep(0.016, 0.026, du) * (1.0 - smoothstep(0.032, 0.068, du))) * keep_j;
                    let bv = (smoothstep(0.016, 0.026, dv) * (1.0 - smoothstep(0.032, 0.068, dv))) * keep_j;
                    let bev = max(bu, bv);
                    micro_tn = micro_tn + vec2<f32>(select(1.0, -1.0, fuv.x < 0.5) * bu, select(1.0, -1.0, fuv.y < 0.5) * bv) * 0.28;
                    micro_rough = micro_rough * (1.0 - 0.14 * bev);
                }
            }
        } else if (layer == CC0_L_WHITE_STUCCO) {
            // California sand-float stucco: subtle horizontal floor control-joint reveals (3.15 m) & crisp fine plaster tooth.
            let sv_y = max(world.y - bldg_base_y, 0.0) / 3.15;
            let fsv = fract(sv_y);
            let bay_var = (st_noise(vec2<f32>(wall_u / 4.2, sv_y * 0.8) + seed * 1.9) - 0.5) * 0.08;
            alb = alb * (1.0 + bay_var * (1.0 - smoothstep(0.18, 0.72, fw)));
            if (SF_AAA_DETAIL) {
                // Fine 4-10 cm sand-float plaster mineral tooth (smooth architectural stucco, zero large bumpy blobs).
                let keep_g = 1.0 - smoothstep(0.008, 0.036, fw);
                if (keep_g > 0.01) {
                    let g0 = st_noise(vec2<f32>(wall_u, wall_v) * 24.0 + seed * 3.1);
                    let g1 = st_noise(vec2<f32>(wall_u, wall_v) * 8.5 + seed * 7.7);
                    let gx_s = st_noise(vec2<f32>(wall_u + 0.014, wall_v) * 24.0 + seed * 3.1) - g0;
                    let gy_s = st_noise(vec2<f32>(wall_u, wall_v + 0.014) * 24.0 + seed * 3.1) - g0;
                    alb = alb * (1.0 + ((g0 - 0.5) * 0.038 + (g1 - 0.5) * 0.032) * keep_g);
                    micro_tn = micro_tn + vec2<f32>(gx_s, gy_s) * (0.24 * keep_g);
                    micro_rough = clamp(micro_rough + (g0 - 0.5) * 0.07 * keep_g, 0.74, 1.0);
                }
            }
            if (keep_j > 0.01 && world.y > bldg_base_y + 0.3) {
                let dv = min(fsv, 1.0 - fsv) * 3.15;
                let jv = (1.0 - smoothstep(0.006, 0.020, dv)) * keep_j;
                alb = alb * (1.0 - 0.22 * jv);
                micro_ao = micro_ao * (1.0 - 0.28 * jv);
                micro_tn.y = micro_tn.y + select(-1.0, 1.0, fsv < 0.5) * jv * 0.26;
                if (SF_AAA_DETAIL) {
                    let bv_s = (smoothstep(0.015, 0.026, dv) * (1.0 - smoothstep(0.032, 0.064, dv))) * keep_j;
                    micro_tn.y = micro_tn.y + select(1.0, -1.0, fsv < 0.5) * bv_s * 0.24;
                }
            }
        } else if (layer == CC0_L_GRANITE_WALL || layer == CC0_L_WHITE_SANDSTONE_BLOCKS_02) {
            // Honed vs polished granite & ashlar contrast: smoother mineral faces vs matte recessed mortar joints.
            let joint = 1.0 - smoothstep(lx.z - 0.18, lx.z + 0.04, t.h);
            let granite = layer == CC0_L_GRANITE_WALL;
            var face_r = select(0.84, 0.52 + 0.24 * fract(seed * 0.317), granite);
            if (SF_AAA_DETAIL) {
                let plinth_zone = 1.0 - smoothstep(4.0, 7.0, max(world.y - bldg_base_y, 0.0));
                if (granite) {
                    // Ground-floor polished granite plinths catch crisp specular reflections vs matte joints
                    face_r = mix(0.48 + 0.20 * fract(seed * 0.317), 0.36 + 0.14 * fract(seed * 0.317), plinth_zone);
                } else {
                    face_r = mix(0.80, 0.70, plinth_zone);
                }
                micro_tn = micro_tn * 1.12;
            }
            micro_rough = mix(micro_rough * face_r, 1.20, joint);
            micro_ao = micro_ao * (1.0 - select(0.28, 0.36, SF_AAA_DETAIL) * joint * keep_j);
            if (granite && keep_j > 0.01) {
                // Subtle polished mica / mineral specular variation across granite blocks
                let fleck = st_noise(vec2<f32>(wall_u, wall_v) * 18.0);
                micro_rough = micro_rough * (0.86 + 0.26 * fleck);
            }
            // Low garden retaining walls (`ob.max.y - ob.min.y < 2.6 m`): weathered damp base & mortar moss patina
            if (blender_ext && (ob.max.y - ob.min.y) < 2.6) {
                let h_ret = max(world.y - ob.min.y, 0.0);
                let top_cap = 1.0 - smoothstep(0.0, 0.14, max(ob.max.y - world.y, 0.0));
                let damp_ret = 1.0 - smoothstep(0.0, 0.52, h_ret);
                let moss_n = st_noise(vec2<f32>(wall_u * 1.7, h_ret * 2.1) + seed * 4.3);
                let moss = smoothstep(0.55, 0.85, moss_n + joint * 0.35 + damp_ret * 0.25) * (0.35 + 0.65 * damp_ret);
                alb = mix(alb, alb * vec3<f32>(0.55, 0.66, 0.44), moss * 0.45);
                alb = alb * (1.0 - 0.22 * damp_ret) * (1.0 - 0.12 * top_cap);
                micro_ao = micro_ao * (1.0 - 0.38 * damp_ret);
            }
        } else if (layer == CC0_L_WOODSIDING009 || layer == CC0_L_PLANKS010 || layer == CC0_L_WOODSIDING011) {
            // Clapboard / shingle overlap micro-AO & painted satin sheen contrast (matte in lap crevice).
            let lap = 1.0 - smoothstep(lx.z - 0.16, lx.z + 0.05, t.h);
            var sheen = select(0.80, 0.70, paint < 0.45); // fresher paint reads crisper satin
            if (SF_AAA_DETAIL) {
                sheen = select(0.76, 0.66, paint < 0.48);
                micro_tn.y = micro_tn.y * 1.12;
            }
            micro_rough = mix(micro_rough * sheen, 1.20, lap);
            micro_ao = micro_ao * (1.0 - select(0.28, 0.38, SF_AAA_DETAIL) * lap * keep_j);
        }
    }
    // Lived-in SF built-up flat-roof PBR articulation (`05a_hills_vista`, kit & exterior Blender roofs):
    // rolled torch-down bitumen cap-sheet seams (1.05 m near + 3.4 m architectural panel joints mid-range),
    // tar-mastic repair patches, gravel/ballast drift, drainage ponding soot, rubber service walkways,
    // and bold inward parapet flashing & shadow-gutter AO — reads cleanly from 20 m to 350 m.
    let roof_deck_cap = SF_AAA_DETAIL && n.y > 0.85 && world.y > ob.max.y - 1.8
        && (layer == CC0_L_WHITE_STUCCO || layer == CC0_L_CONCRETE_WALL_008 || layer == CC0_L_WOOD_TEXTURED_CONCRETE);
    if (!vertex_colour && bldg_ext && n.y > 0.65 && (layer == CC0_L_TARRED_GRAVEL || layer == CC0_L_CONCRETE_FLOOR_WORN_001 || roof_deck_cap)) {
        let fw = max(length(dpx), length(dpy));
        let keep_seam = 1.0 - smoothstep(0.04, 0.28, fw);
        let keep_mid = 1.0 - smoothstep(0.35, 1.45, fw);
        let roof_rot = select(0.0, 1.5707963, fract(seed * 0.731) > 0.5);
        let cs = cos(roof_rot);
        let sn = sin(roof_rot);
        let r_uv = vec2<f32>(world.x * cs - world.z * sn, world.x * sn + world.z * cs);
        // Per-roof membrane type: dark weathered tar-and-gravel, warm aggregate ballast, or sun-bleached cool coating
        let r_kind = fract(seed * 0.4173);
        let r_tint = select(
            select(vec3<f32>(0.82, 0.81, 0.80), vec3<f32>(1.04, 0.98, 0.90), r_kind > 0.42),
            vec3<f32>(1.18, 1.19, 1.18),
            r_kind > 0.82,
        );
        alb = alb * r_tint * (0.90 + 0.20 * fract(seed * 0.893));
        // Near rolled bitumen / cap-sheet lap seams (1.05 m strip pitch + 6.2 m cross end-laps)
        let strip_p = fract(r_uv.x / 1.05 + fract(seed * 0.27));
        let seam_d = min(strip_p, 1.0 - strip_p) * 1.05;
        let lap_seam = (1.0 - smoothstep(0.014, 0.048, seam_d)) * keep_seam;
        let cross_p = fract(r_uv.y / 6.2 + floor(r_uv.x / 1.05) * 0.37);
        let cross_seam = (1.0 - smoothstep(0.014, 0.042, min(cross_p, 1.0 - cross_p) * 6.2)) * keep_seam;
        let seam = max(lap_seam, cross_seam);
        // Mid-range 3.4 m membrane panel seams & dark tar mastic repair strips (readable at 80-280 m in 05a!)
        let mid_u = fract(r_uv.x / 3.4 + fract(seed * 0.19));
        let mid_v = fract(r_uv.y / 5.6 + fract(seed * 0.61));
        let mid_du = min(mid_u, 1.0 - mid_u) * 3.4;
        let mid_dv = min(mid_v, 1.0 - mid_v) * 5.6;
        let mid_line = max(1.0 - smoothstep(0.03, 0.14 + fw * 0.45, mid_du), 1.0 - smoothstep(0.03, 0.14 + fw * 0.45, mid_dv)) * keep_mid;
        let panel_tone = (st_hash(floor(vec2<f32>(r_uv.x / 3.4, r_uv.y / 5.6)) + vec2<f32>(seed * 3.1, 1.7)) - 0.5) * 0.14 * keep_mid;
        let mastic = smoothstep(0.68, 0.86, st_noise(r_uv / 4.2 + seed * 6.7)) * keep_mid;
        let roll_tone = (st_hash(vec2<f32>(floor(r_uv.x / 1.05), floor(seed * 97.0))) - 0.5) * 0.10 * (1.0 - smoothstep(0.18, 1.1, fw));
        alb = alb * (1.0 + roll_tone + panel_tone) * (1.0 - 0.30 * seam - 0.22 * mid_line - 0.24 * mastic);
        micro_ao = micro_ao * (1.0 - 0.28 * seam - 0.20 * mid_line);
        micro_rough = mix(micro_rough, 0.84, max(seam, mastic) * 0.45);
        let seam_s = select(-1.0, 1.0, strip_p < 0.5) * lap_seam + select(-1.0, 1.0, mid_u < 0.5) * (1.0 - smoothstep(0.03, 0.14, mid_du)) * keep_mid * 0.5;
        micro_tn.x = micro_tn.x + seam_s * 0.36;
        // Multi-scale aggregate gravel drift & weathered drainage/ponding soot bowls (reads from 40-380 m!)
        let macro_p = st_noise(world.xz / 4.8 + seed * 3.7);
        let drain_p = st_noise(world.xz / 10.5 + seed * 1.3);
        let stain = smoothstep(0.54, 0.84, macro_p * 0.58 + drain_p * 0.42);
        let gravel_drift = smoothstep(0.50, 0.80, st_noise(world.xz / 2.7 + seed * 5.9));
        alb = alb * (1.0 - 0.28 * stain) * (1.0 + 0.16 * gravel_drift);
        micro_rough = micro_rough * (1.0 - 0.08 * stain + 0.08 * gravel_drift);
        // Perimeter parapet coping flashing & shadow-gutter AO along roof bounding edges (0.95 m reach)
        let edge_x = min(world.x - ob.min.x, ob.max.x - world.x);
        let edge_z = min(world.z - ob.min.z, ob.max.z - world.z);
        let d_edge = max(min(edge_x, edge_z), 0.0);
        let flash = 1.0 - smoothstep(0.10, 0.95, d_edge);
        let gutter = 1.0 - smoothstep(0.0, 0.45, d_edge);
        alb = alb * (1.0 - 0.24 * flash - 0.20 * gutter);
        micro_ao = micro_ao * (1.0 - 0.42 * gutter);
    }
    if (vertex_colour) {
        (*s).albedo = mix((*s).albedo, alb, vfade);
        (*s).rough = clamp((*s).rough * mix(1.0, t.rough / max(lx.x, 0.05), 0.7 * vfade), 0.04, 1.0);
    } else {
        (*s).albedo = alb * m.base.rgb * vcol;
        var out_rough = clamp(m.params.x * mix(1.0, micro_rough, 0.85), 0.04, 1.0);
        // Guard dry building flat roofs against mirror-like specular/SSR pool artifacts
        // (both non-metal roofs and weathered metal roof decks stay above `SKY_CINE_SSR_ROUGH.y = 0.50`,
        // excluding playable-house interior floors/counters).
        if ((kind == 5u || (kind == 4u && (*s).env <= 0 && (!SF_HOUSE || (ob.kind & 0xfffffe00u) == 0u))) && n.y > 0.65) {
            out_rough = max(out_rough, select(0.78, 0.62, m.params.y >= 0.25));
        }
        if (kit_skirt) {
            out_rough = max(out_rough, 0.76);
        }
        var out_metal = m.params.y;
        if (SF_AAA_DETAIL && bldg_ext && abs(n.y) < 0.55 && out_metal >= 0.45) {
            // Crisp anodized aluminum/bronze/steel mullions & facade metalwork specular sheen
            out_rough = clamp(out_rough * 0.78, 0.20, 0.68);
            out_metal = max(out_metal, 0.80);
        }
        (*s).rough = out_rough;
        (*s).metal = out_metal;
    }
    (*s).ao = mix((*s).ao, clamp(micro_ao, 0.16, 1.0), vfade);
    (*s).n = cc0_frame_normal(fr, micro_tn, n_str * vfade);
    if (SF_AAA_DETAIL && vertex_colour && (kind == 9u || kind == 10u) && n.y > 0.85 && mode != CC0_MODE_PLAZA && mode != CC0_MODE_SAND
        && (layer == CC0_L_WOOD_TEXTURED_CONCRETE || layer == CC0_L_CONCRETE_WALL_008 || layer == CC0_L_DIRTY_CONCRETE || layer == CC0_L_CONCRETE_FLOOR_WORN_001)) {
        cc0_promenade_scoring(s, world, n, dpx, dpy);
    }
    cc0_wall_hit = true;
    return true;
}

// ---- the ground (terrain) --------------------------------------------------------

// The terrain's colour is the open-space ground's tone (the JS's
// green-surface-tone.js / tile-ground-cover.js tones, mottled) or the
// land-cover tint; it stays the colour. The scans give the ground its
// structure around it: a set chosen by the tone's kind (turf, dry grass,
// understorey, bare earth, hard yard), two sets height-blended under a slow
// field, normalised to mean one, with their relief and roughness.
// (`--no-aerial-ground`) the aerial survey's share of this fragment's ground colour
// (draw.wgsl sets it before the scans; 0 everywhere else).
var<private> hm_ground_w: f32 = 0.0;

// (`--no-aerial-ground`) a cured grass colour of the aerial survey's palette: the hue of the
// meadow's cured blades (green 0.66-0.95 of red, red over 1.25 x blue), which the
// vertex tones' dry-grass test (green within 12 % of red) reads as bare earth.
fn hm_cured(c: vec3<f32>) -> f32 {
    return hm_ground_w * step(0.66 * c.r, c.g) * step(c.g, 0.95 * c.r) * step(1.25 * c.b, c.r);
}

fn cc0_ground_sets(c: vec3<f32>) -> vec3<i32> {
    // (set A, set B, contrast in hundredths)
    let l = dot(c, CC0_LUMA);
    if (l < 0.012) {
        return vec3<i32>(-1, -1, 0); // water and the seabed's dark tone
    }
    if (hm_cured(c) > 0.5) {
        return vec3<i32>(CC0_L_WITHERED_GRASS, CC0_L_PARK_DIRT, 85); // (`--no-aerial-ground`) the survey's cured grass
    }
    let warm = c.r / max(c.b, 1e-4);
    if (c.g > c.r * 1.08 && c.g > c.b * 1.2) {
        if (l > 0.055) {
            return vec3<i32>(CC0_L_GRASS004, CC0_L_LEAFY_GRASS, 90); // lawn and park turf
        }
        return vec3<i32>(CC0_L_FOREST_FLOOR, CC0_L_LEAFY_GRASS, 80); // understorey, scrub
    }
    if (abs(c.r - c.g) < 0.12 * c.g && warm > 1.25) {
        return vec3<i32>(CC0_L_WITHERED_GRASS, CC0_L_PARK_DIRT, 85); // dry grass
    }
    if (c.r > c.g && c.g > c.b && warm > 1.25) {
        return vec3<i32>(CC0_L_PARK_DIRT, CC0_L_GRAVEL_FLOOR_03, 85); // worn dirt, bare earth
    }
    // the neutral paving of the city's yards and lots (ground2.rs: green equal to red, which no
    // mapped tone has): worn concrete, one set (no far hue shift).
    if (CC0_GROUND2_PAVING && c.g >= c.r * 0.999 && c.g <= c.r * 1.06 && c.r >= c.b && c.r <= c.b * 1.2) {
        return vec3<i32>(CC0_L_CONCRETE_FLOOR_WORN_001, CC0_L_CONCRETE_FLOOR_WORN_001, 55);
    }
    return vec3<i32>(CC0_L_GRAVEL_FLOOR_03, CC0_L_PARK_DIRT, 55); // hard yards, courts, lots
}

// The anti-tiling phase: turned 0.62 rad, scaled 0.91.
fn cc0_turn(q: vec2<f32>) -> vec2<f32> {
    return vec2<f32>(0.8139 * q.x - 0.5810 * q.y, 0.5810 * q.x + 0.8139 * q.y) * 0.91;
}

fn cc0_ground_tap(world: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, l: i32, off: f32, turn: bool) -> Cc0Tap {
    let inv = cc0_linv(l);
    let uv = world.xz * inv + off;
    let gx = dpx.xz * inv;
    let gy = dpy.xz * inv;
    if (!turn) {
        // The terrain (much of it drawn under the streets and lots and covered
        // later): albedo and relief only, the scan's luminance standing in for
        // its height, its roughness and occlusion at their means.
        var q: Cc0Tap;
        q.alb = textureSampleGrad(cc0_albedo, cc0_samp, uv, l, gx, gy);
        q.n = textureSampleGrad(cc0_normal, cc0_samp, uv, l, gx, gy).xy * 2.0 - 1.0;
        let lm = cc0_lmean(l);
        q.alb = vec4<f32>(q.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), q.alb.a);
        q.h = clamp(dot(q.alb.rgb, CC0_LUMA) * 0.5, 0.0, 1.0);
        q.rough = 1.0;
        q.ao = 1.0;
        q.metal = 0.0;
        return q;
    }
    var t = cc0_tap(uv, gx, gy, l);
    if (turn && cc0_on(CC0_RUN_TILING) && length(frame.cam_pos.xyz - world) < CC0_EXTRA_FAR) {
        // Anti-tiling: a second phase of the repeat, turned 0.62 rad, scaled and
        // shifted, height-blended over a slow field, so the repeat's grid breaks up.
        let c = 0.8139;
        let sn = 0.5810;
        let t2 = cc0_tap(cc0_turn(uv) + vec2<f32>(0.37, 0.71), cc0_turn(gx), cc0_turn(gy), l);
        let w = clamp((st_noise(world.xz / 7.7 + off * 13.0) - 0.5) * 3.0 + (t2.h - t.h) * 1.5 + 0.5, 0.0, 1.0);
        // Its normal back in the first phase's frame (u, image-up).
        let n2 = vec2<f32>(t2.n.x * c - t2.n.y * sn, t2.n.x * sn + t2.n.y * c);
        t.alb = mix(t.alb, t2.alb, w);
        t.n = mix(t.n, n2, w);
        t.rough = mix(t.rough, t2.rough, w);
        t.ao = mix(t.ao, t2.ao, w);
        t.h = mix(t.h, t2.h, w);
    }
    let lm = cc0_lmean(l);
    t.alb = vec4<f32>(t.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), t.alb.a);
    t.rough = t.rough / max(cc0_lmisc(l).x, 0.05);
    t.ao = t.ao / max(cc0_lmisc(l).y, 0.05);
    return t;
}

// Two light taps of a repeat, the second turned, scaled and shifted, height-blended
// over a slow field: the beach's anti-tiling at four reads.
fn cc0_ground_light2(world: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, l: i32, off: f32) -> Cc0Tap {
    var t = cc0_ground_tap(world, dpx, dpy, l, off, false);
    if (cc0_on(CC0_RUN_TILING) && length(frame.cam_pos.xyz - world) < CC0_EXTRA_FAR * 0.5) {
        let inv = cc0_linv(l);
        let uv = cc0_turn(world.xz * inv + off) + vec2<f32>(0.37, 0.71);
        let gx = cc0_turn(dpx.xz * inv);
        let gy = cc0_turn(dpy.xz * inv);
        let lm = cc0_lmean(l);
        let a2 = textureSampleGrad(cc0_albedo, cc0_samp, uv, l, gx, gy);
        let r2 = textureSampleGrad(cc0_normal, cc0_samp, uv, l, gx, gy).xy * 2.0 - 1.0;
        let alb2 = a2.rgb / max(lm.rgb, vec3<f32>(1e-3));
        let h2 = clamp(dot(alb2, CC0_LUMA) * 0.5, 0.0, 1.0);
        let w = clamp((st_noise(world.xz / 7.7 + off * 13.0) - 0.5) * 3.0 + (h2 - t.h) * 1.5 + 0.5, 0.0, 1.0);
        let c = 0.8139;
        let sn = 0.5810;
        let n2 = vec2<f32>(r2.x * c - r2.y * sn, r2.x * sn + r2.y * c);
        t.alb = vec4<f32>(mix(t.alb.rgb, alb2, w), t.alb.a);
        t.n = mix(t.n, n2, w);
        t.h = mix(t.h, h2, w);
    }
    return t;
}

fn cc0_ground_apply(s: ptr<function, Surface>, n: vec3<f32>, rel: vec3<f32>, rough: f32, ao: f32, tn: vec2<f32>, contrast: f32) {
    // A partly chromatic detail: the tone keeps its hue, the scan brings its own colour variation.
    let l = dot(rel, CC0_LUMA);
    let detail = mix(vec3<f32>(l), rel, 0.6);
    (*s).albedo = (*s).albedo * max(mix(vec3<f32>(1.0), detail, contrast), vec3<f32>(0.0));
    (*s).rough = clamp((*s).rough * mix(1.0, rough, 0.8), 0.15, 1.0);
    (*s).ao = clamp((*s).ao * mix(1.0, ao, 0.8), 0.3, 1.0);
    // Planar relief: u along +x, image-up along -z (orthonormal fallback on vertical cliffs).
    let vx = vec3<f32>(1.0, 0.0, 0.0) - n * n.x;
    let ta = select(normalize(cross(vec3<f32>(0.0, 1.0, 0.0), n)), normalize(vx), dot(vx, vx) > 1e-4);
    let tb = normalize(cross(n, ta));
    let z = sqrt(max(0.0, 1.0 - dot(tn, tn)));
    (*s).n = normalize(ta * tn.x + tb * tn.y + n * z);
}

// sf:COVER+
// Multi-scale pixel-footprint-filtered hillside micro-relief heightfield in [0, 1],
// breaking up smooth 2 m aerial / 8 m vertex terrain at 80-700 m without shimmering.
fn cc0_hill_h(p: vec2<f32>, k5: f32, k15: f32, k04: f32) -> f32 {
    let w0 = vec2<f32>(st_noise(p / 15.0 + vec2<f32>(1.7, 5.3)), st_noise(p / 15.0 + vec2<f32>(8.9, 2.1))) - 0.5;
    let q = p + w0 * 2.1;
    var h = 0.5;
    // Drive normal relief from mid/fine earth, tussock and scree scales (3.4 m -> 0.38 m)
    // rather than coarse 14 m billows, keeping slopes crisp and matte instead of pillowy.
    h = h + (st_noise(q / 3.4 + vec2<f32>(11.2, 4.7)) - 0.5) * 0.34 * k5;
    if (k15 > 0.0) {
        let q2 = vec2<f32>(q.x * 0.81 - q.y * 0.58, q.x * 0.58 + q.y * 0.81);
        h = h + (st_noise(q2 / 1.25 + vec2<f32>(6.3, 13.8)) - 0.5) * 0.32 * k15;
    }
    if (k04 > 0.0) {
        h = h + (st_noise(q / 0.38 + vec2<f32>(19.1, 2.6)) - 0.5) * 0.22 * k04;
    }
    return clamp(h, 0.0, 1.0);
}

// Organic ridged-multifractal Franciscan cliff rock (folded greywacke / sandstone /
// chert outcrops and irregular tectonic fractures) on a vertical face plane
// `uv = (horizontal_m, world_y_m)`. No periodic modulo courses.
// Returns (luma_factor, crevice_ao, height, warmth).
fn cc0_cliff_strata(uv: vec2<f32>, fw: f32) -> vec4<f32> {
    let k_mid = 1.0 - smoothstep(0.22, 1.1, fw);
    let k_fine = 1.0 - smoothstep(0.06, 0.30, fw);
    // Two-scale domain warp breaks straight bands into folded geological bedding.
    let w1 = vec2<f32>(
        st_noise(uv / 8.5 + vec2<f32>(2.3, 6.7)),
        st_noise(uv / 8.5 + vec2<f32>(11.4, 3.1))
    ) - 0.5;
    let w2 = vec2<f32>(
        st_noise(uv / 2.7 + vec2<f32>(5.8, 1.9)),
        st_noise(uv / 2.7 + vec2<f32>(9.3, 8.2))
    ) - 0.5;
    let p = uv + w1 * 2.4 + w2 * (0.65 * k_mid);
    // Dipping folded strata (incommensurate scales, never periodic brick courses).
    let sy = p.y + 0.28 * p.x;
    let bed_a = st_noise(vec2<f32>(p.x / 11.0 + 1.3, sy / 2.9 + 4.1));
    let bed_b = st_noise(vec2<f32>(p.x / 4.7 + 5.7, sy / 1.05 + 8.3));
    // Ridged noise along two non-orthogonal fracture planes for angular rock crevices.
    let f1_p = vec2<f32>(p.x * 0.92 - p.y * 0.39, p.x * 0.39 + p.y * 0.92);
    let f2_p = vec2<f32>(p.x * 0.61 + p.y * 0.79, -p.x * 0.79 + p.y * 0.61);
    let r1 = abs(st_noise(f1_p / 3.1 + vec2<f32>(3.4, 7.1)) * 2.0 - 1.0);
    let r2 = abs(st_noise(f2_p / 1.7 + vec2<f32>(8.2, 2.5)) * 2.0 - 1.0);
    let crev1 = (1.0 - smoothstep(0.0, 0.22, r1)) * k_mid;
    let crev2 = (1.0 - smoothstep(0.0, 0.18, r2)) * k_mid;
    let crack = max(crev1 * 0.85, crev2 * 0.70);
    // Fine craggy rock grain.
    let fine = st_noise(p / 0.48 + vec2<f32>(14.2, 5.8)) * k_fine + 0.5 * (1.0 - k_fine);
    let h = clamp(0.54 + (bed_a - 0.5) * 0.28 + (bed_b - 0.5) * 0.26 * k_mid + (fine - 0.5) * 0.18 - crack * 0.30, 0.0, 1.0);
    let lum = (0.80 + 0.34 * bed_a) * mix(1.0, 0.84 + 0.32 * bed_b, k_mid) * mix(1.0, 0.88 + 0.24 * fine, k_fine) * (1.0 - 0.28 * crack);
    let ao = clamp(1.0 - 0.36 * crack - 0.12 * (1.0 - bed_b) * k_mid, 0.52, 1.0);
    let warm = clamp(bed_a * 0.65 + bed_b * 0.35, 0.0, 1.0);
    return vec4<f32>(lum, ao, h, warm);
}

// Steep-face rock scan on the face's dominant vertical plane (`zy` or `xy`), with
// a rotated second phase inside 160 m to prevent repeat tiling on cliffs.
fn cc0_cliff_scan(world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, dist: f32) -> Cc0Tap {
    let l = select(CC0_L_GRAVEL_FLOOR_03, CC0_L_SEASIDE_ROCK, GG3_MATERIALS);
    let inv = cc0_linv(l);
    let ew = abs(n.x) >= abs(n.z);
    let p = select(vec2<f32>(world.x, -world.y), vec2<f32>(world.z, -world.y), ew);
    let gx = select(vec2<f32>(dpx.x, -dpx.y), vec2<f32>(dpx.z, -dpx.y), ew) * inv;
    let gy = select(vec2<f32>(dpy.x, -dpy.y), vec2<f32>(dpy.z, -dpy.y), ew) * inv;
    let uv = p * inv;
    var t = cc0_tap2(uv, gx, gy, l);
    let lm = cc0_lmean(l);
    t.alb = vec4<f32>(t.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), t.alb.a);
    t.h = clamp(dot(t.alb.rgb, CC0_LUMA) * 0.5, 0.0, 1.0);
    if (cc0_on(CC0_RUN_TILING) && dist < 160.0) {
        let uv2 = cc0_turn(uv) + vec2<f32>(0.43, 0.29);
        let t2 = cc0_tap2(uv2, cc0_turn(gx), cc0_turn(gy), l);
        let a2 = t2.alb.rgb / max(lm.rgb, vec3<f32>(1e-3));
        let h2 = clamp(dot(a2, CC0_LUMA) * 0.5, 0.0, 1.0);
        let w = clamp((st_noise(p / 8.5 + 3.1) - 0.5) * 3.0 + (h2 - t.h) * 1.4 + 0.5, 0.0, 1.0);
        let c = 0.8139;
        let sn = 0.5810;
        let n2 = vec2<f32>(t2.n.x * c - t2.n.y * sn, t2.n.x * sn + t2.n.y * c);
        t.alb = vec4<f32>(mix(t.alb.rgb, a2, w), t.alb.a);
        t.n = mix(t.n, n2, w);
        t.h = mix(t.h, h2, w);
    }
    return t;
}

// Apply multi-scale hillside micro-relief and steep-cliff Franciscan rock strata/scans
// (`--ground-cover`), eliminating smooth mid-range blobs and planar-XZ cliff smearing.
fn cc0_ground_relief(s: ptr<function, Surface>, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, dist: f32, base_alb: vec3<f32>) {
    let fw = max(length(dpx), length(dpy));
    let far_m = 1.0 - smoothstep(700.0, 1400.0, dist);
    if (far_m <= 0.0) {
        return;
    }
    let k5 = 1.0 - smoothstep(0.55, 1.8, fw);
    let k15 = 1.0 - smoothstep(0.16, 0.55, fw);
    let k04 = 1.0 - smoothstep(0.05, 0.16, fw);
    let rock_w = smoothstep(0.76, 0.44, n.y);

    // 1. Mid- and fine-scale hillside grain and subtle matte surface-gradient normal relief.
    if (rock_w < 0.99 && k5 > 0.0) {
        let eps = clamp(fw * 1.25, 0.25, 2.0);
        let h0 = cc0_hill_h(world.xz, k5, k15, k04);
        let hx = cc0_hill_h(world.xz + vec2<f32>(eps, 0.0), k5, k15, k04);
        let hz = cc0_hill_h(world.xz + vec2<f32>(0.0, eps), k5, k15, k04);
        let gx_h = (hx - h0) / eps;
        let gz_h = (hz - h0) / eps;
        let grain_w = (1.0 - rock_w) * far_m;
        let mid_boost = mix(0.55, 1.0, smoothstep(60.0, 160.0, dist));
        let macro_v = st_noise(world.xz / 13.0 + vec2<f32>(4.2, 9.7)) - 0.5;
        let alb_mod = (1.0 + (h0 - 0.5) * 0.40 * mid_boost * grain_w) * (1.0 + macro_v * 0.14 * grain_w);
        (*s).albedo = (*s).albedo * clamp(alb_mod, 0.74, 1.26);
        (*s).ao = clamp((*s).ao * mix(1.0, 0.88 + 0.22 * h0, grain_w * 0.8), 0.40, 1.0);
        (*s).rough = clamp(max((*s).rough, 0.91 - 0.05 * h0), 0.86, 0.98);
        let vx = vec3<f32>(1.0, 0.0, 0.0) - n * n.x;
        let ta = select(normalize(cross(vec3<f32>(0.0, 1.0, 0.0), n)), normalize(vx), dot(vx, vx) > 1e-4);
        let tb = normalize(cross(n, ta));
        let bump = 0.85 * grain_w * mid_boost;
        (*s).n = normalize((*s).n + (-ta * gx_h + tb * gz_h) * bump);
    }

    // 2. Steep embankments & cliffs (> 40 deg): organic triplanar Franciscan rock strata
    // and dominant-axis scanned rock relief, replacing vertically smeared planar-XZ projections.
    if (rock_w > 0.005) {
        let wx = n.x * n.x / max(n.x * n.x + n.z * n.z, 1e-4);
        let eps_r = clamp(fw * 1.35, 0.20, 1.8);
        var st = vec4<f32>(0.0);
        var st_u = 0.0;
        var st_v = 0.0;
        if (wx > 0.01) {
            let p_ew = vec2<f32>(world.z, world.y);
            let s0 = cc0_cliff_strata(p_ew, fw);
            let su = cc0_cliff_strata(p_ew + vec2<f32>(eps_r, 0.0), fw).z;
            let sv = cc0_cliff_strata(p_ew + vec2<f32>(0.0, eps_r), fw).z;
            st = st + s0 * wx;
            st_u = st_u + ((su - s0.z) / eps_r) * wx;
            st_v = st_v + ((sv - s0.z) / eps_r) * wx;
        }
        if (wx < 0.99) {
            let wz = 1.0 - wx;
            let p_ns = vec2<f32>(world.x, world.y);
            let s0 = cc0_cliff_strata(p_ns, fw);
            let su = cc0_cliff_strata(p_ns + vec2<f32>(eps_r, 0.0), fw).z;
            let sv = cc0_cliff_strata(p_ns + vec2<f32>(0.0, eps_r), fw).z;
            st = st + s0 * wz;
            st_u = st_u + ((su - s0.z) / eps_r) * wz;
            st_v = st_v + ((sv - s0.z) / eps_r) * wz;
        }
        // Anchor cliff rock luminance to the local terrain so shaded and sunlit faces harmonize.
        let base_l = clamp(dot(base_alb, CC0_LUMA), 0.075, 0.22);
        let greywacke = vec3<f32>(0.155, 0.148, 0.132);
        let sandstone = vec3<f32>(0.190, 0.158, 0.122);
        let chert = vec3<f32>(0.172, 0.120, 0.095);
        var rock_pal = mix(greywacke, sandstone, smoothstep(0.25, 0.75, st.w));
        rock_pal = mix(rock_pal, chert, smoothstep(0.68, 0.92, st.w) * 0.45);
        let pal_l = max(dot(rock_pal, CC0_LUMA), 1e-3);
        let anchor_l = mix(pal_l, base_l, 0.45);
        var rock_alb = rock_pal * (anchor_l / pal_l) * st.x;
        var rock_ao = st.y;
        var rock_rough = clamp(0.93 - 0.07 * st.z, 0.84, 0.98);

        // Dominant-axis face tangent frame (tu horizontal along cliff, tv up along cliff).
        let ew = abs(n.x) >= abs(n.z);
        let raw_u = select(vec3<f32>(1.0, 0.0, 0.0) - n * n.x, vec3<f32>(0.0, 0.0, 1.0) - n * n.z, ew);
        let tu = normalize(raw_u);
        let tv = normalize(vec3<f32>(0.0, 1.0, 0.0) - n * n.y);
        var rock_n = normalize(n + (-tu * st_u - tv * st_v) * (1.25 * far_m));

        let rock_near = 1.0 - smoothstep(180.0, 280.0, dist);
        if (rock_near > 0.0) {
            let tr = cc0_cliff_scan(world, n, dpx, dpy, dist);
            let rl = dot(tr.alb.rgb, CC0_LUMA);
            let rdet = mix(vec3<f32>(rl), tr.alb.rgb, 0.50);
            rock_alb = rock_alb * clamp(mix(vec3<f32>(1.0), rdet, 0.85 * rock_near), vec3<f32>(0.50), vec3<f32>(1.55));
            let tn = tr.n * (0.72 * rock_near);
            let tz = sqrt(max(0.0, 1.0 - dot(tn, tn)));
            rock_n = normalize(tu * tn.x + tv * tn.y + rock_n * tz);
        }

        let rw = rock_w * far_m;
        (*s).albedo = mix((*s).albedo, rock_alb, rw);
        (*s).n = normalize(mix((*s).n, rock_n, rw));
        (*s).ao = clamp(mix((*s).ao, (*s).ao * rock_ao, rw), 0.42, 1.0);
        (*s).rough = mix((*s).rough, rock_rough, rw);
    }
}
// sf:end

fn cc0_ground(s: ptr<function, Surface>, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    // Not the seabed (seen through the water, if at all, as before).
    if (!cc0_on(CC0_RUN_GROUND) || world.y < LM_SEA_LEVEL_Y - 0.5) {
        return;
    }
    let sets = cc0_ground_sets((*s).albedo);
    if (sets.x < 0) {
        return;
    }
    let base_alb = (*s).albedo;
    let dist = length(frame.cam_pos.xyz - world);
    let near = select(1.0 - smoothstep(130.0, 190.0, dist), 1.0 - smoothstep(260.0, 420.0, dist), SF_AAA_DETAIL);
    let slope = 1.0 - clamp(n.y, 0.0, 1.0);
    // (`--aaa-buildings`) Naturalize synthetic lime/emerald park turf toward coastal California
    // olive-sage & sun-dappled dry-gold, break up bare urban hillside yards/backlots out to 950 m,
    // and texture steep neutral-grey urban cut-banks/slopes (`05a` & `05b` terrain blobs).
    var aaa_tn = vec2<f32>(0.0);
    let aaa_paved = SF_AAA_DETAIL && n.y > 0.94 && (sets.x == CC0_L_CONCRETE_FLOOR_WORN_001 || (sets.x == CC0_L_GRAVEL_FLOOR_03 && world.y < LM_SEA_LEVEL_Y + 9.0));
    if (SF_AAA_DETAIL && !aaa_paved) {
        let fw_g = max(length(dpx), length(dpy));
        let mid_fade = 1.0 - smoothstep(550.0, 1050.0, dist);
        let fine_fade = 1.0 - smoothstep(0.18, 0.95, fw_g);
        let micro_fade = 1.0 - smoothstep(0.03, 0.24, fw_g);
        // Domain-warped organic multi-scale noise (eliminates wavy ripples while keeping crisp hillside texture)
        let w0 = vec2<f32>(st_noise(world.xz / 7.5 + vec2<f32>(2.3, 8.1)), st_noise(world.xz / 7.5 + vec2<f32>(11.9, 4.7))) - 0.5;
        let p_org = world.xz + w0 * 3.4;
        let n_m = st_noise(p_org / 13.5 + vec2<f32>(4.1, 7.3));
        let n_s = st_noise(p_org / 3.8 + vec2<f32>(11.7, 2.9));
        let n_f = st_noise(p_org / 1.15 + vec2<f32>(3.3, 19.1));
        let n_hi = st_noise(world.xz * 2.6 + vec2<f32>(7.1, 13.7));
        let n_grit = st_noise(world.xz * 7.8 + vec2<f32>(19.3, 5.4));
        if (sets.x == CC0_L_GRASS004) {
            // Pull overly vivid lime park/yard vertex tones into coastal SF olive-sage & sunlit dry turf,
            // with organic garden-bed / shrubbery / mulch / soil breakup so hillside yards (`05a`) read natural.
            let l_g = dot((*s).albedo, CC0_LUMA);
            let olive = vec3<f32>(l_g * 0.90, l_g * 0.96, l_g * 0.62);
            (*s).albedo = mix((*s).albedo, olive, 0.36);
            let yard_cell = floor((world.xz + w0 * 2.2) / 9.5);
            let yard_h = st_hash(yard_cell + vec2<f32>(6.1, 3.7));
            let shrub = smoothstep(0.54, 0.80, n_s * 0.58 + n_f * 0.42);
            let dry_bed = smoothstep(0.54, 0.82, n_m * 0.55 + (1.0 - n_s) * 0.45);
            let garden_tint = mix(
                mix(vec3<f32>(0.85, 0.90, 0.76), vec3<f32>(1.22, 1.08, 0.80), dry_bed),
                vec3<f32>(0.56, 0.66, 0.46),
                shrub * (0.50 + 0.35 * yard_h),
            );
            let parcel_var = 0.86 + 0.28 * yard_h;
            let clump = 1.0 + ((n_s - 0.5) * 0.32 + (n_f - 0.5) * 0.24 * fine_fade + ((n_hi - 0.5) * 0.22 + (n_grit - 0.5) * 0.16) * micro_fade);
            (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), garden_tint * parcel_var * clump, 0.86 * mid_fade);
            (*s).ao = (*s).ao * (1.0 - 0.20 * shrub * (1.0 - n_f) * mid_fade);
            (*s).rough = max((*s).rough, 0.93);
            if (fine_fade > 0.01) {
                let gx_n = st_noise((p_org + vec2<f32>(0.25, 0.0)) / 1.15 + vec2<f32>(3.3, 19.1)) - n_f;
                let gz_n = st_noise((p_org + vec2<f32>(0.0, 0.25)) / 1.15 + vec2<f32>(3.3, 19.1)) - n_f;
                let gx_h = st_noise((world.xz + vec2<f32>(0.08, 0.0)) * 2.6 + vec2<f32>(7.1, 13.7)) - n_hi;
                let gz_h = st_noise((world.xz + vec2<f32>(0.0, 0.08)) * 2.6 + vec2<f32>(7.1, 13.7)) - n_hi;
                aaa_tn = vec2<f32>(gx_n * 0.48 + gx_h * 0.72 * micro_fade, -(gz_n * 0.48 + gz_h * 0.72 * micro_fade)) * (fine_fade * mid_fade);
            }
        } else if (mid_fade > 0.01) {
            // Urban hillside yards, backlots, earth & scrub: multi-scale garden/soil/shrub/patio breakup
            let lot_cell = floor((world.xz + w0 * 2.0) / 9.5);
            let lot_h = st_hash(lot_cell + vec2<f32>(2.7, 8.3));
            let shrub = smoothstep(0.54, 0.80, n_s * 0.58 + n_f * 0.42);
            let soil_patch = smoothstep(0.52, 0.80, n_m * 0.55 + (1.0 - n_s) * 0.45);
            let yard_tint = mix(
                mix(vec3<f32>(0.80, 0.78, 0.72), vec3<f32>(1.08, 0.98, 0.82), soil_patch),
                vec3<f32>(0.56, 0.65, 0.46),
                shrub * (0.48 + 0.35 * lot_h),
            );
            let lot_var = 0.85 + 0.30 * lot_h;
            let micro = 1.0 + ((n_s - 0.5) * 0.32 + (n_f - 0.5) * 0.24 * fine_fade + ((n_hi - 0.5) * 0.24 + (n_grit - 0.5) * 0.18) * micro_fade);
            (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), yard_tint * lot_var * micro, 0.86 * mid_fade);
            (*s).ao = (*s).ao * (1.0 - 0.20 * shrub * (1.0 - n_f) * mid_fade);
            (*s).rough = max((*s).rough, 0.92);
            if (fine_fade > 0.01) {
                let gx_n = st_noise((p_org + vec2<f32>(0.25, 0.0)) / 1.15 + vec2<f32>(3.3, 19.1)) - n_f;
                let gz_n = st_noise((p_org + vec2<f32>(0.0, 0.25)) / 1.15 + vec2<f32>(3.3, 19.1)) - n_f;
                let gx_h = st_noise((world.xz + vec2<f32>(0.08, 0.0)) * 2.6 + vec2<f32>(7.1, 13.7)) - n_hi;
                let gz_h = st_noise((world.xz + vec2<f32>(0.0, 0.08)) * 2.6 + vec2<f32>(7.1, 13.7)) - n_hi;
                aaa_tn = vec2<f32>(gx_n * 0.48 + gx_h * 0.72 * micro_fade, -(gz_n * 0.48 + gz_h * 0.72 * micro_fade)) * (fine_fade * mid_fade);
            }
        }
        // Steep urban cut-banks & retaining slopes (`slope > 0.12`, e.g. `05b` raw grey hillside wedge):
        // crisp gravelly soil/shale strata, fine pebble tooth, and coastal ivy/moss tufts.
        if (slope > 0.12 && mid_fade > 0.01) {
            let cut_w = smoothstep(0.12, 0.28, slope) * mid_fade;
            let strata = st_noise(vec2<f32>(dot(world.xz, vec2<f32>(0.7, 0.7)) / 1.6, world.y * 3.4 + n_s * 1.2));
            let pebble = n_hi * 0.55 + n_grit * 0.45;
            let ivy = smoothstep(0.56, 0.82, n_s * 0.65 + pebble * 0.35);
            let bank_col = mix(vec3<f32>(0.64, 0.61, 0.54) * (0.72 + 0.52 * strata), vec3<f32>(0.42, 0.50, 0.34), ivy * 0.50);
            (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), bank_col * (0.76 + 0.46 * pebble), cut_w * 0.90);
            (*s).ao = (*s).ao * (1.0 - 0.28 * cut_w * (1.0 - strata));
            (*s).rough = max((*s).rough, 0.93);
            aaa_tn = aaa_tn + vec2<f32>((pebble - 0.5) * 0.62, (strata - 0.5) * 0.58) * cut_w * (0.35 + 0.65 * micro_fade);
        }
    }
    // Macro variation at any distance: set B's hue (at set A's luminance) over
    // a slow field, 40 % of the way (dry patches in turf, bare earth in scrub),
    // its finer octave and the scans only near.
    let ma = cc0_lmean(sets.x);
    let mb = cc0_lmean(sets.y);
    let hue_b = (mb.rgb / max(mb.w, 1e-3)) / max(ma.rgb / max(ma.w, 1e-3), vec3<f32>(1e-3));
// sf:COVER-
    let shift = mix(vec3<f32>(1.0), clamp(hue_b, vec3<f32>(0.4), vec3<f32>(2.5)), 0.4);
// sf:end
// sf:COVER+
    // Where the aerial survey supplies real hillside colour (`hm_ground_w`), suppress
    // the synthetic set-to-set hue shift so hue-threshold boundaries never invert into
    // artificial slate-blue vs rust-orange contour bands.
    let shift = mix(vec3<f32>(1.0), clamp(hue_b, vec3<f32>(0.4), vec3<f32>(2.5)), 0.4 * (1.0 - hm_ground_w));
// sf:end
    let coarse = st_noise(world.xz / 41.0 + 3.3);
    let far_fade = 1.0 - smoothstep(2500.0, 4000.0, dist);
    if (near <= 0.0) {
        let wf = clamp((coarse + slope * 0.8 - 0.62) * 4.0 + 0.5, 0.0, 1.0) * far_fade;
        (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), shift, wf);
        if (SF_AAA_DETAIL && dot(aaa_tn, aaa_tn) > 1e-5) {
            let vx = vec3<f32>(1.0, 0.0, 0.0) - n * n.x;
            let ta = select(normalize(cross(vec3<f32>(0.0, 1.0, 0.0), n)), normalize(vx), dot(vx, vx) > 1e-4);
            let tb = normalize(cross(n, ta));
            let tn_c = clamp(aaa_tn, vec2<f32>(-0.55), vec2<f32>(0.55));
            let z = sqrt(max(0.0, 1.0 - dot(tn_c, tn_c)));
            (*s).n = normalize(ta * tn_c.x + tb * tn_c.y + n * z);
        }
// sf:COVER+
        cc0_ground_relief(s, world, n, dpx, dpy, dist, base_alb);
// sf:end
        return;
    }
    let field = coarse * 0.65 + st_noise(world.xz / 9.0 + 8.1) * 0.35;
    // The terrain is drawn under the streets and lots too (whatever covers it
    // later still ran this): one set's taps where the field is decided, both
    // only in the transition, height-blended (the higher relief wins).
    let w0 = (field + slope * 0.8 - 0.62) * 14.0 + 0.5;
    var ta: Cc0Tap;
    var tb: Cc0Tap;
    var w = 0.0;
    if (w0 <= -1.0) {
// sf:COVER-
        ta = cc0_ground_tap(world, dpx, dpy, sets.x, 0.0, false);
// sf:end
// sf:COVER+
        ta = gg3_ground_tap(world, dpx, dpy, sets.x, 0.0);
// sf:end
        tb = ta;
    } else if (w0 >= 2.0) {
// sf:COVER-
        tb = cc0_ground_tap(world, dpx, dpy, sets.y, 0.37, false);
// sf:end
// sf:COVER+
        tb = gg3_ground_tap(world, dpx, dpy, sets.y, 0.37);
// sf:end
        ta = tb;
        w = 1.0;
    } else {
        ta = cc0_ground_tap(world, dpx, dpy, sets.x, 0.0, false);
        tb = cc0_ground_tap(world, dpx, dpy, sets.y, 0.37, false);
        w = clamp(w0 + (tb.h - ta.h), 0.0, 1.0);
    }
    var rel = mix(ta.alb.rgb, tb.alb.rgb * shift, w);
    if (cc0_on(CC0_RUN_TILING)) {
        rel = rel * (0.9 + 0.2 * st_noise(world.xz / 17.0 + 1.9));
    }
    let out_tn = clamp(mix(ta.n, tb.n, w) * near + aaa_tn, vec2<f32>(-0.75), vec2<f32>(0.75));
    cc0_ground_apply(s, n, rel, mix(ta.rough, tb.rough, w), mix(ta.ao, tb.ao, w), out_tn, f32(sets.z) / 100.0 * near);
// sf:COVER+
    cc0_ground_relief(s, world, n, dpx, dpy, dist, base_alb);
// sf:end
    if (aaa_paved) {
        // Paved waterfront / urban concrete terrain (`w27146063` Embarcadero promenade in `08`):
        // applied after `cc0_ground_apply` so architectural joint grooves & bevelled normals survive intact.
        cc0_promenade_scoring(s, world, n, dpx, dpy);
    }
}

// The terrain surface pass's ground (GG3_MATERIALS; terrain_detail.rs
// `Materials`): a vertex marked GG3_MATERIAL_ALPHA carries its substrate's
// colour (bare soil, or the litter under scrub) and its grass cover share
// (`grass`, the normal's w). The grass is drawn in the season's colour (the
// far layer's green to golden by the look uniform's dryness, eo_look::season)
// over the green or the withered grass scan, the cover's share broken into
// tufts and openings by a fine field; the substrate over the park-dirt scan
// (the forest-floor scan where it is dark litter); steep faces (the
// shading normal under GG3_ROCK_NY) over the coastal rock scan, planar on
// the face's dominant axis, in the substrate's hue a shade darker.
// GG3_ROCK_NY: rock from 41 degrees (cos 0.75), full at 57 (cos 0.55),
// INFERRED: past the angle of repose of loose soil (about 35-40 degrees) a
// face sheds its soil and shows its rock.
const GG3_ROCK_NY: vec2<f32> = vec2<f32>(0.75, 0.55);
// the rock a shade darker than its soil (INFERRED: chert fragments and the
// soil they weather to share a hue; the outcrop's shadowed relief darkens it).
const GG3_ROCK_SHADE: f32 = 0.8;
// The fine ground detail's reach (gg3_terrain), m, and the share of the scans' albedo
// contrast kept beyond it (their mean colour is the rest). INFERRED (see gg3_terrain).
const GG3_FINE_M: vec2<f32> = vec2<f32>(40.0, 110.0);
const GG3_FINE_KEEP: f32 = 0.2;

fn gg3_rock_tap(world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) -> Cc0Tap {
    let l = CC0_L_SEASIDE_ROCK;
    let inv = cc0_linv(l);
    var uv = world.zy * inv;
    var gx = dpx.zy * inv;
    var gy = dpy.zy * inv;
    if (abs(n.z) > abs(n.x)) {
        uv = world.xy * inv;
        gx = dpx.xy * inv;
        gy = dpy.xy * inv;
    }
    if (abs(n.y) > max(abs(n.x), abs(n.z))) {
        uv = world.xz * inv;
        gx = dpx.xz * inv;
        gy = dpy.xz * inv;
    }
    var t = cc0_tap2(uv, gx, gy, l);
    let lm = cc0_lmean(l);
    t.alb = vec4<f32>(t.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), t.alb.a);
    return t;
}

// A ground scan with its repeat broken (the terrain's soil and grass): the
// scan's albedo and normal at its own phase and at a second phase turned 0.62
// rad and scaled 0.91 (cc0_turn, as cc0_ground_tap's anti-tiling), blended
// over a slow 6-14 m field and by the two phases' relief, so the repeat's
// regular grid does not show at 50-150 m. Albedo and normal taps only (as
// cc0_ground_tap without its turn).
fn gg3_ground_tap(world: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, l: i32, off: f32) -> Cc0Tap {
    var t = cc0_ground_tap(world, dpx, dpy, l, off, false);
    let inv = cc0_linv(l);
    let uv = cc0_turn(world.xz * inv + off) + vec2<f32>(0.37, 0.71);
    let gx = cc0_turn(dpx.xz * inv);
    let gy = cc0_turn(dpy.xz * inv);
    var alb = textureSampleGrad(cc0_albedo, cc0_samp, uv, l, gx, gy);
    let lm = cc0_lmean(l);
    alb = vec4<f32>(alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), alb.a);
    let n2r = textureSampleGrad(cc0_normal, cc0_samp, uv, l, gx, gy).xy * 2.0 - 1.0;
    // its normal back in the first phase's frame
    let n2 = vec2<f32>(n2r.x * 0.8139 - n2r.y * 0.5810, n2r.x * 0.5810 + n2r.y * 0.8139);
    let h2 = clamp(dot(alb.rgb, CC0_LUMA) * 0.5, 0.0, 1.0);
    let w = clamp((st_noise(world.xz / 9.7 + off * 13.0 + 5.3) - 0.5) * 3.0 + (h2 - t.h) * 1.5 + 0.5, 0.0, 1.0);
    t.alb = mix(t.alb, alb, w);
    t.n = mix(t.n, n2, w);
    t.h = mix(t.h, h2, w);
    return t;
}

// The second flora pass's codes in the grass byte (negative; terrain_detail.rs):
// -1 to -63 the Battery Spencer knoll's bare chert (its strength), -64 to -127 the
// Baker bluff's serpentinite face. (knoll, bluff) strengths, 0-1.
fn fl2_codes(grass_in: f32) -> vec2<f32> {
    if (!(FL2_KNOLL || FL2_BLUFF) || grass_in > -0.5 / 127.0) {
        return vec2<f32>(0.0);
    }
    let code = -grass_in * 127.0;
    if (code >= 63.5) {
        return vec2<f32>(0.0, select(0.0, clamp((code - 64.0) / 63.0, 0.0, 1.0), FL2_BLUFF));
    }
    return vec2<f32>(select(0.0, clamp((code - 1.0) / 62.0, 0.0, 1.0), FL2_KNOLL), 0.0);
}

// The knoll's eroded chert (FL2_KNOLL): angular chert chips and rubble 5-30 cm
// (field guide 4.1) as cells of a 0.25 m lattice, each its own value, darker
// shale partings between; on the steep cut face rills 1-2 m apart down the fall
// line (FL2_KNOLL_RELIEF): darker, damp-looking floors and the normal bent across
// them. Faded where a pixel spans the feature. Returns the albedo factor; bends `nn`.
fn fl2_knoll(world: vec3<f32>, n: vec3<f32>, fw: f32, k: f32, nn: ptr<function, vec3<f32>>) -> f32 {
    var f = 1.0;
    let kc = (1.0 - smoothstep(0.04, 0.2, fw)) * k;
    if (kc > 0.0) {
        let p = world.xz / 0.25 + vec2<f32>(st_noise(world.xz * 1.7) - 0.5, st_noise(world.xz * 1.7 + 4.1) - 0.5) * 0.8;
        let cell = st_hash(floor(p));
        let e = fract(p);
        let edge = min(min(e.x, 1.0 - e.x), min(e.y, 1.0 - e.y));
        let seam = 1.0 - smoothstep(0.0, 0.12, edge);
        f = f * mix(1.0, (0.72 + 0.5 * cell) * (1.0 - 0.35 * seam), kc);
    }
    let hz = length(n.xz);
    if (FL2_KNOLL_RELIEF && hz > 0.3) {
        let down = n.xz / hz;
        let across = dot(world.xz, vec2<f32>(-down.y, down.x));
        let along = dot(world.xz, down);
        let warp = (st_noise(vec2<f32>(along / 3.0, across / 6.0)) - 0.5) * 1.6;
        let ph = (across + warp) / 1.4;
        let kr = (1.0 - smoothstep(0.3, 1.2, fw)) * k * smoothstep(0.3, 0.6, hz);
        let floor_ = pow(0.5 + 0.5 * cos(ph * 6.2832), 4.0);
        f = f * mix(1.0, 1.0 - 0.3 * floor_, kr);
        let side = sin(ph * 6.2832) * 0.45 * kr;
        let t = normalize(vec3<f32>(-down.y, 0.0, down.x));
        let b = normalize(*nn + t * side);
        if (all(b == b)) {
            *nn = b;
        }
    }
    return f;
}

// The bluff's sheared serpentinite (FL2_BLUFF): scaly, lens-shaped blocks 1-4 m
// along the shear (field guide 4.2: "slick, polished and lens-shaped"; hard blocks
// standing out of a softer sheared matrix) with dark seams and joints, so the face
// reads as fractured rock at 50-200 m and past it as a mottled dark face. In the
// face's own plane (along the strike and up it). Returns the albedo factor.
fn fl2_bluff(world: vec3<f32>, n: vec3<f32>, fw: f32, b: f32) -> f32 {
    let hz = max(length(n.xz), 1e-3);
    let strike = vec2<f32>(-n.z, n.x) / hz;
    let u = dot(world.xz, strike);
    let v = world.y + 0.35 * u; // the shear dips along the strike
    let q = vec2<f32>(u / 3.2, v / 1.1);
    let w = vec2<f32>(st_noise(q * 0.7 + 2.3), st_noise(q * 0.7 + 7.1)) - 0.5;
    let p = q + w * 0.9;
    let lens = st_hash(floor(p));
    let e = fract(p);
    let edge = min(min(e.x, 1.0 - e.x), min(e.y, 1.0 - e.y));
    let kf = 1.0 - smoothstep(0.4, 1.6, fw);
    let seam = (1.0 - smoothstep(0.0, 0.1, edge)) * kf;
    let mottle = 0.7 + 0.6 * st_noise(vec2<f32>(u, v) / 9.0);
    return mix(1.0, mottle, b) * mix(1.0, (0.6 + 0.7 * lens) * (1.0 - 0.6 * seam), b * kf);
}

fn gg3_terrain(s: ptr<function, Surface>, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, grass_in: f32) {
    let dry = clamp(look.tone2.w, 0.0, 1.0);
    let codes = fl2_codes(grass_in);
    let fw = length(dpx) + length(dpy);
    var nk = n;
    if (codes.x > 0.0) {
        // the knoll: cured grass, its rubble and rills over the soil
        (*s).albedo = (*s).albedo * fl2_knoll(world, n, fw, codes.x, &nk);
    }
    if (codes.y > 0.0) {
        (*s).albedo = (*s).albedo * fl2_bluff(world, n, fw, codes.y);
    }
    let sub = (*s).albedo;
    var grass_col = mix(GG3_GRASS_GREEN, GG3_GRASS_GOLDEN, dry);
    var grass = clamp(grass_in, 0.0, 1.0);
    if (codes.x > 0.0) {
        grass = 0.18 * (1.0 - codes.x);
        grass_col = GG3_GRASS_GOLDEN;
    }
    if (codes.y > 0.0) {
        grass = FL2_BLUFF_GRASS * (1.0 - 0.6 * codes.y);
    }
    let dist = length(frame.cam_pos.xyz - world);
    let near = select(1.0 - smoothstep(130.0, 190.0, dist), 1.0 - smoothstep(240.0, 380.0, dist), SF_AAA_DETAIL);
    // the fine detail (the 1-3 m tufts field, the scans' albedo, each a lattice or a 2-3 m
    // repeat) only where it is a few pixels or more: past GG3_FINE_M it gives way to its mean,
    // or its period shows as a regular stipple (INFERRED: at 1920 px and 50-60 degrees a 2.5 m
    // repeat spans under 10 px there)
    let fine = 1.0 - smoothstep(GG3_FINE_M.x, GG3_FINE_M.y, dist);
    let rock = max(smoothstep(GG3_ROCK_NY.x, GG3_ROCK_NY.y, n.y), codes.y);
    let rock_col = sub * GG3_ROCK_SHADE;
    // the cover's share as tufts and openings (a 1-3 m field), the share itself far off
    let field = st_noise(world.xz / 2.3 + 3.7) * 0.6 + st_noise(world.xz / 0.71 + 9.2) * 0.4;
    let tufts = clamp((grass - field) * 3.0 + 0.5, 0.0, 1.0);
    if (!cc0_on(CC0_RUN_GROUND) || near <= 0.0) {
        let gc = mix(grass, tufts, near * fine);
        var far_col = mix(mix(sub, grass_col, gc * (1.0 - rock)), rock_col, rock);
        if (SF_AAA_DETAIL) {
            let mf = 1.0 - smoothstep(500.0, 1200.0, dist);
            let m0 = st_noise(world.xz / 18.0 + vec2<f32>(2.3, 6.1));
            let m1 = st_noise(world.xz / 6.2 + vec2<f32>(9.4, 1.7));
            far_col = far_col * (1.0 + ((m0 - 0.5) * 0.24 + (m1 - 0.5) * 0.16) * mf);
        }
        (*s).albedo = far_col;
        (*s).n = nk;
        return;
    }
    let litter = dot(sub, CC0_LUMA) < 0.075;
    let soil_l = select(CC0_L_PARK_DIRT, CC0_L_FOREST_FLOOR, litter);
    let grass_l = select(CC0_L_LEAFY_GRASS, CC0_L_WITHERED_GRASS, dry > 0.5);
    var ts = gg3_ground_tap(world, dpx, dpy, soil_l, 0.0);
    var tg = ts;
    if (grass > 0.02) {
        tg = gg3_ground_tap(world, dpx, dpy, grass_l, 0.41);
    }
    // the higher relief wins at the cover's edge
    let gw = clamp(mix(grass, tufts, near * fine) + (tg.h - ts.h) * 0.6 * near * fine, 0.0, 1.0) * (1.0 - rock);
    let detail = select(max(fine, GG3_FINE_KEEP), max(fine, 0.62), SF_AAA_DETAIL);
    var rel = mix(mix(vec3<f32>(1.0), ts.alb.rgb, detail) * sub, mix(vec3<f32>(1.0), tg.alb.rgb, detail) * grass_col, gw);
    var tn = mix(ts.n, tg.n, gw);
    if (rock > 0.0) {
        let tr = gg3_rock_tap(world, n, dpx, dpy);
        rel = mix(rel, tr.alb.rgb * rock_col, rock);
        tn = mix(tn, tr.n, rock);
    }
    if (SF_AAA_DETAIL) {
        let fw_t = max(length(dpx), length(dpy));
        let mf_t = 1.0 - smoothstep(420.0, 950.0, dist);
        let kf_t = 1.0 - smoothstep(0.18, 1.10, fw_t);
        let c0 = st_noise(world.xz / 13.0 + vec2<f32>(3.1, 6.7));
        let c1 = st_noise(world.xz / 4.2 + vec2<f32>(8.7, 2.3));
        let c2 = st_noise(world.xz / 1.5 + vec2<f32>(1.9, 14.3));
        let shrub_t = smoothstep(0.54, 0.82, c1 * 0.62 + c2 * 0.38);
        let soil_t = smoothstep(0.56, 0.84, c0 * 0.6 + (1.0 - c1) * 0.4);
        let patch_tint = mix(
            mix(vec3<f32>(0.84, 0.86, 0.78), vec3<f32>(1.18, 1.06, 0.82), soil_t),
            vec3<f32>(0.62, 0.72, 0.50),
            shrub_t * 0.65,
        );
        let breakup = 1.0 + ((c1 - 0.5) * 0.34 + (c2 - 0.5) * 0.28 * kf_t);
        rel = rel * mix(vec3<f32>(1.0), patch_tint * breakup, 0.82 * mf_t);
        let gxt = st_noise((world.xz + vec2<f32>(0.32, 0.0)) / 1.5 + vec2<f32>(1.9, 14.3)) - c2;
        let gzt = st_noise((world.xz + vec2<f32>(0.0, 0.32)) / 1.5 + vec2<f32>(1.9, 14.3)) - c2;
        tn = clamp(tn + vec2<f32>(gxt, -gzt) * (1.25 * kf_t * mf_t), vec2<f32>(-0.78), vec2<f32>(0.78));
    }
    // (cc0_ground_apply multiplies the albedo by the detail: start from one)
    if (codes.x + codes.y > 0.0) {
        // the second flora pass's ground keeps its own chroma: cc0_ground_apply takes the
        // detail 60 % of the way from its luminance, so the colour is pushed out by as much
        // first (the knoll's rust, the bluff's rock and rust measured as albedos).
        let l = dot(rel, CC0_LUMA);
        rel = max((rel - 0.4 * vec3<f32>(l)) / 0.6, vec3<f32>(0.0));
    }
    (*s).albedo = vec3<f32>(1.0);
    cc0_ground_apply(s, nk, rel, 1.0, 1.0, tn * near * detail, 1.0);
    (*s).rough = mix(0.92, 0.85, rock);
}

// landmarks2's beach sand (lm_beach: the tone, drifts, ripples, wrack, damp
// and wet bands) with the dry and the damp sand scans under it by the same
// bands (`shore`: metres inland of the shoreline).
fn cc0_beach(s: ptr<function, Surface>, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, shore: f32) {
    if (!cc0_on(CC0_RUN_GROUND)) {
        return;
    }
    let dist = length(frame.cam_pos.xyz - world);
    let near = 1.0 - smoothstep(130.0, 190.0, dist);
    if (near <= 0.0 || world.y < LM_SEA_LEVEL_Y - 0.3) {
        return;
    }
    let reach = 0.7 * LM_SWASH_REACH_M;
    var damp_band = smoothstep(reach + 5.0, reach - 6.0, shore);
    // the dry-to-damp scan blend's steepness: 3 (the JS hand-over); the height-keyed band's
    // softer, still steep enough that only its transition reads both scans (wd in -0.4..1.4)
    var steep = 3.0;
    if (GG2_SAND) {
        damp_band = gg2_damp(gg2_damp_h(world, shore)) / 0.8; // keyed to the foreshore's height over the sea (shore_surface.wgsl)
        steep = 2.0;
    }
    let damp = max(damp_band, smoothstep(LM_SEA_LEVEL_Y + 0.35, LM_SEA_LEVEL_Y + 0.02, world.y));
    // Dry sand (two phases) above the swash, damp sand (one) in it; each read
    // only where the height blend can reach it.
    let wd = (damp - 0.5) * steep + 0.5;
    var td: Cc0Tap;
    var tw: Cc0Tap;
    if (wd < 1.4) {
        td = cc0_ground_light2(world, dpx, dpy, CC0_L_COAST_SAND_04, 0.0);
    }
    if (wd > -0.4) {
        tw = cc0_ground_tap(world, dpx, dpy, CC0_L_DAMP_BEACH_SAND, 0.53, false);
    }
    if (wd >= 1.4) {
        td = tw;
    }
    if (wd <= -0.4) {
        tw = td;
    }
    let w = clamp(wd + (td.h - tw.h) * 1.0, 0.0, 1.0);
    cc0_ground_apply(s, n, mix(td.alb.rgb, tw.alb.rgb, w), mix(td.rough, tw.rough, w), mix(td.ao, tw.ao, w), mix(td.n, tw.n, w) * near, 0.85 * near);
    lm_beach_swash_wet(s, world); // the swash's wet band over the scans
}

// ---- the street -----------------------------------------------------------------

// The footway, kerb and ramp scan: CC0 concrete (the worn set on the kerbs)
// in place of the JS set, normalised to the JS set's mean so the
// street material's contrast, clamps and tint act on it as on the JS scan.
fn cc0_near(a: vec3<f32>, b: vec3<f32>) -> bool {
    return all(abs(a - b) < vec3<f32>(0.006));
}

fn cc0_street_concrete(f: ptr<function, StTap>, p: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, world: vec3<f32>, cls: u32, mean: vec3<f32>, mean_rough: f32, mean_ao: f32, tint: vec3<f32>, run_walk: bool) {
    let kerb = cls == SC_KERB_FACE || cls == SC_KERB_TOP;
    var la = select(CC0_L_DIRTY_CONCRETE, CC0_L_CONCRETE_FLOOR_WORN_001, kerb);
    // A plaza laid in the street's footway layer (plaza-paving.js; not a run's
    // own walk): its style by its tone, each bay's tone jittered +-5.5 % (the
    // JS plazaUnitTone): brick is warm, stone grey and darker than any walk
    // tint, concrete warmer than the cool walk tint.
    var plaza = false;
    if (cls == SC_FOOTWAY && !run_walk) {
        let warm = (tint.r - tint.b) / max(dot(tint, CC0_LUMA), 1e-3);
        let l = dot(tint, CC0_LUMA);
        let pb = CC0_PLAZA_BRICK;
        let ps = CC0_PLAZA_STONE;
        let pc = CC0_PLAZA_CONCRETE;
        if (warm > 0.5 * (pb.r - pb.b) / max(dot(pb, CC0_LUMA), 1e-3)) {
            la = CC0_L_HERRINGBONE_PAVEMENT;
            plaza = true;
        } else if (l < 1.25 * dot(ps, CC0_LUMA) && abs(warm) < 0.06) {
            la = CC0_L_COBBLESTONE_FLOOR_08;
            plaza = true;
        } else if (warm > 0.5 * (pc.r - pc.b) / max(dot(pc, CC0_LUMA), 1e-3)) {
            la = CC0_L_PATTERNED_CONCRETE_PAVERS;
            plaza = true;
        }
    }
    if (SF_STREET_PBR && plaza) {
        // (`--street-pbr`, street_pbr.wgsl) the pavers' scan stochastically tiled (the random setts),
        // in relief and self-shadowed, through the same post terms as below.
        let pv = sp_pave(la, p, gx, gy, world, la == CC0_L_COBBLESTONE_FLOOR_08);
        // at its material's albedo: the post's 0.92 share of the pattern carries the scale over the tint's concrete base
        let cal = max((sp_pave_cal(la) / max(ST_CONCRETE_BASE, 1e-3) - 0.08) / 0.92, 0.05);
        cc0_p_plaza = vec4<f32>(pv.alb * cal, 0.92);
        cc0_p_n = vec3<f32>(pv.tn, 1.0);
        (*f).albedo = mean;
        (*f).rough = pv.rough * mean_rough;
        (*f).ao = clamp(pv.ao * mean_ao, 0.0, 1.0);
        (*f).tn = vec2<f32>(0.0);
        return;
    }
    let ia = cc0_linv(la);
    let t = cc0_tap(p * ia, gx * ia, gy * ia, la);
    var alb = t.alb.rgb / max(cc0_lmean(la).rgb, vec3<f32>(1e-3));
    var rough = t.rough / max(cc0_lmisc(la).x, 0.05);
    var ao = t.ao / max(cc0_lmisc(la).y, 0.05);
    var tn = vec2<f32>(t.n.x, -t.n.y);
    if (!kerb && !plaza && length(frame.cam_pos.xyz - world) < CC0_EXTRA_FAR * 0.5) {
        // Worn walk (older pours, foot-polished) on a turned phase of the repeat,
        // height-blended under a slow field: variety, and the 3 m repeat's
        // blotches no longer line up.
        let wm = st_noise(world.xz / 13.0 + 5.1);
        {
            let lb = CC0_L_CONCRETE_FLOOR_WORN_001;
            let ib = cc0_linv(lb);
            let tb = cc0_tap2(cc0_turn(p * ib) + 0.21, cc0_turn(gx * ib), cc0_turn(gy * ib), lb);
            let ab = tb.alb.rgb / max(cc0_lmean(lb).rgb, vec3<f32>(1e-3));
            let hb = clamp(dot(ab, CC0_LUMA) * 0.5, 0.0, 1.0);
            let w = clamp((wm - 0.5) * 3.0 + (hb - t.h) * 1.5 + 0.5, 0.0, 1.0);
            alb = mix(alb, ab, w);
            tn = mix(tn, vec2<f32>(tb.n.x, -tb.n.y), w);
        }
    }
    if (plaza) {
        // Pavers past the walk's contrast clamps: the street scan's terms are
        // identity here and the pavers' own pattern multiplies the plaza tone after
        // the composition (cc0_street_post), their relief as the normal.
        cc0_p_plaza = vec4<f32>(alb, 0.92);
        cc0_p_n = vec3<f32>(tn, 1.0);
        (*f).albedo = mean;
        (*f).rough = rough * mean_rough;
        (*f).ao = clamp(ao * mean_ao, 0.0, 1.0);
        (*f).tn = vec2<f32>(0.0);
        return;
    }
    (*f).albedo = alb * mean;
    (*f).rough = rough * mean_rough;
    (*f).ao = clamp(ao * mean_ao, 0.0, 1.0);
    (*f).tn = tn;
}

// The carriageway: cracked asphalt over the JS set under a slow field, more
// along the kerb, the cracks (low relief) showing first.
fn cc0_street_asphalt(f: ptr<function, StTap>, p: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, world: vec3<f32>, kerb: f32, mean: vec3<f32>, mean_rough: f32, mean_ao: f32) {
    if (cc0_on(CC0_RUN_TILING) && length(frame.cam_pos.xyz - world) < CC0_EXTRA_FAR * 0.5) {
        // Surface imperfections: the mottled-dirt scan over the carriageway at
        // a few metres, binder-rich and dusty areas inside each lane's tone.
        let li = CC0_D_SURFACEIMPERFECTIONS008;
        let k = 1.0 / (cc0_dsize(li).x * 2.7);
        let t = textureSampleGrad(cc0_dalbedo, cc0_samp, cc0_turn(world.xz * k) + 0.31, li, cc0_turn(gx * k), cc0_turn(gy * k));
        let rel = dot(t.rgb, CC0_LUMA) / max(cc0_dmean(li).w, 1e-3);
        (*f).albedo = (*f).albedo * mix(1.0, clamp(rel, 0.5, 1.6), 0.22);
        (*f).rough = (*f).rough * mix(1.0, clamp(2.0 - rel, 0.6, 1.4), 0.15);
    }
    var m = st_noise(world.xz / 23.0 + 11.3) * 0.7 + st_noise(world.xz / 6.1 + 2.9) * 0.3;
    if (kerb >= 0.0) {
        m = m + 0.3 * (1.0 - smoothstep(0.5, 2.4, kerb));
    }
    if (m < 0.56 || length(frame.cam_pos.xyz - world) > CC0_EXTRA_FAR * 0.5) {
        return;
    }
    let lc = CC0_L_ROAD_DAMAGED;
    let ic = cc0_linv(lc);
    let t = cc0_tap(p * ic + 0.43, gx * ic, gy * ic, lc);
    let w = clamp((m - 0.6) * 5.0 + (0.55 - t.h) * 1.6, 0.0, 1.0);
    (*f).albedo = mix((*f).albedo, t.alb.rgb / max(cc0_lmean(lc).rgb, vec3<f32>(1e-3)) * mean, w);
    (*f).rough = mix((*f).rough, t.rough / max(cc0_lmisc(lc).x, 0.05) * mean_rough, w);
    (*f).ao = mix((*f).ao, clamp(t.ao / max(cc0_lmisc(lc).y, 0.05) * mean_ao, 0.0, 1.0), w);
    (*f).tn = mix((*f).tn, vec2<f32>(t.n.x, -t.n.y), w);
}

// SF scored sidewalk squares (caMetric 'sidewalk-scoring-grid-sf', the same
// pitch along and across the walk, from the kerb line): tooled joints as
// filtered grooves, each square its own pour tone. `across`: metres from the
// kerb line; `g`: its world-xz gradient (the walk's across direction).
fn cc0_scoring(s: ptr<function, Surface>, rel: vec3<f32>, n_geom: vec3<f32>, across: f32, g: vec2<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let pitch = CC0_SCORING_M;
    let gl = length(g);
    if (pitch <= 0.0 || gl < 0.3) {
        return;
    }
    let nrm = g / gl;
    let tan = vec2<f32>(-nrm.y, nrm.x);
    // Along the walk from the eye (small numbers, smooth), plus the eye's own
    // position reduced to one pitch first: no world-sized value is interpolated.
    let a_eye = dot(frame.cam_pos.xz, tan);
    var k_eye = floor(a_eye / pitch);
    var along = (a_eye - k_eye * pitch) + dot(rel.xz, tan);
    if (SF_WALK_RELIEF) {
        // (`--walk-relief`) anchored on the street tile, as the slabs (street_pbr.wgsl `wr_run`)
        let wr = wr_run(rel + frame.cam_pos.xyz, rel, g, pitch);
        k_eye = wr.k;
        along = wr.along;
    }
    let fa = abs(dot(dpx.xz, tan)) + abs(dot(dpy.xz, tan));
    let fc = abs(dot(dpx.xz, nrm)) + abs(dot(dpy.xz, nrm));
    let fade = 1.0 - smoothstep(pitch * 0.12, pitch * 0.4, max(fa, fc));
    let cell = floor(vec2<f32>(along, across) / pitch) + vec2<f32>(k_eye, 0.0);
    let rnd = st_hash(cell + vec2<f32>(7.1, 3.3));
    // The squares were poured together: their tones differ only faintly; the
    // variation lives inside each slab (mottled dirt, the tooled border, the
    // broom finish, grime held at the joints).
    // (`--walk-relief`) the square's own terms fade at its joints (street_pbr.wgsl `wr_seam`; 1 without)
    let seam = wr_seam(along, across, max(fa, fc));
    (*s).albedo = (*s).albedo * (1.0 + (rnd - 0.5) * 0.025 * fade * seam);
    if (fade <= 0.0) {
        return;
    }
    // Where the fragment is inside its square (0..1 each way), and its distance to the nearest joint.
    let la = fract(along / pitch);
    let lc = fract(across / pitch);
    let dj = min(min(la, 1.0 - la), min(lc, 1.0 - lc)) * pitch;
    let fw = max(fa, fc);
    if (cc0_on(CC0_RUN_DECALS)) {
        // Mottled dirt: the stain scan on each square at its own offset (the joint hides the seam).
        let li = CC0_D_SURFACEIMPERFECTIONS008;
        let size = cc0_dsize(li).x;
        let off = vec2<f32>(st_hash(cell + vec2<f32>(1.7, 0.3)), st_hash(cell + vec2<f32>(9.2, 4.4))) * 3.0;
        let q = vec2<f32>(la, lc) * pitch / size + off;
        let ga2 = vec2<f32>(dot(dpx.xz, tan), dot(dpx.xz, nrm)) / size;
        let gb2 = vec2<f32>(dot(dpy.xz, tan), dot(dpy.xz, nrm)) / size;
        let t = textureSampleGrad(cc0_dalbedo, cc0_samp, q, li, ga2, gb2);
        let mot = clamp(dot(t.rgb, CC0_LUMA) / max(cc0_dmean(li).w, 1e-3), 0.45, 1.6);
        (*s).albedo = (*s).albedo * mix(1.0, mot, (0.22 + 0.16 * rnd) * fade * seam);
        (*s).rough = clamp((*s).rough * mix(1.0, 2.0 - mot, 0.12 * fade), 0.04, 1.0);
    }
    // The tooled border along each joint: troweled smooth (lighter, less rough) inside the broomed field.
    let border = pitch * CC0_TOOLED_EDGE_FRAC;
    let band = (1.0 - smoothstep(border * 0.85, border * 1.15 + fw, dj)) * fade;
    if (!SF_STREET_PBR) {
        // (`--street-pbr` draws the joints as dark recessed grooves instead: no lighter, glossier border to glint)
        (*s).albedo = (*s).albedo * (1.0 + 0.045 * band);
        (*s).rough = clamp((*s).rough - 0.1 * band, 0.04, 1.0);
    }
    // The broom finish: fine striations across the walk in the field, only where a pixel resolves them.
    let broom_fade = (1.0 - smoothstep(0.004, 0.012, fa)) * (1.0 - band);
    if (broom_fade > 0.0) {
        let st = st_noise(vec2<f32>(la * pitch * 55.0 + rnd * 37.0, lc * pitch * 2.5));
        (*s).albedo = (*s).albedo * (1.0 + (st - 0.5) * 0.07 * broom_fade);
    }
    // Grime held a few centimetres into the slab from each joint.
    let jg = (1.0 - smoothstep(0.0, 0.07 + fw, dj)) * fade;
    (*s).albedo = (*s).albedo * (1.0 - 0.07 * jg);
    // The groove's drawn half-width: a two-hundredth of the pitch (a shading choice, not a standard value).
    let hw = pitch * 0.005;
    let sa = fract(along / pitch + 0.5) - 0.5;
    let sc = fract(across / pitch + 0.5) - 0.5;
    // Each joint its own depth of dirt and wear (some nearly filled), and the
    // tooled line gone soft past a few metres: tooled joints, not drawn lines.
    let ja = 0.45 + 0.55 * st_hash(vec2<f32>(floor(along / pitch + 0.5) + k_eye, 17.3));
    let jc = 0.45 + 0.55 * st_hash(vec2<f32>(floor(across / pitch + 0.5), 29.1));
    let near_j = 1.0 - smoothstep(pitch * 0.02, pitch * 0.12, fw);
    let ga = (1.0 - smoothstep(hw, hw + fa, abs(sa) * pitch)) * ja;
    let gc = (1.0 - smoothstep(hw, hw + fc, abs(sc) * pitch)) * jc;
    let k = max(ga, gc) * fade * (0.35 + 0.65 * near_j);
    if (!SF_WALK_RELIEF) {
        // (`--walk-relief` draws the joints in relief instead, street_pbr.wgsl `wr_joints`)
        (*s).albedo = (*s).albedo * (1.0 - 0.26 * k);
        (*s).ao = (*s).ao * (1.0 - 0.35 * k);
        (*s).rough = min(1.0, (*s).rough + 0.06 * k);
    }
    // The groove's walls lean the normal away from its centre line.
    let ta = normalize(vec3<f32>(tan.x, 0.0, tan.y) - n_geom * dot(vec3<f32>(tan.x, 0.0, tan.y), n_geom));
    let tc = normalize(vec3<f32>(nrm.x, 0.0, nrm.y) - n_geom * dot(vec3<f32>(nrm.x, 0.0, nrm.y), n_geom));
    let lean = ta * (sign(sa) * ga) + tc * (sign(sc) * gc);
    if (!SF_STREET_PBR) {
        (*s).n = normalize((*s).n + lean * 0.45 * fade);
    }
}

// Wide waterfront / Embarcadero promenade concrete (`08_embarcadero_street_closeup`, wide
// footways with saturated kerb gradient `length(g) < 0.3`, non-plaza aprons `in.aux.y < 0.0`,
// and horizontal waterfront concrete decks): anisotropic-safe 1.60 m architectural expansion-joint
// grid, 6.40 m control-joint saw cuts, per-slab pour tone variation, joint silt/AO, bevelled
// normals, and broomed coastal concrete aggregate mottling.
fn cc0_promenade_scoring(s: ptr<function, Surface>, world: vec3<f32>, n_geom: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let pitch = 1.60;
    let fx = abs(dpx.x) + abs(dpy.x);
    let fz = abs(dpx.z) + abs(dpy.z);
    let fw_min = min(fx, fz);
    let fade_x = 1.0 - smoothstep(pitch * 0.22, pitch * 0.72, fx);
    let fade_z = 1.0 - smoothstep(pitch * 0.22, pitch * 0.72, fz);
    let fade = max(fade_x, fade_z);
    let cell = floor(world.xz / pitch);
    let rnd = st_hash(cell + vec2<f32>(5.3, 11.7));
    let batch = st_hash(floor(world.xz / (pitch * 4.0)) + vec2<f32>(2.1, 8.9));
    // Readable slab-to-slab & 6.4 m pour-bay tone variation
    let slab_tone = 1.0 + ((rnd - 0.5) * 0.14 + (batch - 0.5) * 0.10) * (0.45 + 0.55 * fade);
    let slab_warm = vec3<f32>(1.0 + (rnd - 0.5) * 0.030, 1.0, 1.0 - (rnd - 0.5) * 0.036);
    (*s).albedo = (*s).albedo * slab_tone * slab_warm;
    // Broad coastal foot-traffic, salt-air concrete weathering & exposed-aggregate mottle
    let wear = st_noise(world.xz / 3.4 + vec2<f32>(1.9, 6.4)) * 0.55 + st_noise(world.xz / 0.95 + vec2<f32>(8.3, 2.7)) * 0.45;
    (*s).albedo = (*s).albedo * (0.88 + 0.24 * wear);
    (*s).rough = clamp((*s).rough + (0.5 - wear) * 0.14, 0.58, 0.98);
    if (fade <= 0.001) {
        return;
    }
    let fuv = fract(world.xz / pitch);
    let dx_e = min(fuv.x, 1.0 - fuv.x) * pitch;
    let dz_e = min(fuv.y, 1.0 - fuv.y) * pitch;
    // Fine broomed / exposed-aggregate mineral grit inside each slab
    let grit_fade = 1.0 - smoothstep(0.010, 0.055, fw_min);
    if (grit_fade > 0.01) {
        let g_fine = st_noise(world.xz * 22.0 + vec2<f32>(rnd * 17.0, batch * 11.0));
        let g_med = st_noise(world.xz * 6.5 + vec2<f32>(batch * 13.0, rnd * 7.0));
        (*s).albedo = (*s).albedo * (1.0 + ((g_fine - 0.5) * 0.13 + (g_med - 0.5) * 0.09) * grit_fade);
    }
    // Dirt & coastal silt held a few centimetres along expansion joints
    let jg_x = (1.0 - smoothstep(0.0, 0.10 + fx, dx_e)) * fade_x;
    let jg_z = (1.0 - smoothstep(0.0, 0.10 + fz, dz_e)) * fade_z;
    (*s).albedo = (*s).albedo * (1.0 - 0.12 * max(jg_x, jg_z));
    // Primary 1.60 m tooled scoring joints & wider 6.40 m expansion saw-cut control joints
    let sx = fract(world.x / pitch + 0.5) - 0.5;
    let sz = fract(world.z / pitch + 0.5) - 0.5;
    let maj_x = step(abs(fract(world.x / (pitch * 4.0) + 0.5) - 0.5), 0.045);
    let maj_z = step(abs(fract(world.z / (pitch * 4.0) + 0.5) - 0.5), 0.045);
    let hwx = mix(0.012, 0.024, maj_x);
    let hwz = mix(0.012, 0.024, maj_z);
    let jx = 0.62 + 0.38 * st_hash(vec2<f32>(floor(world.x / pitch + 0.5), 13.7));
    let jz = 0.62 + 0.38 * st_hash(vec2<f32>(floor(world.z / pitch + 0.5), 27.3));
    let gx = (1.0 - smoothstep(hwx, hwx + fx * 1.15, abs(sx) * pitch)) * jx * fade_x;
    let gz = (1.0 - smoothstep(hwz, hwz + fz * 1.15, abs(sz) * pitch)) * jz * fade_z;
    let near_x = 1.0 - smoothstep(0.03, 0.24, fx);
    let near_z = 1.0 - smoothstep(0.03, 0.24, fz);
    let dist_s = 1.0 - smoothstep(35.0, 95.0, length(frame.cam_pos.xyz - world));
    let groove = max(gx * (0.48 + 0.52 * near_x), gz * (0.48 + 0.52 * near_z));
    let g_vis = groove * mix(0.28, 1.0, dist_s);
    (*s).albedo = (*s).albedo * (1.0 - 0.42 * g_vis);
    (*s).ao = (*s).ao * (1.0 - 0.48 * g_vis);
    (*s).rough = min(1.0, (*s).rough + 0.10 * g_vis);
    let ta = normalize(vec3<f32>(1.0, 0.0, 0.0) - n_geom * n_geom.x);
    let tc = normalize(vec3<f32>(0.0, 0.0, 1.0) - n_geom * n_geom.z);
    let lean = ta * (sign(sx) * gx * near_x) + tc * (sign(sz) * gz * near_z);
    (*s).n = normalize((*s).n + lean * (0.55 * mix(0.35, 1.0, dist_s)));
}

// Urban intersection junction-pad asphalt (`SC_PAD`, e.g. Embarcadero & Market St foreground in `08`):
// junction pads lack road-run kerb coordinates and wheel-track decals, so add footprint-filtered
// coarse mineral aggregate, turning-traffic tyre-polish & binder patchiness, utility-cut repair
// slabs, and meandering tar-sealed asphalt cracks.
fn cc0_pad_detail(s: ptr<function, Surface>, world: vec3<f32>, n_geom: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let dist = length(frame.cam_pos.xyz - world);
    let fade = 1.0 - smoothstep(75.0, 145.0, dist);
    if (fade <= 0.001) {
        return;
    }
    let fw = max(length(dpx), length(dpy));
    let keep_agg = 1.0 - smoothstep(0.012, 0.065, fw);
    let keep_cr = 1.0 - smoothstep(0.018, 0.12, fw);
    // Broad turning-lane tyre-polish wear & binder-age variation (1.6 m, 5.2 m, 13 m)
    let w_big = st_noise(world.xz / 13.0 + vec2<f32>(3.7, 9.1));
    let w_med = st_noise(world.xz / 4.8 + vec2<f32>(11.2, 2.4));
    let w_sm = st_noise(world.xz / 1.45 + vec2<f32>(6.3, 14.8));
    let wear = w_big * 0.45 + w_med * 0.35 + w_sm * 0.20;
    let tyre_band = smoothstep(0.42, 0.78, w_med * 0.65 + w_sm * 0.35);
    (*s).albedo = (*s).albedo * mix(1.0, (0.82 + 0.36 * wear) * (1.0 - 0.14 * tyre_band), fade);
    (*s).rough = clamp((*s).rough + ((0.5 - wear) * 0.14 - 0.10 * tyre_band) * fade, 0.52, 0.96);
    // Coarse exposed asphalt mineral aggregate grit
    if (keep_agg > 0.01) {
        let g0 = st_noise(world.xz * 19.0 + vec2<f32>(4.1, 8.7));
        let g1 = st_noise(world.xz * 7.2 + vec2<f32>(15.3, 1.9));
        let gx_a = st_noise((world.xz + vec2<f32>(0.016, 0.0)) * 19.0 + vec2<f32>(4.1, 8.7)) - g0;
        let gz_a = st_noise((world.xz + vec2<f32>(0.0, 0.016)) * 19.0 + vec2<f32>(4.1, 8.7)) - g0;
        (*s).albedo = (*s).albedo * (1.0 + ((g0 - 0.5) * 0.22 + (g1 - 0.5) * 0.14) * keep_agg * fade);
        let ta = normalize(vec3<f32>(1.0, 0.0, 0.0) - n_geom * n_geom.x);
        let tc = normalize(vec3<f32>(0.0, 0.0, 1.0) - n_geom * n_geom.z);
        (*s).n = normalize((*s).n + (ta * gx_a + tc * gz_a) * (0.48 * keep_agg * fade));
    }
    // Meandering tar-sealed thermal cracks & paving-lane cold joints (4.2 m warped cells)
    if (keep_cr > 0.01) {
        let warp = vec2<f32>(st_noise(world.xz / 1.8 + vec2<f32>(2.1, 7.3)), st_noise(world.xz / 1.8 + vec2<f32>(9.4, 3.8))) - 0.5;
        let p_c = (world.xz + warp * 1.15) / 4.2;
        let f_c = abs(fract(p_c + 0.5) - 0.5) * 4.2;
        let c_cell = floor(p_c + 0.5);
        let c_show_x = step(0.42, st_hash(c_cell + vec2<f32>(3.1, 17.7)));
        let c_show_z = step(0.46, st_hash(c_cell + vec2<f32>(19.3, 5.9)));
        let cx = (1.0 - smoothstep(0.012, 0.036 + fw * 1.1, f_c.x)) * c_show_x;
        let cz = (1.0 - smoothstep(0.012, 0.036 + fw * 1.1, f_c.y)) * c_show_z;
        let crack = max(cx, cz) * keep_cr * fade;
        (*s).albedo = mix((*s).albedo, (*s).albedo * 0.34, crack);
        (*s).rough = mix((*s).rough, 0.36, crack * 0.80);
        (*s).ao = (*s).ao * (1.0 - 0.35 * crack);
    }
}

// Street verge banks (`ObjectKind::StreetPaint = 7u`, `cls != SC_PAINT`): replaces raw untextured
// flat cream-tan/grey verge triangles (`08` diagonal curb bevel under palms & `05b` sloped verge
// wedge between hillside buildings) with weathered grey concrete/granite coping & damp soil/gravel relief.
fn cc0_verge_bank(s: ptr<function, Surface>, world: vec3<f32>, n: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let dist = length(frame.cam_pos.xyz - world);
    let fade = 1.0 - smoothstep(140.0, 260.0, dist);
    if (fade <= 0.001) {
        return;
    }
    let fr = fa_frame(n);
    let fw = max(length(dpx), length(dpy));
    let keep = 1.0 - smoothstep(0.02, 0.22, fw);
    let slope = 1.0 - clamp(n.y, 0.0, 1.0);
    // Recalibrate bright cream-beige `pal("verge")` into weathered grey SF concrete / granite coping
    // matching `ST_CONCRETE_BASE` luminance (~0.18-0.22 linear) instead of raw bright cream (~0.68).
    let luma = dot((*s).albedo, CC0_LUMA);
    let target_l = select(min(luma * 0.42, 0.21), min(luma * 0.35, 0.16), slope > 0.16);
    let neutral_grey = vec3<f32>(1.01, 0.99, 0.94) * max(target_l, 0.08);
    var alb = mix((*s).albedo, neutral_grey, 0.88 * fade);
    var tn = vec2<f32>(0.0);
    var ao = (*s).ao;
    var rough = max((*s).rough, 0.90);
    let wu = dot(world, fr.t);
    let wv = -dot(world, fr.b);
    if (cc0_on(CC0_RUN_STREET) || cc0_on(CC0_RUN_WALLS)) {
        let lay = select(CC0_L_CONCRETE_FLOOR_WORN_001, CC0_L_GRAVEL_FLOOR_03, slope > 0.20);
        let inv = cc0_linv(lay);
        let uv = vec2<f32>(wu * inv.x, wv * inv.y);
        let gx = vec2<f32>(dot(dpx, fr.t) * inv.x, -dot(dpx, fr.b) * inv.y);
        let gy = vec2<f32>(dot(dpy, fr.t) * inv.x, -dot(dpy, fr.b) * inv.y);
        let t = cc0_tap(uv, gx, gy, lay);
        let lm = cc0_lmean(lay);
        let lx = cc0_lmisc(lay);
        let rel = clamp(t.alb.rgb / max(lm.rgb, vec3<f32>(1e-3)), vec3<f32>(0.42), vec3<f32>(1.55));
        alb = alb * mix(vec3<f32>(1.0), rel, 0.92 * fade);
        ao = ao * mix(1.0, clamp(t.ao / max(lx.y, 0.05), 0.30, 1.0), 0.82 * fade);
        rough = clamp(mix(rough, t.rough / max(lx.x, 0.05) * 0.92, 0.65 * fade), 0.76, 0.98);
        tn = t.n * (1.15 * fade);
    }
    // Multi-scale weathered stone/concrete/soil mottling & cast-curb expansion joints (1.50 m)
    let m0 = st_noise(world.xz / 1.8 + vec2<f32>(4.3, 9.1));
    let m1 = st_noise(world.xz * 4.2 + vec2<f32>(world.y * 3.2, 1.7));
    let m2 = st_noise(world.xz * 12.0 + vec2<f32>(world.y * 7.5, 6.3));
    let bank_var = 0.74 + 0.50 * (m0 * 0.45 + m1 * 0.35 + m2 * 0.20);
    alb = alb * mix(1.0, bank_var, fade);
    if (slope > 0.10) {
        // Steep hillside / curb verge: weathered soil-grit strata, damp crevice shade & subtle moss
        let strata = st_noise(vec2<f32>(wu * 1.1, world.y * 3.8 + m0 * 0.9));
        let moss = smoothstep(0.58, 0.84, m0 * 0.60 + m1 * 0.40) * smoothstep(0.14, 0.36, slope);
        alb = mix(alb, alb * vec3<f32>(0.64, 0.72, 0.52), moss * 0.48 * fade);
        alb = alb * (0.80 + 0.36 * strata);
        tn = tn + vec2<f32>((m1 - 0.5) * 0.55 + (m2 - 0.5) * 0.35, (strata - 0.5) * 0.55) * (fade * (0.35 + 0.65 * keep));
        ao = ao * (1.0 - 0.30 * (1.0 - strata) * fade);
    }
    if (keep > 0.01) {
        // Cast-concrete curb / retaining expansion joints every 1.50 m
        let su = fract(wu / 1.50 + 0.5) - 0.5;
        let du = abs(su) * 1.50;
        let joint = (1.0 - smoothstep(0.008, 0.024 + fw, du)) * keep * fade;
        alb = alb * (1.0 - 0.34 * joint);
        ao = ao * (1.0 - 0.42 * joint);
        tn.x = tn.x + sign(su) * joint * 0.44;
    }
    (*s).albedo = alb;
    (*s).rough = rough;
    (*s).ao = clamp(ao, 0.18, 1.0);
    (*s).n = cc0_frame_normal(fr, tn, 1.15);
}

fn cc0_reset_post() {
    cc0_p_dark = 1.0;
    cc0_p_rough = vec2<f32>(0.0);
    cc0_p_alb = vec4<f32>(0.0);
    cc0_p_n = vec3<f32>(0.0);
    cc0_p_metal = 0.0;
    cc0_p_plaza = vec4<f32>(0.0);
}

// Street decals (cc0_decals.rs): the tile's grid cell under the fragment, each
// decal's oriented rectangle. Scan-stage effects (worn and patched asphalt,
// cracks) change `f` in the JS set's normalised space; the rest (oil, covers,
// gum, stains) is carried to `cc0_street_post`.
fn cc0_street_decals(f: ptr<function, StTap>, world: vec3<f32>, cls: u32, dpx: vec3<f32>, dpy: vec3<f32>, mean: vec3<f32>, mean_rough: f32, mean_ao: f32) {
    if (!cc0_on(CC0_RUN_DECALS) || length(frame.cam_pos.xyz - world) > CC0_EXTRA_FAR) {
        return;
    }
    let tk = vec2<i32>(floor(world.xz / CC0_TILE_M));
    let sx = ((tk.x % CC0_SLOT_SIDE) + CC0_SLOT_SIDE) % CC0_SLOT_SIDE;
    let sz = ((tk.y % CC0_SLOT_SIDE) + CC0_SLOT_SIDE) % CC0_SLOT_SIDE;
    let slot = u32(sx + CC0_SLOT_SIDE * sz);
    let hd = cc0_grid[slot];
    if (bitcast<i32>(hd.x) != tk.x || bitcast<i32>(hd.y) != tk.y || hd.w == 0u) {
        return;
    }
    let local = world.xz - vec2<f32>(tk) * CC0_TILE_M;
    let ci = clamp(vec2<i32>(floor(local / (CC0_TILE_M / f32(CC0_CELLS)))), vec2<i32>(0), vec2<i32>(i32(CC0_CELLS) - 1));
    let cell = cc0_grid[CC0_SLOTS + slot * CC0_CELLS * CC0_CELLS + u32(ci.y) * CC0_CELLS + u32(ci.x)];
    let asphalt = cls == SC_ASPHALT || cls == SC_PAD;
    let gutter = cls == SC_GUTTER;
    let walk = cls == SC_FOOTWAY;
    var wx_edge = 0.0; // weathering: the building-line dirt (DK_WALK_EDGE)
    for (var k = 0u; k < 8u; k = k + 1u) {
        let idx = (cell[k / 2u] >> ((k % 2u) * 16u)) & 0xffffu;
        if (idx == 0xffffu) {
            break;
        }
        let rec = (slot * CC0_MAX_DECALS + idx) * 2u;
        let d0 = cc0_decals[rec];
        let d1 = cc0_decals[rec + 1u];
        let q = world.xz - d0.xy;
        let ax = d0.zw;
        let px = vec2<f32>(-ax.y, ax.x);
        let along = dot(q, ax);
        let across = dot(q, px);
        if (abs(along) > d1.x || abs(across) > d1.y) {
            continue;
        }
        let kind = u32(d1.z + 0.5);
        let seed = d1.w;
        // Decal-space gradients (metres per pixel along / across).
        let gxa = vec2<f32>(dot(dpx.xz, ax), dot(dpx.xz, px));
        let gya = vec2<f32>(dot(dpy.xz, ax), dot(dpy.xz, px));
        if (kind == CC0_DK_WHEEL) {
                if (asphalt) {
                    let w = (1.0 - smoothstep(0.35, 1.0, abs(across) / d1.y)) * smoothstep(d1.x, d1.x - 2.5, abs(along)) * (0.55 + 0.45 * st_noise(vec2<f32>(along / 4.0, seed * 37.0)));
                    let lw = CC0_L_WORN_ASPHALT;
                    let iw = cc0_linv(lw);
                    let t = cc0_tap2(world.xz * iw + seed, dpx.xz * iw, dpy.xz * iw, lw);
                    (*f).albedo = mix((*f).albedo, t.alb.rgb / max(cc0_lmean(lw).rgb, vec3<f32>(1e-3)) * mean, w * 0.8);
                    (*f).tn = mix((*f).tn, vec2<f32>(t.n.x, -t.n.y) * 0.6, w * 0.8);
                    // Polished and rubber-darkened in the tracks.
                    cc0_p_dark = cc0_p_dark * (1.0 - 0.07 * w);
                    cc0_p_rough = vec2<f32>(mean_rough * 0.8, max(cc0_p_rough.y, w * 0.6));
                    if (SF_STREET_WEAR) {
                        // (`--street-wear`, street_pbr.wgsl) the painted lanes' wheel paths drive the street pass's polish and ruts
                        sw_note_wheel(w, along, across, d1.y, seed, px);
                    }
                }
            } else if (kind == CC0_DK_OIL_LINE) {
                if (asphalt && SF_STREET_WEAR) {
                    // (`--street-wear`, street_pbr.wgsl) drips' pools down the lane, not a streak
                    // (under the wet road's film the drips no longer show: the water's surface is the street's)
                    let cov = sw_drips(along, across, d1.y, seed, length(gxa) + length(gya)) * (1.0 - sw_wet());
                    cc0_p_dark = cc0_p_dark * (1.0 - SW_DRIP_DARK * cov);
                    cc0_p_rough = vec2<f32>(mean_rough * 0.8, max(cc0_p_rough.y, cov * 0.6));
                } else if (asphalt) {
                    // Drips down the lane centre: the stain scan's blotches, stretched along the lane and broken up.
                    let li = CC0_D_SURFACEIMPERFECTIONS002;
                    let sz = cc0_dsize(li);
                    let sc = vec2<f32>(sz.x * 1.6, sz.y * 0.5);
                    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, vec2<f32>(along, across) / sc + seed * vec2<f32>(13.0, 7.0), li, gxa / sc, gya / sc).a;
                    let m = smoothstep(0.42, 0.78, a) * (1.0 - smoothstep(0.3, 1.0, abs(across) / d1.y)) * smoothstep(0.35, 0.65, st_noise(vec2<f32>(along / 9.0 + seed * 31.0, 0.5)));
                    cc0_p_dark = cc0_p_dark * (1.0 - 0.32 * m);
                    cc0_p_rough = vec2<f32>(0.32, max(cc0_p_rough.y, m * 0.55));
                    if (wx_level() != 0u) {
                        // weathering (`--grime`): a broad, steadier oil band down the lane centre that reads at 30-100 m.
                        let band = (1.0 - smoothstep(0.1, 1.0, abs(across) / d1.y)) * (0.6 + 0.4 * st_noise(vec2<f32>(along / 6.0 + seed * 31.0, 0.5)));
                        cc0_p_dark = cc0_p_dark * (1.0 - WX_OIL_EXTRA * max(band, m));
                    }
                }
            } else if (kind == CC0_DK_OIL_SPOT || kind == CC0_DK_STAIN) {
                if (asphalt || gutter || (walk && kind == CC0_DK_STAIN)) {
                    // A drip pool (or a spill on the walk): the stain scan's blotches inside a ragged ellipse.
                    let li = CC0_D_SURFACEIMPERFECTIONS002;
                    let sc = cc0_dsize(li).x * 0.5;
                    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, vec2<f32>(along, across) / sc + seed * vec2<f32>(5.3, 9.1), li, gxa / sc, gya / sc).a;
                    let r = length(vec2<f32>(along / d1.x, across / d1.y));
                    let edge = (st_noise(vec2<f32>(along, across) * 3.1 + seed * 17.0) - 0.5) * 0.5;
                    let pool = 1.0 - smoothstep(0.25, 0.85, r + edge);
                    let m = clamp(pool * 0.55 + smoothstep(0.35, 0.7, a) * (1.0 - smoothstep(0.6, 1.0, r)), 0.0, 1.0) * (0.6 + 0.4 * seed);
                    cc0_p_dark = cc0_p_dark * (1.0 - select(0.45, 0.24, kind == CC0_DK_STAIN) * m);
                    cc0_p_rough = vec2<f32>(select(0.28, 0.6, kind == CC0_DK_STAIN), max(cc0_p_rough.y, m * 0.6));
                    if (wx_level() != 0u) {
                        cc0_p_dark = cc0_p_dark * (1.0 - 0.25 * m); // weathering (`--grime`): darker spills and drips
                    }
                }
            } else if (kind == CC0_DK_TYRE) {
                if (asphalt || gutter) {
                    // Rubber laid down by a tyre: the tread scan's imprints (its low relief), compressed
                    // across the tyre, dark and a little glossy, faded in and out along the track.
                    let lt = CC0_D_TIRETRACKS001;
                    let rep = d1.y * 2.0 * cc0_dsize(lt).x / cc0_dsize(lt).y;
                    let uv = vec2<f32>(along / rep + seed * 5.0, clamp(across / (2.0 * d1.y) + 0.5, 0.02, 0.98));
                    let h = textureSampleGrad(cc0_drhm, cc0_samp, uv, lt, gxa / rep, gya / (2.0 * d1.y)).z;
                    let ends = smoothstep(d1.x, d1.x - min(1.2, d1.x * 0.4), abs(along));
                    let broken = 0.45 + 0.55 * st_noise(vec2<f32>(along / 1.7 + seed * 23.0, 1.3));
                    let m = smoothstep(0.62, 0.3, h) * (1.0 - smoothstep(0.55, 1.0, abs(across) / d1.y)) * ends * broken;
                    cc0_p_dark = cc0_p_dark * (1.0 - 0.3 * m);
                    cc0_p_rough = vec2<f32>(mean_rough * 0.62, max(cc0_p_rough.y, m * 0.35));
                }
            } else if (kind == CC0_DK_GRATE) {
                if (asphalt || gutter) {
                    let uv = vec2<f32>(along / (2.0 * d1.x) + 0.5, across / (2.0 * d1.y) + 0.5);
                    let t = cc0_dtap(uv, gxa / (2.0 * d1.x), gya / (2.0 * d1.y), CC0_D_GRATE002);
                    let a = t.alb.a;
                    cc0_p_alb = vec4<f32>(t.alb.rgb * 0.8, max(cc0_p_alb.w, a));
                    cc0_p_rough = vec2<f32>(t.rough, max(cc0_p_rough.y, a));
                    cc0_p_n = vec3<f32>((ax * t.n.x - px * t.n.y) * a, a);
                    cc0_p_metal = max(cc0_p_metal, a * 0.5);
                }
            } else if (kind == CC0_DK_PATCH) {
                if (asphalt || gutter) {
                    // Fresh hot-mix inside a saw cut: the clean set, darker and tighter; a sealed seam on the cut.
                    let lp = CC0_L_CLEAN_ASPHALT;
                    let ip = cc0_linv(lp);
                    let t = cc0_tap(world.xz * ip + seed * 3.0, dpx.xz * ip, dpy.xz * ip, lp);
                    (*f).albedo = t.alb.rgb / max(cc0_lmean(lp).rgb, vec3<f32>(1e-3)) * mean;
                    (*f).tn = vec2<f32>(t.n.x, -t.n.y);
                    (*f).rough = t.rough / max(cc0_lmisc(lp).x, 0.05) * mean_rough;
                    let edge = min(d1.x - abs(along), d1.y - abs(across));
                    let fw = length(gxa) + length(gya);
                    let seam = 1.0 - smoothstep(0.02, 0.02 + fw, abs(edge - 0.03));
                    if (SF_STREET_WEAR) {
                        // (`--street-wear`, street_pbr.wgsl) one pour's tone over every piece of the repair (applied below)
                        sw_patch = 1.0;
                        sw_patch_seam = max(sw_patch_seam, seam);
                    } else {
                        cc0_p_dark = cc0_p_dark * 0.74 * (1.0 - 0.35 * seam);
                    }
                    // (`--street-pbr`: the hot-mix as open-textured as the road round it, no sheen of its own)
                    cc0_p_rough = vec2<f32>(mean_rough * select(0.82, 1.0, SF_STREET_PBR), max(cc0_p_rough.y, 1.0));
                    if (SF_STREET_PBR) {
                        // (`--street-pbr`, street_pbr.wgsl) the saw cut sealed with a bead of binder, drawn as bitumen
                        let ea = d1.x - abs(along) < d1.y - abs(across);
                        let out_dir = select(px * sign(across), ax * sign(along), ea);
                        sp_note_seal(seam, seam, 0.5 + 0.5 * fract(seed * 7.31), (0.03 - edge) / 0.02, 0.02, out_dir);
                    }
                }
            } else if (kind == CC0_DK_CRACK || kind == CC0_DK_WALK_CRACK) {
                if ((asphalt && kind == CC0_DK_CRACK) || (walk && kind == CC0_DK_WALK_CRACK)) {
                    let uv = vec2<f32>(along / (2.0 * d1.x) + 0.5, across / (2.0 * d1.y) + 0.5);
                    let t = cc0_dtap(uv, gxa / (2.0 * d1.x), gya / (2.0 * d1.y), CC0_D_ASPHALTDAMAGE001);
                    let a = t.alb.a * smoothstep(1.0, 0.8, max(abs(along) / d1.x, abs(across) / d1.y));
                    let dm = cc0_dmean(CC0_D_ASPHALTDAMAGE001);
                    (*f).albedo = mix((*f).albedo, (*f).albedo * clamp(t.alb.rgb / max(dm.rgb, vec3<f32>(1e-3)), vec3<f32>(0.2), vec3<f32>(1.3)), a * 0.9);
                    (*f).tn = mix((*f).tn, ax * t.n.x - px * t.n.y, a);
                    (*f).ao = (*f).ao * (1.0 - 0.4 * a * (1.0 - t.h));
                }
            } else if (kind == CC0_DK_MANHOLE || kind == CC0_DK_VAULT) {
                if (asphalt || gutter || walk) {
                    // Two cast-iron sewer patterns by seed; a concrete-filled vault lid beside the kerb.
                    let dl = select(select(CC0_D_MANHOLECOVER001, CC0_D_MANHOLECOVER006, seed > 0.5), CC0_D_MANHOLECOVER003, kind == CC0_DK_VAULT);
                    let uv = vec2<f32>(along / (2.0 * d1.x) + 0.5, across / (2.0 * d1.y) + 0.5);
                    let t = cc0_dtap(uv, gxa / (2.0 * d1.x), gya / (2.0 * d1.y), dl);
                    let a = t.alb.a;
                    cc0_p_alb = vec4<f32>(t.alb.rgb * 0.8, max(cc0_p_alb.w, a));
                    cc0_p_rough = vec2<f32>(t.rough, max(cc0_p_rough.y, a));
                    cc0_p_n = vec3<f32>((ax * t.n.x - px * t.n.y) * a, a);
                    cc0_p_metal = max(cc0_p_metal, a * select(0.55, 0.15, kind == CC0_DK_VAULT));
                }
            } else if (kind == CC0_DK_GUM) {
                if (walk) {
                    // The seed's whole part is the field's density in eighths (cc0_decals.rs: how much the
                    // walk there draws people), its fraction a hash: the scatter, and which gum scan.
                    let dens = clamp(floor(seed) / 8.0, 0.0, 1.0);
                    let rnd = fract(seed);
                    let lg = select(CC0_D_CHEWINGGUM001, CC0_D_CHEWINGGUM002, rnd > 0.5);
                    let sz = cc0_dsize(lg).x;
                    let uv = vec2<f32>(along, across) / sz + vec2<f32>(rnd * 7.0, rnd * 3.0);
                    let t = cc0_dtap(uv, gxa / sz, gya / sz, lg);
                    // Trodden gum: flat grey-black discs, in patches that grow with the field's density.
                    let gpatch = smoothstep(0.78 - 0.33 * dens, 0.95 - 0.2 * dens, st_noise(vec2<f32>(along, across) / 2.3 + rnd * 11.0));
                    var a = t.alb.a * gpatch * 0.6;
                    var c = mix(t.alb.rgb, vec3<f32>(0.06, 0.06, 0.055), 0.75);
                    if (SF_STREET_WEAR) {
                        // (`--street-wear`) the scan's discs thinned in irregular gaps (no even field of
                        // one size: some cut to a trodden fragment) and each stretch its own age,
                        // fresh near black or old and greying toward the concrete
                        let ga = vec2<f32>(along, across);
                        a = a * smoothstep(0.48, 0.62, st_noise(ga / 0.07 + rnd * 7.0)) * (0.6 + 0.4 * st_noise(ga / 0.9 + 2.0));
                        c = mix(c, vec3<f32>(0.14, 0.135, 0.125), smoothstep(0.35, 0.8, st_noise(ga / 0.35 + rnd * 5.0)));
                    }
                    if (SF_PLAZA_SETTS && ss_here > 0.0) {
                        // (`--plaza-setts`) on setts the gum lies in a few trodden clusters, not a disc on every stone
                        a = a * smoothstep(0.6, 0.78, st_noise(vec2<f32>(along, across) / 1.3 + rnd * 3.0));
                    }
                    cc0_p_alb = vec4<f32>(mix(cc0_p_alb.rgb, c, a), max(cc0_p_alb.w, a));
                    cc0_p_rough = vec2<f32>(0.55, max(cc0_p_rough.y, a));
                }
            } else if (kind == CC0_DK_KERB_PAINT) {
                // weathering (`--grime`; placed only with it): the kerb's paint, faded and chipped.
                if ((cls == SC_KERB_FACE || cls == SC_KERB_TOP) && wx_level() != 0u) {
                    let pc = wx_kerb_paint(world, along, d1.x, seed, length(gxa) + length(gya));
                    cc0_p_alb = vec4<f32>(mix(cc0_p_alb.rgb, pc.rgb, pc.w), max(cc0_p_alb.w, pc.w));
                    cc0_p_rough = vec2<f32>(0.7, max(cc0_p_rough.y, pc.w));
                }
            } else if (kind == CC0_DK_WALK_EDGE) {
                // weathering (`--grime`; placed only with it): dirt along the building line, ragged.
                if (walk && wx_level() != 0u) {
                    // (the strips abut span to span: the rag is keyed on the world, the strongest strip wins)
                    let rag = st_noise(world.xz / 0.8 + 3.7) * 0.6 + st_noise(world.xz / 0.27 + 9.1) * 0.4;
                    wx_edge = max(wx_edge, 1.0 - smoothstep(0.1, 1.0, abs(across) / d1.y + (rag - 0.5) * 0.6));
                }
            }
    }
    if (sl_level() != 0u) {
        // street life (`--street-life`, street_life.wgsl; its decals in cells of their own): litter, leaves, grit, marks.
        sl_street_decals(world, cls, slot, ci, dpx, dpy);
    }
    if (wx_edge > 0.0) {
        cc0_p_dark = cc0_p_dark * (1.0 - 0.32 * wx_edge);
    }
    if (SF_STREET_WEAR && sw_patch > 0.0) {
        cc0_p_dark = cc0_p_dark * sw_patch_tone(world) * (1.0 - 0.35 * sw_patch_seam); // (`--street-wear`) the repair's one pour
    }
}

// The decal effects carried past the street material's composition.
fn cc0_street_post(s: ptr<function, Surface>, n_geom: vec3<f32>) {
    (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), cc0_p_plaza.rgb, cc0_p_plaza.w) * cc0_p_dark;
    (*s).rough = mix((*s).rough, cc0_p_rough.x, clamp(cc0_p_rough.y, 0.0, 1.0));
    if (cc0_p_alb.w > 0.0) {
        (*s).albedo = mix((*s).albedo, cc0_p_alb.rgb, clamp(cc0_p_alb.w, 0.0, 1.0));
        (*s).metal = mix((*s).metal, 0.0, cc0_p_alb.w) + cc0_p_metal;
    }
    if (cc0_p_n.z > 0.0) {
        let tn = cc0_p_n.xy;
        let z = sqrt(max(0.0, 1.0 - dot(tn, tn)));
        let nn = normalize(n_geom * z + vec3<f32>(tn.x, 0.0, tn.y));
        (*s).n = normalize(mix((*s).n, nn, clamp(cc0_p_n.z, 0.0, 1.0)));
    }
}

// ---- wall stains under the sills (facade_age.wgsl, kit buildings) ------------

// Run-off below each sill line at the building's own sill rhythm: the
// Leaking scans in columns along the wall, chosen and offset by hash, deeper
// with wear. Returns the albedo multiplier.
fn cc0_wall_stain(world: vec3<f32>, along: f32, local_y: f32, d: FaD, dpx: vec3<f32>, dpy: vec3<f32>, fr_t: vec3<f32>) -> f32 {
    if (!cc0_on(CC0_RUN_STAINS) || d.pitch <= 0.0) {
        return 1.0;
    }
    // The nearest sill line above.
    let k = floor((local_y - d.first_sill) / d.pitch);
    let sill = d.first_sill + (k + 1.0) * d.pitch;
    let below = sill - local_y;
    if (k < -1.0 || below <= 0.0 || below > 1.6) {
        return 1.0;
    }
    let col_w = 2.4;
    let col = floor(along / col_w);
    let h = st_hash(vec2<f32>(col, k) + d.seed * 0.37);
    if (h > 0.4) {
        return 1.0;
    }
    let layer = select(CC0_D_LEAKING001, CC0_D_LEAKING003, h > 0.27);
    let x = (along - col * col_w) / col_w;
    let uv = vec2<f32>(x * 0.85 + h * 0.15, below / 1.6);
    let gx = vec2<f32>(dot(dpx, fr_t) / col_w, -dpx.y / 1.6);
    let gy = vec2<f32>(dot(dpy, fr_t) / col_w, -dpy.y / 1.6);
    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, layer, gx, gy).a;
    // Soft at the column's sides and fading out toward its foot.
    let env = smoothstep(0.0, 0.3, x) * smoothstep(1.0, 0.7, x) * (1.0 - smoothstep(0.5, 1.6, below));
    return 1.0 - a * env * (0.08 + 0.22 * d.wear);
}

// ---- grime at the kerb line and the wall foot, worn marking paint (cc0 v2) ------

// Street dirt along the gutter: the rising-grime scan (ambientCG Leaking008)
// laid across the gutter from the kerb line (its dense foot at the kerb),
// running along the kerb, broken up by a slow field. `kd`: metres from the
// kerb line; `g`: its world-xz gradient.
fn cc0_gutter_grime(s: ptr<function, Surface>, rel: vec3<f32>, kd: f32, g: vec2<f32>, dpx: vec3<f32>, dpy: vec3<f32>) {
    let reach = CC0_GUTTER_GRIME_M;
    let gl = length(g);
    if (kd > reach || gl < 0.3 || !cc0_on(CC0_RUN_DECALS)) {
        return;
    }
    let nrm = g / gl;
    let tan = vec2<f32>(-nrm.y, nrm.x);
    let li = CC0_D_LEAKING008;
    let size = cc0_dsize(li);
    // Along the kerb from the eye (small numbers), the eye reduced to one repeat first.
    let a_eye = dot(frame.cam_pos.xz, tan);
    let k_eye = floor(a_eye / size.x);
    let along = (a_eye - k_eye * size.x) + dot(rel.xz, tan);
    let uv = vec2<f32>(along / size.x, clamp(1.0 - kd / reach, 0.0, 0.995));
    let fa = vec2<f32>(dot(dpx.xz, tan) / size.x, -dot(dpx.xz, nrm) / reach);
    let fb = vec2<f32>(dot(dpy.xz, tan) / size.x, -dot(dpy.xz, nrm) / reach);
    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, li, fa, fb).a;
    let field = 0.5 + 0.5 * st_noise(vec2<f32>((a_eye + dot(rel.xz, tan)) / 6.0, 3.1));
    let m = a * field * (1.0 - smoothstep(reach * 0.6, reach, kd));
    (*s).albedo = (*s).albedo * (1.0 - 0.32 * m);
    (*s).rough = min(1.0, (*s).rough + 0.06 * m);
}

// Splash and road dirt up the kerb face: the same scan, its foot at the gutter
// flow line (`h`: metres above it, eo-street mesh.rs), reaching about a
// standard kerb and a half (caMetric('curb-height-sf-standard')).
fn cc0_kerb_grime(s: ptr<function, Surface>, p: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, h: f32) {
    if (!cc0_on(CC0_RUN_DECALS) || CC0_CURB_H <= 0.0) {
        return;
    }
    let li = CC0_D_LEAKING008;
    let size = cc0_dsize(li);
    let reach = CC0_CURB_H * 1.5;
    let uv = vec2<f32>(p.x / size.x, clamp(1.0 - h / reach, 0.0, 0.995));
    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, li, vec2<f32>(gx.x / size.x, -gx.y / reach), vec2<f32>(gy.x / size.x, -gy.y / reach)).a;
    let m = a * (1.0 - smoothstep(reach * 0.5, reach, h));
    (*s).albedo = (*s).albedo * (1.0 - 0.38 * m);
    (*s).rough = min(1.0, (*s).rough + 0.05 * m);
}

// Worn marking paint. The marking stays the street's geometric line (the
// California standards' widths and patterns, eo-street paint.rs); only its
// wear comes from the scan: the paint inside an ambientCG road-line scan
// (RoadLines004: a scuffed, cracked line with bare gaps) laid along the line.
// `an`: the fragment's across-the-line coordinate (0..1, eo-street mesh.rs),
// whose screen gradient gives the line's direction and width; across, the
// scan's stripe interior is mirrored at its own scale (a 4-6 in line), so a
// wide bar repeats it rather than stretching it. Cracks darken the paint,
// the bare gaps show the asphalt, more on older lines (a slow field).
// `bare_k` scales the scan's holes and its dark cracks (1 as scanned; `--grime`
// keeps less of them: the scan repeats along the line, so its marks would too).
fn cc0_paint_wear(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, an: f32, dpx: vec3<f32>, dpy: vec3<f32>, bare_k: f32) {
    if (!cc0_on(CC0_RUN_DECALS) || an < 0.0) {
        return;
    }
    let dist = length(rel);
    if (dist > CC0_EXTRA_FAR) {
        return;
    }
    let det = dpx.x * dpy.z - dpx.z * dpy.x;
    if (abs(det) < 1e-14) {
        return;
    }
    let g = vec2<f32>(cc0_daux.x * dpy.z - cc0_daux.y * dpx.z, cc0_daux.y * dpx.x - cc0_daux.x * dpy.x) / det * 6.35;
    let gl = length(g);
    if (gl < 0.05) {
        return;
    }
    let nrm = g / gl;
    let tan = vec2<f32>(-nrm.y, nrm.x);
    if (SF_STREET_PBR) {
        sp_paint_edge(s, an, gl, nrm, max(length(dpx), length(dpy))); // (`--street-pbr`) the raised line's edges
    }
    let w0 = CC0_PAINT_STRIPE_M;
    // The scan's stripe interior (u 0.30-0.70) is about 0.4 of its 256 px width; its 1024 px run along v.
    let rep = w0 / 0.4 * 4.0;
    let a_eye = dot(frame.cam_pos.xz, tan);
    let k_eye = floor(a_eye / rep);
    let along = (a_eye - k_eye * rep) + dot(rel.xz, tan);
    let across = clamp(an, 0.0, 1.0) / gl;
    let uv = vec2<f32>(0.30 + 0.40 * cc0_tri(across / w0), along / rep);
    let du = 0.40 / w0;
    let gxu = vec2<f32>(dot(dpx.xz, nrm) * du, dot(dpx.xz, tan) / rep);
    let gyu = vec2<f32>(dot(dpy.xz, nrm) * du, dot(dpy.xz, tan) / rep);
    let li = CC0_D_ROADLINES004;
    let t = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, li, gxu, gyu);
    let age = smoothstep(0.25, 0.85, st_noise(world.xz / 9.0 + 4.7));
    let crack = clamp(1.0 - dot(t.rgb, CC0_LUMA) / max(cc0_dmean(li).w, 0.05), 0.0, 1.0) * (0.4 + 0.6 * age) * bare_k;
    let bare = (1.0 - t.a) * age * bare_k;
    let fade = 1.0 - smoothstep(CC0_EXTRA_FAR * 0.6, CC0_EXTRA_FAR, dist);
    (*s).albedo = mix((*s).albedo * (1.0 - 0.45 * crack * fade), CC0_ASPHALT_TINT * CC0_ASPHALT_ALBEDO, clamp(bare * 0.9 * fade, 0.0, 1.0));
    (*s).rough = mix((*s).rough, 0.85, clamp(max(bare, crack * 0.5) * fade, 0.0, 1.0));
}

// Grime rising from a wall's foot (rain splash, street dirt): the rising-grime
// scan along the wall, its dense foot at the building's base, deeper with
// the building's wear. Returns the albedo multiplier.
fn cc0_wall_base(along: f32, local_y: f32, wear: f32, dpx: vec3<f32>, dpy: vec3<f32>, fr_t: vec3<f32>) -> f32 {
    if (!cc0_on(CC0_RUN_STAINS) || local_y > CC0_WALL_GRIME_M || local_y < -0.3) {
        return 1.0;
    }
    let li = CC0_D_LEAKING008;
    let size = cc0_dsize(li);
    let reach = CC0_WALL_GRIME_M;
    let uv = vec2<f32>(along / size.x, clamp(1.0 - max(local_y, 0.0) / reach, 0.0, 0.995));
    let gx = vec2<f32>(dot(dpx, fr_t) / size.x, -dpx.y / reach);
    let gy = vec2<f32>(dot(dpy, fr_t) / size.x, -dpy.y / reach);
    let a = textureSampleGrad(cc0_dalbedo, cc0_samp, uv, li, gx, gy).a;
    return 1.0 - a * (0.1 + 0.22 * wear) * (1.0 - smoothstep(reach * 0.5, reach, local_y));
}
