// The camera look (eo-look `tone::camera`, `--no-camera-look`): the daylight
// white balance, then the baked table (ISO 12232 SOS placement and the
// ACES 2.0 output transform, sRGB encoded) over a per-channel log2 shaper,
// then the display dither. CAM_* constants and the bindings' numbers are
// generated by look.rs (`camera_wgsl_at`).
@group(CAM_GROUP) @binding(CAM_BIND_LUT) var cam_lut: texture_3d<f32>;
@group(CAM_GROUP) @binding(CAM_BIND_SAMP) var cam_samp: sampler;

fn cam_shaper(v: vec3<f32>) -> vec3<f32> {
    let e = log2(max(v, vec3<f32>(1e-30))) - CAM_LOG2_MID;
    let u = clamp((e - CAM_LO_EV) * CAM_INV_SPAN, vec3<f32>(0.0), vec3<f32>(1.0));
    // zero is the table's first texel (the bake puts black there)
    return select(u, vec3<f32>(0.0), v <= vec3<f32>(0.0));
}

fn finish_camera(radiance: vec3<f32>, pos: vec4<f32>) -> vec4<f32> {
    let c = finish_mesopic(radiance);
    let exposure = look.key.w;
    let cw = vec3<f32>(dot(look.wb[0].xyz, c), dot(look.wb[1].xyz, c), dot(look.wb[2].xyz, c));
    let x = max(cw, vec3<f32>(0.0)) * exposure / 0.6;
    // texel centres: u (N - 1) / N + 0.5 / N
    let uvw = cam_shaper(x) * ((CAM_N - 1.0) / CAM_N) + 0.5 / CAM_N;
    var e = textureSampleLevel(cam_lut, cam_samp, uvw, 0.0).rgb;
    let amp = look.post2.y;
    let n = hash(pos.xy, look.post2.w) + hash(pos.yx * 1.31, look.post2.w + 3.7) - 1.0;
    e = clamp(e + vec3<f32>(n * amp), vec3<f32>(0.0), vec3<f32>(1.0));
    if (look.post2.z > 0.5) {
        e = from_srgb(e);
    }
    return vec4<f32>(e, 1.0);
}
