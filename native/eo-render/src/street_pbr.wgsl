// The street's physically based surface pass (`--street-pbr`, street_pbr.rs;
// off by default). SF_STREET_PBR false (look.rs `ShaderFeatures`) compiles
// every term out: each call site tests the constant, so the frame without the
// switch is the one before it. Constants SP_* are generated by street_pbr.rs
// (street dimensions from the standards table, material values cited there).
//
// It runs on the street surface the earlier stages composed (draw.wgsl
// `street_surface`: the JS ground material, the CC0 scans, the decals and,
// with `--grime`, the weathering), before the wet layer:
//   the carriageway  calibrated to weathered asphalt, one world-anchored tone
//                    field over every lane, polished and rutted wheel paths,
//                    the oil band down each lane's middle, a cold joint at
//                    the pan; the cracks' sealant as bitumen (glossy, proud)
//                    and open cracks in their own shadow; in the wet, soaked
//                    darker, the film filling its fine texture, water standing
//                    in the ruts and birdbaths deeper than what has drained;
//   the gutter pan   poured concrete holding the street's silt, the run-off
//                    standing along its flow line;
//   the kerb         a rounded arris chipped in pieces, the flow line's
//                    concave corner;
//   the walk         slabs each its own pour and tilt, a few replaced or
//                    stained, dark recessed joints, cracked slabs, broken
//                    corners, asphalt repairs;
//   the plazas       the paving's scan stochastically tiled, in relief
//                    (parallax occlusion) and self-shadowed toward the sun
//                    (cc0.wgsl calls `sp_pave`), at its material's albedo;
//   the paint        worn through to the road, cracked and sealed with it,
//                    and wet with the street (draw.wgsl calls `sp_paint_wear`,
//                    `sp_paint_wet`).
// Every detail is filtered to its mean once it is under a few pixels.

const SP_UP: vec3<f32> = vec3<f32>(0.0, 1.0, 0.0);

// The road's across direction (from the kerb-distance gradient), its sign made
// the same on both sides of the crown (as wx_cracks): a frame anchored on the
// world, continuous across the centre line. `ok` false where the gradient is
// not defined (a junction pad: world z).
struct SpFrame {
    ok: bool,
    n: vec2<f32>,
    t: vec2<f32>,
};

fn sp_frame() -> SpFrame {
    var f: SpFrame;
    let g = wx_kerb_grad();
    let gl = length(g);
    f.ok = gl > 0.3;
    var n = vec2<f32>(0.0, 1.0);
    if (f.ok) {
        n = g / gl;
        if (n.y < 0.0 || (n.y == 0.0 && n.x < 0.0)) {
            n = -n;
        }
    }
    f.n = n;
    f.t = vec2<f32>(n.y, -n.x);
    return f;
}

// A horizontal lean of the shading normal (world xz), added to the detail normal.
fn sp_lean(s: ptr<function, Surface>, d: vec2<f32>) {
    (*s).n = normalize((*s).n + vec3<f32>(d.x, 0.0, d.y));
}

// ---- the cracks and their sealant ------------------------------------------------

// The road's cracks under the fragment, noted by the stages that draw them
// (weathering.wgsl `wx_cracks`, cc0.wgsl's patch seams) and drawn as their
// own materials by `sp_crack_materials`: a sealed crack's hot-poured binder
// (cover, age 0 fresh .. 1 oxidised and dusted, the fragment's signed distance
// over the bead's half-width, that half-width in metres) along `sp_seal_dir`
// (the crack's across direction, world xz) with the thick bead's own cover in
// `sp_seal_bead`; an open crack's cover in `sp_crack`.
var<private> sp_seal: vec4<f32> = vec4<f32>(0.0);
var<private> sp_seal_dir: vec2<f32> = vec2<f32>(0.0);
var<private> sp_seal_bead: f32 = 0.0;
var<private> sp_crack: f32 = 0.0;

fn sp_note_seal(k: f32, bead: f32, age: f32, sd: f32, hw: f32, dir: vec2<f32>) {
    if (k > sp_seal.x) {
        sp_seal = vec4<f32>(k, age, sd, hw);
        sp_seal_dir = dir;
        sp_seal_bead = bead;
    }
}

fn sp_note_crack(k: f32) {
    sp_crack = max(sp_crack, clamp(k, 0.0, 1.0));
}

// The noted cracks as materials, on the surface `a` / `rough` / `lean` the
// caller composed (the carriageway, or a marking over it):
//  * sealant: hot-poured rubberised bitumen, its own albedo whatever the road's
//    (black fresh, greying as it oxidises and takes the road's dust) and its
//    own finish: a cast, near-smooth film, glossy fresh and dulled with age, so
//    a low sun or a bright sky down the street draws the "tar snakes" as bright
//    ribbons across a matte road. The overband stands a few millimetres proud
//    as a rounded cap: its sides lean out;
//  * an open crack: its walls hide the sky from its floor (the specular
//    occlusion reads `ao`), so the crack stays dark under the road's sheen.
fn sp_crack_materials(s: ptr<function, Surface>, a: ptr<function, vec3<f32>>, rough: ptr<function, f32>, lean: ptr<function, vec2<f32>>, q: vec2<f32>, fw: f32) {
    if (sp_seal.x > 0.0) {
        let k = clamp(sp_seal.x, 0.0, 1.0);
        // along the bead: dusted and scuffed stretches, and the pour's own wrinkles
        let dust = mix(0.5, st_noise(q / 0.45 + 3.3) * 0.7 + st_noise(q / 0.12 + 8.1) * 0.3, wx_keep(0.12, fw));
        let age = clamp(sp_seal.y + (dust - 0.5) * 0.6, 0.0, 1.0);
        let tone = mix(SP_SEAL_ALBEDO, SP_SEAL_ALBEDO_AGED, age);
        *a = mix(*a, vec3<f32>(tone) * vec3<f32>(1.0, 0.99, 0.97), k);
        *rough = mix(*rough, mix(SP_SEAL_ROUGH, SP_SEAL_ROUGH_AGED, age), k);
        let hw = max(sp_seal.w, 1e-3);
        let x = clamp(sp_seal.z, -1.0, 1.0);
        // h(x) = proud (1 - x^2) over the half-width: the slope 2 proud x / hw
        let wr = (st_noise(q / 0.025 + 1.9) - 0.5) * 0.12 * wx_keep(0.025, fw);
        *lean = *lean + sp_seal_dir * (2.0 * SP_SEAL_PROUD_M * x / hw + wr) * sp_seal_bead * wx_keep(hw, fw);
    }
    if (sp_crack > 0.0) {
        (*s).ao = (*s).ao * (1.0 - SP_CRACK_OCCLUSION * sp_crack);
        *rough = min(1.0, *rough + 0.1 * sp_crack);
    }
}

// ---- the carriageway -----------------------------------------------------------

fn sp_asphalt(s: ptr<function, Surface>, world: vec3<f32>, cls: u32, kd: f32, n_geom: vec3<f32>, fw: f32) {
    let q = world.xz;
    // The earlier composition's tone round the CC0 base (cc0.rs ASPHALT_ALBEDO,
    // the weathered band's lower end), lifted to the band's middle.
    var a = (*s).albedo * (SP_ASPHALT_ALBEDO / CC0_ASPHALT_ALBEDO);
    // One world-anchored field over every lane and across the crown: the
    // binder's oxidation and the street's soiling, three octaves.
    let m1 = st_noise(q / 37.0 + 3.7);
    let m2 = st_noise(q / 9.1 + 9.1);
    let m3 = st_noise(q / 2.3 + 1.3);
    let tone = (m1 - 0.5) * 0.24 + (m2 - 0.5) * 0.14 + (m3 - 0.5) * 0.08 * wx_keep(2.3, fw);
    a = a * (1.0 + tone);
    // older, more oxidised binder greys toward a warm grey-brown; younger stays cooler.
    let ox = smoothstep(0.3, 0.8, m1 * 0.65 + m2 * 0.35);
    a = a * mix(vec3<f32>(0.97, 0.985, 1.02), vec3<f32>(1.05, 1.0, 0.93), ox);
    // Roughness: the composition's variation (scan, sealant, patches) round the binder's.
    var rough = SP_ASPHALT_ROUGH * clamp((*s).rough / ST_ASPHALT_ROUGHNESS, 0.6, 1.18);
    var lean = vec2<f32>(0.0);
    // The relief that holds water (metres below the surface round it): the
    // ruts below, and settled birdbaths over the whole carriageway.
    var dip = SP_BIRDBATH_M * smoothstep(0.6, 0.9, st_noise(q / 4.3 + 7.1)) * (0.6 + 0.4 * st_noise(q / 1.1 + 3.3));
    let g = wx_kerb_grad();
    let gl = length(g);
    var wpath = 0.0; // (`--street-glare`) the wheel paths' polish share
    // the kerb-distance lane model's share: everywhere, or with `--street-wear` only past the decals' reach
    var lane_k = 1.0;
    if (SF_STREET_WEAR) {
        lane_k = smoothstep(CC0_EXTRA_FAR * 0.8, CC0_EXTRA_FAR, length(frame.cam_pos.xyz - world));
    }
    if (cls == SC_ASPHALT && kd >= 0.0 && gl > 0.3) {
        let gn = g / gl; // across, away from the kerb
        let along = dot(q, vec2<f32>(gn.y, -gn.x));
        // The cold joint where the asphalt meets the gutter pan: a dark line of
        // binder and grit, the asphalt's edge worn down toward the pan.
        let gj = kd - ST_GUTTER_WIDTH;
        if (gj > -0.02 && gj < 0.12) {
            let bead = wx_band(abs(gj), 0.006, fw);
            a = a * (1.0 - 0.5 * bead);
            rough = min(1.0, rough + 0.08 * bead);
            lean = lean - gn * 0.12 * (1.0 - smoothstep(0.0, 0.06, max(gj, 0.0))) * wx_keep(0.06, fw);
        }
        // Wheel paths and the oil band: the travel lanes from the parking lane's
        // edge (standards: the parking lane, the lane, the design vehicle's track),
        // drifting with the drivers' wander along the road.
        // (`--street-wear`: only past the decals' reach, `lane_k`; nearer the painted lanes' own, below)
        if (SP_LANE_M > 0.0 && SP_TRACK_M > 0.0 && lane_k > 0.0) {
            let wob = (st_noise(vec2<f32>(along / 23.0, 3.1)) - 0.5) * 0.5 + (st_noise(vec2<f32>(along / 5.0, 7.7)) - 0.5) * 0.14;
            let x = kd - SP_PARKING_M + wob;
            let lane = SP_LANE_M;
            let lx = x - lane * floor(x / lane) - 0.5 * lane;
            let in_lane = smoothstep(-0.4, 0.3, x) * lane_k;
            let half_t = 0.5 * SP_TRACK_M;
            let dt = abs(abs(lx) - half_t);
            let w = 0.3 + 0.1 * st_noise(vec2<f32>(along / 4.0, 1.7));
            // the polish broken into streaks along the road (tyre tread, the aggregate's tops)
            let streak = 0.55 + 0.45 * st_noise(vec2<f32>(along / 1.7, kd / 0.08) + 5.3);
            let wp = (1.0 - smoothstep(w * 0.35, w, dt)) * in_lane * mix(0.75, streak, wx_keep(0.08, fw));
            // drips between the wheel paths, densest at the lane's middle, in blots along it
            let blot = 0.45 + 0.55 * smoothstep(0.3, 0.75, st_noise(vec2<f32>(along / 1.3, kd / 0.25) + 2.2));
            let oil = (1.0 - smoothstep(0.1, 0.55, abs(lx))) * in_lane * mix(0.7, blot, wx_keep(0.25, fw));
            wpath = wp;
            // worn binder shows the aggregate (lighter, less brown); drips darken and close the texture
            a = a * mix(vec3<f32>(1.0), vec3<f32>(1.1, 1.1, 1.12), wp) * (1.0 - 0.24 * oil);
            rough = mix(rough, SP_ASPHALT_ROUGH_POLISHED, 0.85 * wp);
            rough = rough * (1.0 - 0.12 * oil);
            // rutting: each path's floor a few millimetres down (deeper and shallower
            // along the road as the base gave way), its sides leaning in
            let depth = SP_RUT_M * (0.35 + 1.3 * st_noise(vec2<f32>(along / 8.0, 2.3 + kd * 0.2)));
            let side = sign(abs(lx) - half_t) * sign(lx);
            let slope = select(0.0, 2.0 * depth * dt / (w * w), dt < w);
            lean = lean + gn * (-side * slope) * in_lane;
            dip = max(dip, depth * max(1.0 - (dt / w) * (dt / w), 0.0) * in_lane);
        }
    }
    if (SF_STREET_WEAR && cls == SC_ASPHALT && lane_k < 1.0) {
        // (`--street-wear`) the painted lanes' wheel paths (cc0.wgsl's decals, `sw_note_wheel`):
        // the kerb-distance lane model puts a wheel path at a lane-less street's crown,
        // where that distance has no gradient (a dark line between two polished bands)
        let wp = sw_wheel * (1.0 - lane_k);
        a = a * mix(vec3<f32>(1.0), vec3<f32>(1.1, 1.1, 1.12), wp);
        rough = mix(rough, SP_ASPHALT_ROUGH_POLISHED, 0.85 * wp);
        lean = lean + sw_wheel_lean * (1.0 - lane_k);
        dip = max(dip, sw_wheel_dip * (1.0 - lane_k));
        wpath = max(wpath, wp);
    }
    // the cracks the weathering drew: sealant as bitumen, open ones in their own shadow
    sp_crack_materials(s, &a, &rough, &lean, q, fw);
    // A lid, grate or plate laid in the road (cc0.wgsl's decals: cast iron,
    // steel, a concrete-filled vault) keeps its own material: its tone, and
    // the low roughness of its worn metal that mirrors the sky down a street.
    let lid = clamp(cc0_p_alb.w, 0.0, 1.0);
    a = mix(a, (*s).albedo, lid);
    rough = mix(clamp(rough, min(SP_SEAL_ROUGH, 0.3), 1.0), (*s).rough, lid);
    if (SF_STREET_WEAR) {
        // (`--street-wear`) a utility repair's fill: fresh, open-textured hot mix, unpolished
        rough = mix(rough, max(rough, 0.9), sw_patch);
        wpath = wpath * (1.0 - sw_patch);
    }
    sp_wet_relief(&a, &rough, q, dip * (1.0 - lid), fw, SP_WET_DARKEN);
    (*s).albedo = a;
    (*s).rough = rough;
    if (SF_STREET_GLARE) {
        // (`--street-glare`) the aggregate's polished tops as a smooth layer,
        // their share of the view growing toward grazing; near the eye stone by
        // stone (exposed and polished, or still filmed with dull binder)
        let v = normalize(frame.cam_pos.xyz - world);
        let tau = sg_top_share(n_geom, v, SG_MACRO_SLOPE, mix(SG_TOPS, SG_TOPS_WHEEL, wpath));
        let stone = select(0.3, 1.7, st_hash(floor(q / SG_AGGREGATE_M) + vec2<f32>(0.37, 5.1)) > 0.5);
        let k = mix(SG_POLISH, SG_POLISH_WHEEL, wpath) * tau * mix(1.0, stone, wx_keep(SG_AGGREGATE_M * 1.5, fw));
        // (the sealant and a lid keep their own finish)
        let fresh_fill = select(0.0, 0.7 * sw_patch, SF_STREET_WEAR);
        sg_coat(k * (1.0 - lid) * (1.0 - clamp(sp_seal.x, 0.0, 1.0)) * (1.0 - fresh_fill), mix(SG_COAT_ROUGH, SG_COAT_ROUGH_WHEEL, wpath));
    }
    if (any(lean != vec2<f32>(0.0))) {
        sp_lean(s, lean * (1.0 - lid));
    }
    // In the wet the film fills the aggregate's texture (a few tenths of a
    // millimetre of water over a dense mix's ~0.6 mm texture depth): the
    // fine relief under it no longer faces the eye stone by stone, so the
    // detail normal eases toward the film's (no salt-and-pepper glints).
    if (sky_on(skyu.flags.x, SKY_WET) && skyu.wet.x > 0.02) {
        (*s).n = normalize(mix((*s).n, n_geom, SP_WET_FILL * skyu.wet.x * (1.0 - lid)));
    }
}

// The wet street over its relief: the film soaks the porous surface darker
// (`darken`: wet asphalt's reflectance is the film's and the binder's, whatever
// the dry aggregate's tone), and water stands where the relief `dip` (m) is
// deeper than what drains in the time since the rain (the weather's puddle
// fill): in the ruts, the birdbaths, the gutter's flow line. The aggregate's
// texture (+- a millimetre) rags the edges. Sets `sp_pond` (sky_wet_street
// draws the water: mirror, flat, its rain rings).
fn sp_wet_relief(a: ptr<function, vec3<f32>>, rough: ptr<function, f32>, q: vec2<f32>, dip: f32, fw: f32, darken: f32) {
    let w = skyu.wet.x;
    if (!sky_on(skyu.flags.x, SKY_WET) || w < 0.02) {
        return;
    }
    *a = *a * mix(1.0, darken, w);
    let fill = clamp(skyu.wet.y, 0.0, 1.0);
    if (fill <= 0.0) {
        return;
    }
    let micro = (st_noise(q / 0.11 + 1.7) - 0.5) * 0.0016 + (st_noise(q / 0.031 + 6.1) - 0.5) * 0.0008 * wx_keep(0.03, fw);
    let water = dip + micro - SP_POND_DRAIN_M * (1.0 - fill);
    // a few tenths of a millimetre of edge, wider as the pixel grows (the relief's slope ~1.5 %)
    let pond = smoothstep(0.0, 3e-4 + fw * 0.015, water);
    sp_pond = max(sp_pond, pond * w);
}

// The patch quilt (weathering.wgsl `wx_road` with `--grime`, in place of
// `wx_quilt`): the same kinds of patch, but laid in the road's own frame
// anchored on the world, so a patch crosses the crown as the paver laid it
// (no step at the centre line); each patch's saw cut sealed with a bead of
// binder, its edge a few millimetres proud and its tone easing in from the
// edge (the compaction roller's pass), not a hard cut-out.
fn sp_quilt(s: ptr<function, Surface>, world: vec3<f32>, fw: f32) {
    let fr = sp_frame();
    let along = dot(world.xz, fr.t);
    let across = dot(world.xz, fr.n);
    let pc = WX_QUILT_CELL_M;
    let ci = floor(along / pc);
    let x = along - ci * pc;
    // across cells two lanes wide
    let ac = max(2.0 * SP_LANE_M, 4.0);
    let ai = floor(across / ac);
    let y = across - ai * ac;
    var mul = 1.0;
    var rough = 1.0;
    var seam = 0.0;
    var lean = vec2<f32>(0.0);
    for (var i = 0; i < 2; i = i + 1) {
        let hs = vec2<f32>(ci + ai * 31.7, f32(i) * 7.31 + 0.5);
        if (st_hash(hs + vec2<f32>(1.3, 7.7)) > WX_QUILT_SHARE) {
            continue;
        }
        let h1 = st_hash(hs + vec2<f32>(4.1, 2.3));
        let h2 = st_hash(hs + vec2<f32>(8.9, 5.5));
        let h3 = st_hash(hs + vec2<f32>(2.7, 9.1));
        let h4 = st_hash(hs + vec2<f32>(6.3, 3.9));
        var len = 0.7 + 0.9 * h2;
        var w = 0.7 + 0.9 * h4;
        var y0 = (ac - w) * h3;
        if (h1 < 0.35) {
            // a repaved piece of a lane
            len = 7.0 + (pc - 9.0) * h2;
            w = 2.4 + 1.2 * h4;
            y0 = (ac - w) * h3;
        } else if (h1 < 0.7) {
            // a longitudinal utility trench
            len = 5.0 + (pc - 7.0) * h2;
            w = 0.6 + 0.5 * h4;
            y0 = (ac - w) * h3;
        } else if (h1 < 0.85) {
            // a transverse trench across the road
            len = 0.7 + 0.6 * h2;
            w = ac + 1.0;
            y0 = -0.5;
        }
        // (else a small square repair)
        let x0 = st_hash(hs + vec2<f32>(3.3, 1.1)) * (pc - len);
        // a saw cut wanders a little
        let wig = (st_noise(world.xz / 0.7 + h2 * 9.0) - 0.5) * 0.02;
        let ex0 = x - x0;
        let ex1 = x0 + len - x;
        let ey0 = y - y0;
        let ey1 = y0 + w - y;
        let e = min(min(ex0, ex1), min(ey0, ey1)) + wig;
        if (e < -fw - 0.05) {
            continue;
        }
        let inside = smoothstep(-0.5 * fw, 0.5 * fw, e);
        let fresh = st_hash(hs + vec2<f32>(5.9, 8.3)) < WX_QUILT_FRESH * 0.8;
        var tone = select(mix(WX_PATCH_OLD_LO, WX_PATCH_OLD_HI, h4), mix(WX_PATCH_NEW_LO, WX_PATCH_NEW_HI, h3), fresh);
        // the roller's edge: the patch's tone eases in over its last few centimetres
        // (the whole patch keeps its own tone: a repair reads from down the street)
        tone = mix(tone, 0.5 * (tone + 1.0), 1.0 - smoothstep(0.0, 0.07, e));
        mul = mul * mix(1.0, tone, inside);
        rough = rough * mix(1.0, select(1.05, 0.88, fresh), inside);
        seam = max(seam, wx_band(abs(e), WX_SEAM_M, fw));
        // the patch a few millimetres proud: its edge leans out over the cut
        if (e > -0.01 && e < 0.05) {
            var odir = -fr.t;
            var best = ex0;
            if (ex1 < best) {
                best = ex1;
                odir = fr.t;
            }
            if (ey0 < best) {
                best = ey0;
                odir = -fr.n;
            }
            if (ey1 < best) {
                odir = fr.n;
            }
            lean = lean + odir * 0.1 * (1.0 - smoothstep(0.0, 0.04, max(e, 0.0))) * inside * wx_keep(0.04, fw);
        }
    }
    (*s).albedo = (*s).albedo * mul * (1.0 - WX_SEAM_DARK * 1.4 * seam);
    (*s).rough = clamp(mix((*s).rough * rough, 0.5, 0.5 * seam), 0.04, 1.0);
    if (any(lean != vec2<f32>(0.0))) {
        sp_lean(s, lean);
    }
}

// ---- the gutter pan -------------------------------------------------------------

// Poured concrete (SF's pans are concrete, not asphalt): the walk's concrete
// scan for its structure, the earlier composition's silt, grime and litter kept
// as a compressed ratio round its own base, darker toward the flow line.
fn sp_gutter(s: ptr<function, Surface>, world: vec3<f32>, kd: f32, tint: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, fw: f32) {
    let k = 1.0 / ST_CONCRETE_TILE;
    let t = st_tap(world.xz * k + vec2<f32>(0.37, 0.11), dpx.xz * k, dpy.xz * k, 1);
    let rel = clamp(t.albedo / ST_CONCRETE_MEAN, vec3<f32>(0.55), vec3<f32>(1.7));
    let old_base = max(dot(tint, CC0_LUMA) * (1.0 - ST_GUTTER_POUR_SILT) * CC0_ASPHALT_ALBEDO / max(CC0_ASPHALT_REF_LUMA, 1e-3), 1e-3);
    let dirt = clamp(dot((*s).albedo, CC0_LUMA) / old_base, 0.2, 1.5);
    var a = vec3<f32>(SP_GUTTER_ALBEDO) * vec3<f32>(1.02, 1.0, 0.95) * mix(vec3<f32>(1.0), rel, 0.75) * pow(dirt, 0.6);
    // the silt of the flow line, streaked along the kerb by the run-off
    let g = wx_kerb_grad();
    var along = world.x;
    if (length(g) > 0.3) {
        let gn = normalize(g);
        along = dot(world.xz, vec2<f32>(gn.y, -gn.x));
    }
    // (the silt's reach across the pan wanders with the run-off's reaches and the sweeper's last pass)
    let reach_w = ST_GUTTER_WIDTH * (0.3 + 0.6 * st_noise(vec2<f32>(along / 3.1, 2.7)));
    let flow = 1.0 - smoothstep(0.0, reach_w, max(kd, 0.0));
    let streak = mix(0.6, st_noise(vec2<f32>(along / 2.6, kd / 0.06) + 4.4), wx_keep(0.06, fw));
    a = a * (1.0 - 0.38 * flow * (0.55 + 0.45 * streak));
    var rough = clamp(0.9 * mix(1.0, t.rough / ST_CONCRETE_MEAN_ROUGH, 0.5) - 0.08 * flow, 0.5, 1.0);
    // the pan falls to its flow line at the kerb: the run-off stands there
    // longest, in reaches between the high spots of the pour
    let reach = 0.55 + 0.9 * st_noise(vec2<f32>(along / 3.7, 8.1));
    let dip = SP_GUTTER_DIP_M * (1.0 - clamp(max(kd, 0.0) / ST_GUTTER_WIDTH, 0.0, 1.0)) * reach;
    sp_wet_relief(&a, &rough, world.xz, dip, fw, SP_CONCRETE_WET_DARKEN);
    (*s).albedo = a;
    (*s).rough = rough;
}

// ---- kerbs -------------------------------------------------------------------------

// A rounded, worn arris (a share of the standard kerb height), the concave
// corner at the flow line in its own occlusion, tyre scuffs low on the face.
// `kd`: on the face the height above the flow line, on the top the distance
// from the kerb line (eo-street mesh.rs).
fn sp_kerb(s: ptr<function, Surface>, world: vec3<f32>, cls: u32, kd: f32, n_geom: vec3<f32>, fw: f32) {
    if (CC0_CURB_H <= 0.0 || kd < 0.0) {
        return;
    }
    let r = CC0_CURB_H * SP_ARRIS_SHARE;
    let keep = wx_keep(r, fw);
    if (cls == SC_KERB_FACE) {
        var fh = n_geom - SP_UP * dot(n_geom, SP_UP);
        if (dot(fh, fh) < 1e-4) {
            return;
        }
        fh = normalize(fh);
        // along the kerb (its sign fixed on the world, so a chip is the same seen from either side)
        var ft = vec3<f32>(-fh.z, 0.0, fh.x);
        if (ft.x < 0.0 || (ft.x == 0.0 && ft.z < 0.0)) {
            ft = -ft;
        }
        let along = dot(world, ft);
        // the arris chipped by kerbing tyres and bumpers: broken out in pieces a
        // few centimetres to a decimetre long (the break reaching further down
        // the face), at no repeat along the kerb; each break a fresh fracture,
        // lighter and rougher than the weathered skin round it
        let cn = st_noise(vec2<f32>(along / 0.23, 4.1)) * 0.7 + st_noise(vec2<f32>(along / 0.071, 9.3)) * 0.3;
        let chip = smoothstep(0.6, 0.76, cn) * wx_keep(0.05, fw);
        let rr = r * (1.0 + SP_ARRIS_BREAK * chip);
        // the arris: over its radius below the top the face turns up toward the kerb top
        let t = clamp((kd - (CC0_CURB_H - rr)) / rr, 0.0, 1.0);
        let ang = t * mix(1.15, 0.8, chip);
        let bend = fh * cos(ang) + SP_UP * sin(ang) - fh;
        (*s).n = normalize((*s).n + bend * keep);
        // its worn edge shows the aggregate: lighter, smoother; a break lighter still and rough
        (*s).albedo = (*s).albedo * (1.0 + (0.12 + 0.16 * chip) * t * keep);
        (*s).rough = min(1.0, (*s).rough + 0.1 * chip * t);
        if (SF_STREET_GLARE) {
            // (`--street-glare`) the arris worn smooth by soles and tyres (not where it broke)
            (*s).rough = mix((*s).rough, SG_COAT_ROUGH_WHEEL, 0.6 * t * (1.0 - chip) * keep);
        }
        // the concave corner with the gutter: occluded, with the grit it holds
        let c = 1.0 - smoothstep(0.0, CC0_CURB_H * 0.35, kd);
        (*s).ao = (*s).ao * (1.0 - 0.5 * c);
        (*s).albedo = (*s).albedo * (1.0 - 0.18 * c);
        // tyre scuffs: black rubber rubbed along the face a few centimetres up
        let band = smoothstep(0.01, 0.025, kd) * (1.0 - smoothstep(0.06, 0.1, kd));
        let sc = smoothstep(0.6, 0.78, st_noise(vec2<f32>(along / 0.9, 1.3))) * band;
        let scuff = mix(0.12 * band, sc, wx_keep(0.05, fw));
        (*s).albedo = (*s).albedo * (1.0 - 0.55 * scuff);
        (*s).rough = clamp((*s).rough - 0.12 * scuff, 0.3, 1.0);
    } else {
        let g = wx_kerb_grad();
        let gl = length(g);
        if (gl < 0.3) {
            return;
        }
        // toward the road
        let odir = -g / gl;
        let t = 1.0 - clamp(kd / r, 0.0, 1.0);
        let ang = t * 1.15;
        let o3 = vec3<f32>(odir.x, 0.0, odir.y);
        let bend = SP_UP * cos(ang) + o3 * sin(ang) - SP_UP;
        (*s).n = normalize((*s).n + bend * keep);
        (*s).albedo = (*s).albedo * (1.0 + 0.1 * t * keep);
    }
}

// ---- the scored walk ----------------------------------------------------------------

// The squares of the SF scoring grid (caMetric 'sidewalk-scoring-grid-sf',
// from the kerb line), as `cc0_scoring` and `wx_walk` key them: each settled
// at its own small tilt (a few heaved by roots), the joints dark recessed
// grooves, some slabs cracked across, some with a broken corner, a few
// replaced with asphalt.
fn sp_slabs(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, kd: f32, n_geom: vec3<f32>, fw: f32) {
    let pitch = CC0_SCORING_M;
    let g = wx_kerb_grad();
    let gl = length(g);
    if (pitch <= 0.0 || gl < 0.3) {
        return;
    }
    let r = wx_run(rel, g, pitch);
    let nrm = g / gl;
    let tan = vec2<f32>(-nrm.y, nrm.x);
    let cell = floor(vec2<f32>(r.along, kd) / pitch) + vec2<f32>(r.k, 0.0);
    let la = fract(r.along / pitch);
    let lc = fract(kd / pitch);
    let keep = wx_keep(pitch, fw);
    let h1 = st_hash(cell + vec2<f32>(11.7, 3.1));
    let h2 = st_hash(cell + vec2<f32>(2.3, 41.9));
    let h3 = st_hash(cell + vec2<f32>(57.1, 9.4));
    let h4 = st_hash(cell + vec2<f32>(23.9, 71.3));
    let h5 = st_hash(cell + vec2<f32>(91.7, 15.1));
    // settlement: each slab its own tilt, a few heaved by roots or sunk over a void
    var tilt = (vec2<f32>(h1, h2) - 0.5) * 2.0 * SP_SLAB_TILT;
    if (h3 < SP_SLAB_HEAVE_SHARE) {
        tilt = tilt * 3.5;
    }
    sp_lean(s, (tan * tilt.x + nrm * tilt.y) * keep);
    // Each slab its own pour: the batch's tone and a little of its cement's
    // hue; a few replaced since (a newer, paler, cooler paste), a few darkened
    // by what was spilled or dripped on them. Held while the slab is a pixel
    // or more (slabs read as a patchwork down the block).
    let h6 = st_hash(cell + vec2<f32>(37.3, 88.1));
    let h7 = st_hash(cell + vec2<f32>(63.7, 29.9));
    var pour = 1.0 + (h6 - 0.5) * SP_SLAB_TONE * 2.0;
    var hue = mix(vec3<f32>(0.985, 0.995, 1.02), vec3<f32>(1.025, 1.0, 0.97), h7);
    if (h6 > 1.0 - SP_SLAB_NEW_SHARE) {
        pour = SP_SLAB_NEW_TONE * (0.96 + 0.08 * h7);
        hue = vec3<f32>(0.98, 0.995, 1.025);
    } else if (h7 > 1.0 - SP_SLAB_STAINED_SHARE) {
        pour = pour * (0.78 + 0.1 * h6);
        hue = vec3<f32>(1.01, 1.0, 0.97);
    }
    let pk = 1.0 - smoothstep(pitch * 0.3, pitch * 0.9, fw);
    (*s).albedo = (*s).albedo * mix(vec3<f32>(1.0), hue * pour, pk);
    // where the fragment is in its slab (metres) and its distance to the nearest joint
    let pl = vec2<f32>(la, lc) * pitch;
    let dj = min(min(pl.x, pitch - pl.x), min(pl.y, pitch - pl.y));
    // the joints: tooled grooves holding dirt, their floor in shadow
    let jk = wx_band(dj, pitch * 0.007, fw) * (0.6 + 0.4 * keep);
    (*s).albedo = (*s).albedo * (1.0 - 0.5 * jk);
    (*s).ao = (*s).ao * (1.0 - 0.45 * jk);
    (*s).rough = min(1.0, (*s).rough + 0.1 * jk);
    if (keep <= 0.0) {
        return;
    }
    // a repair: the slab replaced with asphalt
    if (h5 > 0.975) {
        let pa = smoothstep(0.004, 0.012 + fw, dj);
        (*s).albedo = mix((*s).albedo, vec3<f32>(SP_ASPHALT_ALBEDO * 0.8) * vec3<f32>(1.0, 0.98, 0.95), pa * keep);
        (*s).rough = mix((*s).rough, SP_ASPHALT_ROUGH, pa * keep);
        return;
    }
    var crack = 0.0;
    if (h4 < SP_SLAB_CRACK_SHARE) {
        // a crack across the slab, from one edge to another, wandering
        let e1 = st_hash(cell + vec2<f32>(5.5, 0.7));
        let e2 = st_hash(cell + vec2<f32>(0.9, 6.6));
        var a0 = vec2<f32>(0.0, e1 * pitch);
        var a1 = vec2<f32>(pitch, e2 * pitch);
        if (h4 < SP_SLAB_CRACK_SHARE * 0.5) {
            a0 = vec2<f32>(e1 * pitch, 0.0);
            a1 = vec2<f32>(e2 * pitch, pitch);
        }
        let ab = a1 - a0;
        let tt = clamp(dot(pl - a0, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0);
        let wig = (st_noise(world.xz / 0.09 + h2 * 13.0) - 0.5) * 0.03 + (st_noise(world.xz / 0.025 + h1 * 7.0) - 0.5) * 0.008;
        let d = length(pl - (a0 + ab * tt)) + wig;
        crack = wx_band(abs(d), 0.0018 + 0.0015 * h3, fw);
    }
    if (h5 < SP_SLAB_CORNER_SHARE) {
        // a broken corner: a crack cutting it off, the piece sunk a little and dirtier
        let cx = select(0.0, pitch, h1 > 0.5);
        let cy = select(0.0, pitch, h2 > 0.5);
        let k = (0.18 + 0.2 * h3) * pitch;
        let u = abs(pl.x - cx) + abs(pl.y - cy);
        let wig = (st_noise(world.xz / 0.06 + h4 * 11.0) - 0.5) * 0.02;
        crack = max(crack, wx_band(abs(u - k + wig) * 0.7071, 0.002, fw));
        let piece = 1.0 - smoothstep(k - 0.004, k + 0.004 + fw, u + wig);
        (*s).albedo = (*s).albedo * (1.0 - 0.1 * piece);
        let dir = vec2<f32>(select(1.0, -1.0, cx > 0.0), select(1.0, -1.0, cy > 0.0));
        sp_lean(s, (tan * dir.x + nrm * dir.y) * 0.03 * piece);
    }
    crack = crack * keep;
    (*s).albedo = (*s).albedo * (1.0 - 0.55 * crack);
    (*s).ao = (*s).ao * (1.0 - 0.3 * crack);
}

// ---- the street dispatch (draw.wgsl `street_surface`) ---------------------------------

fn sp_street(s: ptr<function, Surface>, world: vec3<f32>, rel: vec3<f32>, cls: u32, kd: f32, n_geom: vec3<f32>, dpx: vec3<f32>, dpy: vec3<f32>, tint: vec3<f32>) {
    let fw = wx_fw(dpx, dpy);
    if (cls == SC_ASPHALT || cls == SC_PAD) {
        sp_asphalt(s, world, cls, kd, n_geom, fw);
    } else if (cls == SC_GUTTER) {
        sp_gutter(s, world, kd, tint, dpx, dpy, fw);
    } else if (cls == SC_KERB_FACE || cls == SC_KERB_TOP) {
        sp_kerb(s, world, cls, kd, n_geom, fw);
    } else if (cls == SC_FOOTWAY && kd >= 0.0) {
        sp_slabs(s, world, rel, kd, n_geom, fw);
    }
}

// Raised thermoplastic (cc0.wgsl `cc0_paint_wear`): the line's edges a couple
// of millimetres proud of the asphalt, so its rounded edges lean out and the
// one facing a low sun catches it. `an` the across coordinate (0..1), `gl` its
// gradient's length (1 / the line's width), `nrm` the across direction.
fn sp_paint_edge(s: ptr<function, Surface>, an: f32, gl: f32, nrm: vec2<f32>, fw: f32) {
    let w = 1.0 / max(gl, 1e-3);
    let e = 0.006;
    let d0 = clamp(an, 0.0, 1.0) * w;
    let d1 = (1.0 - clamp(an, 0.0, 1.0)) * w;
    let k0 = 1.0 - smoothstep(0.0, e, d0);
    let k1 = 1.0 - smoothstep(0.0, e, d1);
    sp_lean(s, nrm * (k1 - k0) * 0.35 * wx_keep(e, fw));
}

// ---- laid paving from its scan (the plazas) --------------------------------------------

// The paving's scan (the plaza styles' CC0 sets) drawn as the relief it is:
//  * stochastically tiled (Heitz & Neyret 2018, "High-Performance By-Example
//    Noise using a Histogram-Preserving Blending Operator"; Mikkelsen 2022,
//    "Practical Real-Time Hex-Tiling"): a triangle grid of tiles each at its
//    own random offset into the scan, blended by height so that at a seam the
//    higher stone wins whole (no ghosted double pattern, no repeat, no rails);
//  * parallax occlusion mapped on that blended height near the eye, so the
//    stones stand proud of their joints and hide them at a low view;
//  * self-shadowed toward the key light (a march over the height toward the
//    sun, soft with distance), then past its reach the relief's mean masking
//    (Smith's G1 for the paving's slope spread), through `sp_sun_vis`;
//  * crowns polished by feet where the macro traffic field runs, joints rough,
//    a soiling field over metres that holds to the horizon.
// Every scan term goes to its mip mean as the footprint grows (the GPU's
// filtering, the same gradients for every tile), so nothing shimmers.

// The key light's visibility over the surface's own relief (1: none of it
// hidden). look_light.wgsl multiplies the key by it with `--street-pbr`; each
// fragment starts at 1, only the street surface's paving sets it.
var<private> sp_sun_vis: f32 = 1.0;
// Standing water the street's relief holds (0..1, already scaled by the
// film's wetness): sky_wet_street takes it as its puddle with `--street-pbr`.
var<private> sp_pond: f32 = 0.0;

struct SpHex {
    // the three tiles' barycentric weights and offsets into the scan (uv)
    w: vec3<f32>,
    o0: vec2<f32>,
    o1: vec2<f32>,
    o2: vec2<f32>,
};

fn sp_hash2(p: vec2<f32>) -> vec2<f32> {
    return vec2<f32>(st_hash(p + vec2<f32>(3.1, 17.3)), st_hash(p + vec2<f32>(41.7, 5.9)));
}

// The triangle grid's three tiles round `uv` (cells SP_HEX_CELL repeats across).
fn sp_hex(uv: vec2<f32>) -> SpHex {
    let st = uv * (3.4641016 / SP_HEX_CELL);
    let sk = vec2<f32>(st.x, -0.57735027 * st.x + 1.15470054 * st.y);
    let b = floor(sk);
    let f = fract(sk);
    let z = 1.0 - f.x - f.y;
    var h: SpHex;
    var v0 = b;
    var v1 = b + vec2<f32>(0.0, 1.0);
    var v2 = b + vec2<f32>(1.0, 0.0);
    h.w = vec3<f32>(z, f.y, f.x);
    if (z <= 0.0) {
        h.w = vec3<f32>(-z, 1.0 - f.y, 1.0 - f.x);
        v0 = b + vec2<f32>(1.0, 1.0);
        v1 = b + vec2<f32>(1.0, 0.0);
        v2 = b + vec2<f32>(0.0, 1.0);
    }
    h.o0 = sp_hash2(v0);
    h.o1 = sp_hash2(v1);
    h.o2 = sp_hash2(v2);
    return h;
}

// The tiles' heights at `uv` (only those `m` keeps; the rest read 0).
fn sp_hex_hs(uv: vec2<f32>, hx: SpHex, m: vec3<f32>, la: i32, gx: vec2<f32>, gy: vec2<f32>) -> vec3<f32> {
    var h = vec3<f32>(0.0);
    if (m.x > 0.0) {
        h.x = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o0, la, gx, gy).z;
    }
    if (m.y > 0.0) {
        h.y = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o1, la, gx, gy).z;
    }
    if (m.z > 0.0) {
        h.z = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o2, la, gx, gy).z;
    }
    return h;
}

// The height blend: each tile's height raised by its barycentric weight; the
// highest wins, its neighbours within SP_HEX_SOFT of it share the pixel.
fn sp_hex_blend(w: vec3<f32>, h: vec3<f32>, m: vec3<f32>) -> vec3<f32> {
    let a = select(vec3<f32>(-8.0), h + w * SP_HEX_GAIN, m > vec3<f32>(0.0));
    let top = max(a.x, max(a.y, a.z)) - SP_HEX_SOFT;
    let b = max(a - vec3<f32>(top), vec3<f32>(0.0));
    return b / max(b.x + b.y + b.z, 1e-6);
}

fn sp_hex_height(uv: vec2<f32>, hx: SpHex, m: vec3<f32>, la: i32, gx: vec2<f32>, gy: vec2<f32>) -> f32 {
    let h = sp_hex_hs(uv, hx, m, la, gx, gy);
    return dot(sp_hex_blend(hx.w, h, m), h);
}

struct SpPave {
    // over the scan's means: albedo, roughness, occlusion
    alb: vec3<f32>,
    rough: f32,
    ao: f32,
    // the relief's lean of the normal (world x, z)
    tn: vec2<f32>,
};

// The scan's taps at `uv` over the tiles `m` keeps of `hx`, blended by height.
struct SpTaps {
    alb: vec3<f32>,
    nrm: vec2<f32>,
    rough: f32,
    ao: f32,
    // the tiles' tone shift (-0.5..0.5) and the blended height
    tone: f32,
    h: f32,
};

fn sp_pave_taps(uv: vec2<f32>, hx: SpHex, m: vec3<f32>, la: i32, ugx: vec2<f32>, ugy: vec2<f32>) -> SpTaps {
    var t: SpTaps;
    // roughness, occlusion, height of each tile that may show (one read each)
    var r0 = vec4<f32>(0.0);
    var r1 = vec4<f32>(0.0);
    var r2 = vec4<f32>(0.0);
    if (m.x > 0.0) {
        r0 = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o0, la, ugx, ugy);
    }
    if (m.y > 0.0) {
        r1 = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o1, la, ugx, ugy);
    }
    if (m.z > 0.0) {
        r2 = textureSampleGrad(cc0_rhm, cc0_samp, uv + hx.o2, la, ugx, ugy);
    }
    let hs = vec3<f32>(r0.z, r1.z, r2.z);
    let wb = sp_hex_blend(hx.w, hs, m);
    t.h = dot(wb, hs);
    t.rough = dot(wb, vec3<f32>(r0.x, r1.x, r2.x));
    t.ao = dot(wb, vec3<f32>(r0.y, r1.y, r2.y));
    t.alb = vec3<f32>(0.0);
    t.nrm = vec2<f32>(0.0);
    t.tone = 0.0;
    for (var k = 0; k < 3; k = k + 1) {
        let wk = wb[k];
        if (wk <= 0.002) {
            continue;
        }
        var off = hx.o0;
        if (k == 1) {
            off = hx.o1;
        } else if (k == 2) {
            off = hx.o2;
        }
        let q = uv + off;
        t.alb = t.alb + wk * textureSampleGrad(cc0_albedo, cc0_samp, q, la, ugx, ugy).rgb;
        t.nrm = t.nrm + wk * (textureSampleGrad(cc0_normal, cc0_samp, q, la, ugx, ugy).xy * 2.0 - 1.0);
        // each tile its own small shift of tone (another quarry lot, another soiling); none on the scan's own tiling
        t.tone = t.tone + wk * select(0.0, st_hash(off * 97.0 + 1.7) - 0.5, any(off != vec2<f32>(0.0)));
    }
    return t;
}

fn sp_hex_plain() -> SpHex {
    var h: SpHex;
    h.w = vec3<f32>(1.0, 0.0, 0.0);
    h.o0 = vec2<f32>(0.0);
    h.o1 = vec2<f32>(0.0);
    h.o2 = vec2<f32>(0.0);
    return h;
}

// The open spaces' paving at its material's reflectance: the style's vertex
// colour (plaza-paving.js's display tones, a linear 0.45-0.7) scaled, luma for
// luma, to the measured albedo of the material its scan is (grey granite setts,
// clay brick pavers, concrete pavers; street_pbr.rs), each bay's jitter kept.
fn sp_pave_cal(la: i32) -> f32 {
    var want = SP_SETT_ALBEDO;
    var tone = CC0_PLAZA_STONE;
    if (la == CC0_L_HERRINGBONE_PAVEMENT) {
        want = SP_BRICK_PAVER_ALBEDO;
        tone = CC0_PLAZA_BRICK;
    } else if (la == CC0_L_PATTERNED_CONCRETE_PAVERS) {
        want = SP_CONCRETE_PAVER_ALBEDO;
        tone = CC0_PLAZA_CONCRETE;
    }
    let l = dot(tone, CC0_LUMA);
    return select(1.0, want / l, l > 0.0);
}

// The paving at `p` (world xz, metres; `gx`/`gy` its screen derivatives) from
// scan layer `la`. Near the eye the scan's own tiling (whole stones, as laid);
// from SP_HEX_NEAR out, where its repeat would line up into rails, the
// stochastic tiling where `stochastic` (the random setts; a bonded pattern
// keeps its one tiling). Sets `sp_sun_vis`.
fn sp_pave(la: i32, p: vec2<f32>, gx: vec2<f32>, gy: vec2<f32>, world: vec3<f32>, stochastic: bool) -> SpPave {
    var o: SpPave;
    let ia = cc0_linv(la);
    let uv = p * ia;
    let ugx = gx * ia;
    let ugy = gy * ia;
    let to_eye = frame.cam_pos.xyz - world;
    let dist = length(to_eye);
    let v = to_eye / max(dist, 1e-4);
    let hexk = select(0.0, smoothstep(SP_HEX_NEAR, SP_HEX_NEAR * 1.5, dist), stochastic);
    let plain = sp_hex_plain();
    let one = vec3<f32>(1.0, 0.0, 0.0);
    var hx = plain;
    var m = one;
    if (hexk > 0.0) {
        hx = sp_hex(uv);
        // the tiles that show at all (most pixels: one)
        let m_all = select(vec3<f32>(0.0), vec3<f32>(1.0), hx.w > vec3<f32>(0.0));
        let w0 = sp_hex_blend(hx.w, sp_hex_hs(uv, hx, m_all, la, ugx, ugy), m_all);
        m = select(vec3<f32>(0.0), vec3<f32>(1.0), w0 > vec3<f32>(0.002));
    }
    var uvp = uv;
    // Parallax occlusion near the eye (inside SP_HEX_NEAR: the scan's own
    // tiling): the ray from the stones' tops (the drawn plane) down through
    // the height field to its first hit.
    let pom_k = select(0.0, 1.0 - smoothstep(SP_POM_FAR * 0.55, SP_POM_FAR, dist), hexk <= 0.0);
    if (pom_k > 0.0 && v.y > 0.02) {
        let vy = max(v.y, 0.12);
        let full = -v.xz / vy * SP_PAVE_DEPTH * ia * pom_k;
        let steps = i32(mix(6.0, 16.0, clamp(1.0 - v.y, 0.0, 1.0)));
        let dl = 1.0 / f32(steps);
        var prev_d = 0.0;
        var prev_s = 1.0 - textureSampleGrad(cc0_rhm, cc0_samp, uv, la, ugx, ugy).z;
        for (var i = 1; i <= steps; i = i + 1) {
            if (prev_s <= 0.0) {
                break;
            }
            let d = f32(i) * dl;
            let q = uv + full * d;
            let s = 1.0 - textureSampleGrad(cc0_rhm, cc0_samp, q, la, ugx, ugy).z;
            if (d >= s) {
                let a = prev_s - prev_d;
                let b = d - s;
                uvp = uv + full * mix(prev_d, d, a / max(a + b, 1e-5));
                break;
            }
            prev_d = d;
            prev_s = s;
            uvp = q;
        }
    }
    // the shading taps at the hit: the scan's own tiling, the stochastic one, or both across the band between
    var t: SpTaps;
    if (hexk < 1.0) {
        t = sp_pave_taps(uvp, plain, one, la, ugx, ugy);
    }
    if (hexk > 0.0) {
        let th = sp_pave_taps(uvp, hx, m, la, ugx, ugy);
        if (hexk >= 1.0) {
            t = th;
        } else {
            t.alb = mix(t.alb, th.alb, hexk);
            t.nrm = mix(t.nrm, th.nrm, hexk);
            t.rough = mix(t.rough, th.rough, hexk);
            t.ao = mix(t.ao, th.ao, hexk);
            t.tone = mix(t.tone, th.tone, hexk);
            t.h = mix(t.h, th.h, hexk);
        }
    }
    let hb = t.h;
    let lm = cc0_lmean(la);
    let lx = cc0_lmisc(la);
    var rel = t.alb / max(lm.rgb, vec3<f32>(1e-3));
    // The macro fields (metres; they hold to the horizon): soiling and damp,
    // and the foot traffic's desire lines that clean and polish the crowns.
    let m0 = st_noise(p / 17.0 + 8.8);
    let m1 = st_noise(p / 6.3 + 2.1);
    let m2 = st_noise(p / 2.2 + 7.4);
    let traffic = smoothstep(0.4, 0.8, st_noise(p / 13.0 + 5.5));
    let soil = 1.0 + (m0 - 0.5) * 0.3 + (m1 - 0.5) * 0.2 + (m2 - 0.5) * 0.1 + t.tone * 0.12;
    let crown = smoothstep(0.55, 0.85, hb);
    let low = 1.0 - smoothstep(0.12, 0.4, hb);
    // grit and dirt held in the joints, deeper where the traffic does not sweep
    rel = rel * soil * (1.0 - 0.25 * low * (1.0 - 0.5 * traffic)) * (1.0 + 0.06 * crown * traffic);
    o.alb = rel;
    o.rough = clamp(t.rough / max(lx.x, 0.05) * (1.0 - 0.22 * crown * traffic) * (1.0 + 0.12 * low), 0.3, 1.6);
    if (SF_STREET_GLARE) {
        // (`--street-glare`) the crowns the feet polish, a layer that grows toward grazing (the setts' relief masks the joints)
        let tau = sg_top_share(SP_UP, v, SP_PAVE_SLOPE, 0.4);
        sg_coat(SG_SETT_POLISH * crown * (0.4 + 0.6 * traffic) * tau, SG_SETT_ROUGH);
    }
    o.ao = clamp(t.ao / max(lx.y, 0.05), 0.0, 1.5);
    o.tn = vec2<f32>(t.nrm.x, -t.nrm.y);
    // The key light over the relief: marched near, the relief's mean masking far.
    let l = look.key_dir.xyz;
    let lh = length(l.xz);
    if (l.y > 0.0 && lh > 1e-3) {
        let tan_el = l.y / lh;
        // Smith's G1 (Beckmann, Walter et al. 2007's rational fit) at the paving's slope spread
        let a = tan_el / SP_PAVE_SLOPE;
        let g1 = select(1.0, (3.535 * a + 2.181 * a * a) / (1.0 + 2.276 * a + 2.577 * a * a), a < 1.6);
        var vis = g1;
        let near = 1.0 - smoothstep(SP_SHADOW_FAR * 0.6, SP_SHADOW_FAR, dist);
        if (near > 0.0) {
            // over the tiling that dominates the pixel, from its own height there
            // (a start off the field it marches would shadow the stone by itself)
            var hs_x = plain;
            var hs_m = one;
            var h0 = hb;
            if (hexk > 0.0 && hexk < 1.0) {
                if (hexk >= 0.5) {
                    hs_x = hx;
                    hs_m = m;
                }
                h0 = sp_hex_height(uvp, hs_x, hs_m, la, ugx, ugy);
            } else if (hexk >= 1.0) {
                hs_x = hx;
                hs_m = m;
            }
            let reach = min((1.0 - h0) * SP_PAVE_DEPTH / tan_el, SP_SHADOW_REACH);
            var march = 1.0;
            if (reach > 5e-4) {
                let dir = l.xz / lh * ia;
                var occ = 0.0;
                for (var i = 1; i <= 8; i = i + 1) {
                    let s = reach * f32(i) / 8.0;
                    // (a few hundredths of the relief over the start: the filtered field's own slope)
                    let hr = h0 + SP_SHADOW_BIAS + s * tan_el / SP_PAVE_DEPTH;
                    let hq = sp_hex_height(uvp + dir * s, hs_x, hs_m, la, ugx, ugy);
                    // soft: the height above the ray over the penumbra's width there
                    occ = max(occ, (hq - hr) * SP_PAVE_DEPTH / (s * SP_PENUMBRA + 4e-4));
                }
                march = clamp(1.0 - occ, 0.0, 1.0);
            }
            vis = mix(g1, march, near);
        }
        sp_sun_vis = vis;
    }
    return o;
}

// ---- worn paint (draw.wgsl, the street paint) ------------------------------------------

// Marking paint worn by the traffic, after the weathering's soil and tyre
// streaks (draw.wgsl, `--grime` on): a line is a film over the asphalt, and
// what wears it away first are the tops of the asphalt's aggregate under it,
// so where it is worn the road shows through in the road's own texture (the
// asphalt scan at the fragment, the carriageway's tone and finish), in
// patches a few decimetres long drawn out along the line by the tyres, more
// at the line's ragged edges and on older lines (the weathering's slow age
// field); the road's cracks run on through the paint (open ones crack it,
// sealed ones are sealed over it, as a crew seals a street). Each term goes
// to its mean cover once it is under a pixel. `an`: the marking's across
// coordinate (0..1).
fn sp_paint_wear(s: ptr<function, Surface>, world: vec3<f32>, an: f32, dpx: vec3<f32>, dpy: vec3<f32>) {
    let fw = wx_fw(dpx, dpy);
    let q = world.xz;
    let g = wx_kerb_grad();
    let gl = length(g);
    var along = vec2<f32>(1.0, 0.0);
    var de = 1.0;
    if (gl > 0.05) {
        along = vec2<f32>(-g.y, g.x) / gl;
        if (an >= 0.0) {
            de = min(clamp(an, 0.0, 1.0), 1.0 - clamp(an, 0.0, 1.0)) / gl;
        }
    }
    let u = dot(q, along);
    let v = dot(q, vec2<f32>(-along.y, along.x));
    let age = smoothstep(0.2, 0.8, st_noise(q / 17.0 + 2.9));
    // the worn share here: the line's age, patches drawn out along it, its ragged edges
    let p1 = mix(0.5, st_noise(vec2<f32>(u / 0.9, v / 0.28) + 3.1), wx_keep(0.28, fw));
    let p2 = mix(0.5, st_noise(vec2<f32>(u / 0.3, v / 0.1) + 8.4), wx_keep(0.1, fw));
    let edge = 1.0 - smoothstep(0.0, SP_PAINT_EDGE_M, de);
    let wear = clamp(mix(SP_PAINT_WORN, SP_PAINT_WORN_OLD, age) + (p1 - 0.5) * 0.5 + (p2 - 0.5) * 0.25 + 0.3 * edge * wx_keep(SP_PAINT_EDGE_M, fw), 0.0, 1.0);
    // the asphalt under the line: its scan at the fragment, as the carriageway draws it
    let k = 1.0 / ST_ASPHALT_TILE;
    let t = st_tap(q * k, dpx.xz * k, dpy.xz * k, 0);
    let rel = clamp(t.albedo / ST_ASPHALT_MEAN, vec3<f32>(0.6), vec3<f32>(1.6));
    let road = CC0_ASPHALT_TINT * SP_ASPHALT_ALBEDO * rel;
    // which of it reaches through: the aggregate's tops first (the scan's least
    // occluded texels), decorrelated by the stones' own scatter
    let top = clamp(0.5 + (t.ao - ST_ASPHALT_MEAN_AO) * 1.5, 0.0, 1.0) * 0.6 + st_noise(q / 0.014 + 5.5) * 0.4;
    let worn = mix(wear, smoothstep(1.0 - wear - 0.06, 1.0 - wear + 0.06, top), wx_keep(0.03, fw));
    var a = mix((*s).albedo, road, worn);
    // the line's own finish: a cast resin film, smooth fresh and chalking with
    // age (the weathering's soil, chips and tyre polish kept round it), so in a
    // low sun's glare off the polished road the line glares with it and stays read
    let finish = clamp(mix(SP_PAINT_ROUGH, SP_PAINT_ROUGH_AGED, age) + 0.5 * ((*s).rough - ST_PAINT_ROUGHNESS), 0.2, 1.0);
    var rough = mix(finish, SP_ASPHALT_ROUGH, worn);
    var lean = vec2<f32>(0.0);
    if (wx_level() != 0u) {
        // the road's own crack network on through the line (its frame from the
        // line's across direction, the road's along a lane line)
        sp_seal = vec4<f32>(0.0);
        sp_crack = 0.0;
        var c: Surface = *s;
        c.albedo = a;
        c.rough = rough;
        if (SF_STREET_WEAR) {
            sw_cracks(&c, world, g, -1.0, fw, length(world - frame.cam_pos.xyz)); // (`--street-wear`) the road's transverse cracks on through the line
        } else {
            wx_cracks(&c, world, g, fw, length(world - frame.cam_pos.xyz));
        }
        a = c.albedo;
        rough = c.rough;
        sp_crack_materials(s, &a, &rough, &lean, q, fw);
    }
    (*s).albedo = a;
    (*s).rough = rough;
    if (any(lean != vec2<f32>(0.0))) {
        sp_lean(s, lean);
    }
    if (SF_STREET_GLARE) {
        // (`--street-glare`) the line's resin film fills the road's texture: a smooth layer over more of it,
        // so a marking keeps its glare where the polished road round it catches the low sun
        let v = normalize(frame.cam_pos.xyz - world);
        sg_coat(SG_POLISH_WHEEL * sg_top_share(SP_UP, v, SG_MACRO_SLOPE, SG_TOPS_WHEEL) * (1.0 - clamp(sp_seal.x, 0.0, 1.0)), SG_COAT_ROUGH_WHEEL);
    }
}

// ---- wet paint (draw.wgsl, the street paint) -------------------------------------------

// Thermoplastic and paint do not soak: the film over them darkens them a
// little (its index against the paint's) and makes them glossy, and they take
// the film's streaks of the lamps (sky_light.wgsl) as the asphalt round them.
fn sp_paint_wet(s: ptr<function, Surface>) {
    let w = skyu.wet.x;
    if (!sky_on(skyu.flags.x, SKY_WET) || w < 0.02) {
        return;
    }
    (*s).albedo = (*s).albedo * mix(1.0, SP_PAINT_WET_DARKEN, w);
    (*s).rough = mix((*s).rough, min((*s).rough, SP_PAINT_WET_ROUGH), w);
    if (SKY_CINE_FULL && sky_on(skyu.flags.x, SKY_CINEMATIC)) {
        sky_streak_w = w;
    }
}

// ---- `--street-wear`: the carriageway's distress by its causes (SF_STREET_WEAR) ---------

// One crack line under the fragment: its distance (m, signed across it), the
// direction across it (world xz), the hash that decides it, and whether it is
// drawn at all there (its run, 0..1).
struct SwLine {
    d: f32,
    dir: vec2<f32>,
    h: f32,
    on: f32,
};

fn sw_nearer(b: SwLine, c: SwLine) -> SwLine {
    if (c.on > 0.0 && abs(c.d) < abs(b.d)) {
        return c;
    }
    return b;
}

// Transverse cracks (thermal) across a road whose along coordinate is `a` and
// across one `c` (world-anchored, metres): one chance per SW_TRANSVERSE_CELL_M,
// each crossing the road (or a few metres of it) as a meandering line.
fn sw_transverse(a: f32, c: f32, t: vec2<f32>, salt: f32, share: f32) -> SwLine {
    var o = SwLine(1e9, t, 0.0, 0.0);
    let cl = SW_TRANSVERSE_CELL_M;
    let k0 = floor(a / cl);
    for (var i = -1; i <= 1; i = i + 1) {
        let k = k0 + f32(i);
        let h = st_hash(vec2<f32>(k + salt * 17.0, 3.7 + salt));
        if (h > share) {
            continue;
        }
        let h1 = st_hash(vec2<f32>(k + salt * 17.0, 9.1));
        // its course: a slow wander across the road, a decimetre kink, the fine break
        let x = (k + 0.2 + 0.6 * h1) * cl + (st_noise(vec2<f32>(c / 6.5, k * 3.1 + salt)) - 0.5) * 0.9 + (st_noise(vec2<f32>(c / 1.1, k * 1.7)) - 0.5) * 0.14 + (st_noise(vec2<f32>(c / 0.21, k * 5.3)) - 0.5) * 0.03;
        // across the whole road (most), or broken into a few metres of it
        let whole = fract(h1 * 7.13) < 0.55;
        let run = select(smoothstep(0.38, 0.48, st_noise(vec2<f32>(c / 3.4, k * 2.9 + 1.3))), 1.0, whole);
        let l = SwLine(a - x, t, fract(h * 13.71 + h1), run);
        o = sw_nearer(o, l);
    }
    return o;
}

// Longitudinal cracks along the paving lanes' joints (on the lane lines from
// the parking lane's edge) and in the outer wheel path, in runs along the road.
fn sw_longitudinal(a: f32, kd: f32, n: vec2<f32>) -> SwLine {
    var o = SwLine(1e9, n, 0.0, 0.0);
    if (SP_LANE_M <= 0.0) {
        return o;
    }
    let lane = SP_LANE_M;
    let j = max(round((kd - SP_PARKING_M) / lane), 0.0);
    for (var w = 0; w < 2; w = w + 1) {
        // the joint, then the lane's outer wheel path
        var y = SP_PARKING_M + j * lane;
        if (w == 1) {
            let jj = floor(max(kd - SP_PARKING_M, 0.0) / lane);
            y = SP_PARKING_M + jj * lane + 0.5 * lane - 0.5 * SP_TRACK_M;
        }
        let salt = j * 3.3 + f32(w) * 11.0;
        y = y + (st_noise(vec2<f32>(a / 4.3, salt + 5.1)) - 0.5) * 0.18 + (st_noise(vec2<f32>(a / 0.9, salt)) - 0.5) * 0.05 + (st_noise(vec2<f32>(a / 0.19, salt + 2.0)) - 0.5) * 0.012;
        let seg = floor(a / 13.0);
        let h = st_hash(vec2<f32>(seg, salt + 0.7));
        let share = select(SW_LONGITUDINAL_SHARE, SW_LONGITUDINAL_SHARE * 0.6, w == 1);
        let run = smoothstep(1.0 - share, 1.0 - share + 0.08, st_noise(vec2<f32>(a / 9.0, salt + 0.3)));
        o = sw_nearer(o, SwLine(kd - y, n, h, run));
    }
    return o;
}

// Fatigue cracking in the wheel paths: small sharp-angled pieces (the cells of
// a stretched Voronoi field in the road's frame), open hairlines, in the worst
// stretches of a path only. Returns the hairline's cover.
fn sw_fatigue(a: f32, kd: f32, fw: f32) -> f32 {
    if (SP_LANE_M <= 0.0 || SP_TRACK_M <= 0.0 || kd < 0.0) {
        return 0.0;
    }
    let lane = SP_LANE_M;
    let x = kd - SP_PARKING_M + (st_noise(vec2<f32>(a / 23.0, 3.1)) - 0.5) * 0.5;
    let li = floor(x / lane);
    let lx = x - lane * li - 0.5 * lane;
    let dt = abs(abs(lx) - 0.5 * SP_TRACK_M);
    let path = (1.0 - smoothstep(0.18, 0.36, dt)) * smoothstep(-0.4, 0.3, x);
    let stretch = smoothstep(1.0 - SW_FATIGUE_SHARE, 1.0 - SW_FATIGUE_SHARE + 0.06, st_noise(vec2<f32>(a / 7.0, li * 2.3 + sign(lx) * 0.9 + 1.1)));
    let k = path * stretch;
    let keep = wx_keep(SW_FATIGUE_CELL_M * 0.5, fw);
    if (k <= 0.0) {
        return 0.0;
    }
    if (keep <= 0.0) {
        return k * 0.12; // the hairlines' mean cover over a piece
    }
    let cell = vec2<f32>(SW_FATIGUE_CELL_M * 1.3, SW_FATIGUE_CELL_M);
    let p = vec2<f32>(a, kd) / cell;
    let base = floor(p);
    var f1 = 1e9;
    var f2 = 1e9;
    var c1 = vec2<f32>(0.0);
    var c2 = vec2<f32>(0.0);
    for (var j = -1; j <= 1; j = j + 1) {
        for (var i = -1; i <= 1; i = i + 1) {
            let c = base + vec2<f32>(f32(i), f32(j));
            let pt = c + 0.15 + 0.7 * vec2<f32>(st_hash(c + vec2<f32>(5.1, 2.9)), st_hash(c + vec2<f32>(1.7, 8.3)));
            let dm = (p - pt) * cell;
            let dd = dot(dm, dm);
            if (dd < f1) {
                f2 = f1;
                c2 = c1;
                f1 = dd;
                c1 = pt;
            } else if (dd < f2) {
                f2 = dd;
                c2 = pt;
            }
        }
    }
    let e = normalize((c2 - c1) * cell + vec2<f32>(1e-6, 0.0));
    let d = abs(dot(p * cell - 0.5 * (c1 + c2) * cell, e));
    let hw = WX_CRACK_HAIR_M * (0.4 + 0.7 * st_noise(vec2<f32>(a, kd) / 0.13));
    return mix(k * 0.12, k * wx_band(d, hw, fw), keep);
}

// The cracks (weathering.wgsl `wx_road` calls this in place of `wx_cracks`):
// transverse and longitudinal lines in the road's frame (at a junction pad,
// whose frame is not defined, two families on the world's axes, sparser),
// each sealed under a meandering overband or left open; fatigue in the wheel
// paths. The sealant and the open cracks are noted for `sp_crack_materials`.
fn sw_cracks(s: ptr<function, Surface>, world: vec3<f32>, g: vec2<f32>, kd: f32, fw: f32, dist: f32) {
    let far = 1.0 - smoothstep(WX_SNAKE_FAR * 0.6, WX_SNAKE_FAR, dist);
    // cracked stretches of pavement and sound ones (its age, its base)
    let present = smoothstep(0.1, 0.3, st_noise(world.xz / 47.0 + 17.0));
    if (far * present <= 0.0) {
        return;
    }
    // the road's frame (a marking passes its own across direction and no kerb distance: transverse only)
    let gl = length(g);
    let framed = gl > 0.3;
    var l: SwLine;
    var a = world.x;
    if (framed) {
        var n = g / gl;
        if (n.y < 0.0 || (n.y == 0.0 && n.x < 0.0)) {
            n = -n;
        }
        let t = vec2<f32>(n.y, -n.x);
        a = dot(world.xz, t);
        let c = dot(world.xz, n);
        l = sw_transverse(a, c, t, 0.0, SW_TRANSVERSE_SHARE);
        if (kd >= 0.0) {
            var lg = sw_longitudinal(a, kd, n);
            lg.dir = g / gl;
            l = sw_nearer(l, lg);
        }
    } else {
        // a junction pad: two families on the world's axes (a pad's cracks run on from every approach)
        l = sw_transverse(world.x, world.z, vec2<f32>(1.0, 0.0), 0.37, SW_TRANSVERSE_SHARE);
        l = sw_nearer(l, sw_transverse(world.z, world.x, vec2<f32>(0.0, 1.0), 0.71, SW_TRANSVERSE_SHARE));
    }
    let on = l.on * far * present;
    if (on > 0.0 && abs(l.d) < 0.2) {
        if (l.h < SW_SEALED_SHARE) {
            // the overband: wider and narrower along the crack (the squeegee's
            // passes), its edges ragged, a thin feathered film beyond them
            let q = world.xz;
            let hw = SW_SEAL_HALF_M * (0.7 + 0.6 * st_noise(q / 0.9 + l.h * 9.0)) + (st_noise(q / 0.05) - 0.5) * 0.008 * wx_keep(0.05, fw);
            let bead = wx_band(l.d, hw, fw);
            let film = wx_band(l.d, hw * 1.7, fw) * 0.3 * (0.5 + st_noise(q / 0.31 + 2.0));
            let k = clamp(max(bead, film), 0.0, 1.0) * on;
            let age = step(1.0 - WX_CRACK_AGED_SHARE, fract(l.h * 7.31)) * (0.6 + 0.4 * st_noise(q / 3.0 + 5.7));
            let tone = mix(WX_CRACK_ALBEDO, WX_CRACK_ALBEDO_AGED, age);
            (*s).albedo = mix((*s).albedo, min((*s).albedo, vec3<f32>(tone)), k);
            (*s).rough = mix((*s).rough, mix(WX_SNAKE_ROUGH, WX_SNAKE_ROUGH_AGED, age), k);
            sp_note_seal(k, bead * on, age, l.d / max(hw, 1e-4), hw, l.dir);
        } else {
            // an open crack: a hairline whose width wanders, ravelled at its lips
            let hw = WX_CRACK_HAIR_M * (0.5 + 1.0 * st_noise(world.xz / 0.4 + 3.3));
            let k = wx_band(l.d, hw, fw) * on;
            let ravel = wx_band(l.d, hw * WX_CRACK_RAVEL, fw) * on * (0.5 + st_noise(world.xz / 0.25 + 6.6));
            (*s).albedo = (*s).albedo * (1.0 - WX_CRACK_HAIR_DARK * k) * (1.0 - WX_CRACK_RAVEL_DARK * clamp(ravel, 0.0, 1.0));
            (*s).rough = min(1.0, (*s).rough + 0.1 * k);
            sp_note_crack(k + 0.4 * ravel);
        }
    }
    if (framed && kd >= 0.0 && dist < 60.0) {
        let fk = sw_fatigue(a, kd, fw) * present * (1.0 - smoothstep(40.0, 60.0, dist));
        if (fk > 0.0) {
            (*s).albedo = (*s).albedo * (1.0 - WX_CRACK_HAIR_DARK * fk);
            sp_note_crack(fk);
        }
    }
}

// Oil drips down a lane's middle (the cc0 decals' drip line, `across` from its
// centre, `hw` its half-width): drips' pools 3-9 cm across, a little drawn out
// along the lane, fresh ones black and older ones spread and paler, densest at
// the middle of the vehicles' track and in stretches where they stand (stops,
// queues). Past a few pixels a pool is its share of cover: the band reads as
// a soft darkening, never as a line. Returns the darkening's cover (0..1).
fn sw_drips(a: f32, across: f32, hw: f32, seed: f32, fw: f32) -> f32 {
    let rho = (1.0 - smoothstep(0.2, 1.0, abs(across) / max(hw, 1e-3))) * (0.35 + 0.65 * smoothstep(0.3, 0.75, st_noise(vec2<f32>(a / 11.0 + seed * 7.0, 0.3))));
    // the old drips merged into the binder, and the pools' expected cover
    let haze = rho * 0.1;
    let mean = haze + rho * 0.07;
    let cs = SW_DRIP_CELL_M;
    let keep = wx_keep(cs * 0.6, fw);
    if (keep <= 0.0 || rho <= 0.0) {
        return mean;
    }
    let cell = vec2<f32>(cs * 1.6, cs);
    let p = vec2<f32>(a, across) / cell;
    let f = floor(p);
    let off = select(vec2<f32>(-1.0), vec2<f32>(0.0), fract(p) > vec2<f32>(0.5));
    var cover = 0.0;
    for (var j = 0; j < 2; j = j + 1) {
        for (var i = 0; i < 2; i = i + 1) {
            let c = f + off + vec2<f32>(f32(i), f32(j));
            let h = st_hash(c + vec2<f32>(seed * 13.0, 4.4));
            if (h > rho * 0.55) {
                continue;
            }
            let h2 = st_hash(c + vec2<f32>(7.7, seed * 5.0));
            let h3 = st_hash(c + vec2<f32>(2.2, 9.9));
            let centre = c + 0.2 + 0.6 * vec2<f32>(h2, h3);
            let dm = (p - centre) * cell;
            let r = 0.015 + 0.03 * fract(h * 17.3 + h2);
            // older pools spread wider and paler; the rim ragged
            let old = fract(h3 * 5.9);
            let rr = r * (1.0 + 0.8 * old);
            let dd = length(dm / vec2<f32>(1.4, 1.0)) + (st_noise(dm / 0.012 + h * 31.0) - 0.5) * 0.25 * rr;
            let spot = 1.0 - smoothstep(rr * 0.55, rr, dd);
            cover = max(cover, spot * mix(1.0, 0.45, old));
        }
    }
    return mix(mean, haze + (1.0 - haze) * cover, keep);
}

// The painted lanes' wheel paths (cc0.wgsl's DK_WHEEL decals, which the
// decal placement lays from the run's own lane paint): their polish share,
// the rut's depth there (m) and the lean of its sides, for `sp_asphalt` in
// place of its kerb-distance lane model (which on a lane-less street puts a
// wheel path at the crown, whose kerb-distance gradient is not defined: a
// dark line down the middle of the alley between two polished bands).
var<private> sw_wheel: f32 = 0.0;
var<private> sw_wheel_dip: f32 = 0.0;
var<private> sw_wheel_lean: vec2<f32> = vec2<f32>(0.0);

fn sw_note_wheel(w: f32, along: f32, across: f32, hw: f32, seed: f32, px: vec2<f32>) {
    sw_wheel = max(sw_wheel, w);
    // the floor a few millimetres down where the base gave way, in reaches of a few metres
    // with sound road between; its sides lean in
    let u = clamp(across / max(hw, 1e-3), -1.0, 1.0);
    let depth = SP_RUT_M * (0.2 + 1.5 * smoothstep(0.3, 0.75, st_noise(vec2<f32>(along / 5.5, seed * 5.0 + 2.3))));
    // the water it holds: the deepest hollows of the rut's floor only (birdbaths a metre or
    // two long), so a wet path holds pools along it, not one dark strip of mirror
    let hollow = smoothstep(0.5, 0.8, st_noise(vec2<f32>(along / 1.9, seed * 3.0 + 7.7)));
    sw_wheel_dip = max(sw_wheel_dip, depth * (1.0 - u * u) * w * hollow);
    // h = -depth (1 - u^2): dh/dacross = 2 depth u / hw, the normal leans against it
    sw_wheel_lean = sw_wheel_lean - px * (2.0 * depth * u / max(hw, 1e-3) * w);
}

// Utility patches of one pour (cc0.wgsl's DK_PATCH decals): the cut's fill a
// tone of its own keyed on the world (so the pieces of one repair, decals
// side by side, read as one pour: no panels), its seam darkening the cut.
var<private> sw_patch: f32 = 0.0;
var<private> sw_patch_seam: f32 = 0.0;

fn sw_patch_tone(world: vec3<f32>) -> f32 {
    // newer (darker, x0.74 as the earlier composition) or older and oxidised (near the road's own tone)
    let age = st_noise(world.xz / 9.0 + 41.0);
    return mix(0.74, 0.95, smoothstep(0.35, 0.65, age)) * (0.96 + 0.08 * st_noise(world.xz / 1.3 + 2.0));
}

// ---- `--street-glare`: the polished tops over the rough road (SF_STREET_GLARE) ----------

// The share of what the eye sees that is the macrotexture's tops: `tops` of
// the plan, while the valleys are masked toward grazing by Smith's G1 (GGX) at
// the relief's slope spread `slope`.
fn sg_top_share(n_geom: vec3<f32>, v: vec3<f32>, slope: f32, tops: f32) -> f32 {
    let mu = clamp(dot(n_geom, v), 0.02, 1.0);
    let t2 = (1.0 - mu * mu) / (mu * mu);
    let g1 = 2.0 / (1.0 + sqrt(1.0 + slope * slope * t2));
    return tops / (tops + (1.0 - tops) * g1);
}

// The layer look_light.wgsl draws over the surface (its coat: F0 0.04 on the
// plane, its own roughness, the base under it by 1 - k F). Dry only: the wet
// layer brings its own film.
fn sg_coat(k: f32, rough: f32) {
    var w = 0.0;
    if (sky_on(skyu.flags.x, SKY_WET)) {
        w = skyu.wet.x;
    }
    let kk = k * (1.0 - smoothstep(0.02, 0.3, w));
    if (kk > sky_coat) {
        sky_coat = kk;
        sky_coat_rough = rough;
    }
}
